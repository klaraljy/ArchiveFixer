<Window x:Class="ArchiveFixer.Views.PasswordListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码列表管理"
        Width="760"
        Height="560"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

	<DockPanel Margin="10">

		<!-- 顶部区域 -->
		<Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,8">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Row="0"
                            Grid.Column="0"
                            Orientation="Vertical">
					<TextBlock Text="密码列表管理"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#333333" />

					<TextBlock Text="密码默认隐藏。日志不会记录明文密码。导入时默认保留密码中的空格。"
                               Margin="0,4,0,0"
                               Foreground="#666666" />
				</StackPanel>

				<StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
					<TextBlock Text="总数："
                               Foreground="#666666" />
					<TextBlock Text="{Binding TotalCount}"
                               FontWeight="Bold"
                               Margin="0,0,12,0" />

					<TextBlock Text="启用："
                               Foreground="#666666" />
					<TextBlock Text="{Binding EnabledCount}"
                               FontWeight="Bold" />
				</StackPanel>

				<Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,12,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<TextBox Grid.Column="0"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入新密码。允许空格，不会自动 Trim。" />

					<StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="8,0,0,0">
						<Button Content="添加"
                                Width="80"
                                Height="30"
                                Margin="0,0,6,0"
                                Command="{Binding AddPasswordCommand}" />

						<Button Content="导入 txt"
                                Width="90"
                                Height="30"
                                Command="{Binding ImportPasswordsCommand}" />
					</StackPanel>
				</Grid>
			</Grid>
		</Border>

		<!-- 底部按钮 -->
		<Border DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,8,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock Text="{Binding Message}"
                           VerticalAlignment="Center"
                           Foreground="#555555"
                           TextTrimming="CharacterEllipsis" />

				<StackPanel Grid.Column="1"
                            Orientation="Horizontal">
					<Button Content="显示/隐藏密码"
                            Width="120"
                            Height="30"
                            Margin="0,0,6,0"
                            Command="{Binding ToggleShowPasswordsCommand}" />

					<Button Content="启用全部"
                            Width="80"
                            Height="30"
                            Margin="0,0,6,0"
                            Command="{Binding EnableAllCommand}" />

					<Button Content="禁用全部"
                            Width="80"
                            Height="30"
                            Margin="0,0,6,0"
                            Command="{Binding DisableAllCommand}" />

					<Button Content="上移"
                            Width="70"
                            Height="30"
                            Margin="0,0,6,0"
                            Command="{Binding MoveUpCommand}" />

					<Button Content="下移"
                            Width="70"
                            Height="30"
                            Margin="0,0,6,0"
                            Command="{Binding MoveDownCommand}" />

					<Button Content="删除"
                            Width="70"
                            Height="30"
                            Margin="0,0,6,0"
                            Command="{Binding RemovePasswordCommand}" />

					<Button Content="清空"
                            Width="70"
                            Height="30"
                            Margin="0,0,12,0"
                            Command="{Binding ClearPasswordsCommand}" />

					<Button Content="关闭"
                            Width="80"
                            Height="30"
                            IsCancel="True"
                            Click="CloseButton_Click" />
				</StackPanel>
			</Grid>
		</Border>

		<!-- 密码列表 -->
		<Border Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4">
			<DataGrid ItemsSource="{Binding Passwords}"
                      SelectedItem="{Binding SelectedPassword, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      AlternatingRowBackground="#FAFAFA"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

				<DataGrid.Columns>
					<DataGridCheckBoxColumn Header="启用"
                                            Binding="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="70" />

					<DataGridTemplateColumn Header="密码"
                                            Width="240">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Grid>
									<!-- 隐藏密码时显示脱敏值 -->
									<TextBlock Text="{Binding MaskedValue}"
                                               VerticalAlignment="Center"
                                               Padding="4,0,4,0">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Visible" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding DataContext.ShowPasswords, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                 Value="True">
														<Setter Property="Visibility" Value="Collapsed" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>

									<!-- 用户主动显示密码时才显示明文 -->
									<TextBlock Text="{Binding Value}"
                                               VerticalAlignment="Center"
                                               Padding="4,0,4,0">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Collapsed" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding DataContext.ShowPasswords, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                 Value="True">
														<Setter Property="Visibility" Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</Grid>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTextColumn Header="来源"
                                        Binding="{Binding Source}"
                                        Width="130"
                                        IsReadOnly="True" />

					<DataGridTextColumn Header="备注"
                                        Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*" />
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</DockPanel>
</Window>
