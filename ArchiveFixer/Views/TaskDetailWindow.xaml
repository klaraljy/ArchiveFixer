<Window x:Class="ArchiveFixer.Views.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="任务详情"
        Width="820"
        Height="660"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <!--
        任务详情（UI v2）。
        改之前：标签与值没有统一间距、分组标题和正文同一档字号、底部两个等宽按钮。
        现在：统一走 App.xaml 的 Label/Value 样式、分组标题独立成行、按钮分主次。
    -->

    <Window.Resources>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="DetailPathTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SelectableBodyTextBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- ============ 标题区 ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="任务详情" Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"
                           Text="单个任务的完整信息。此窗口不会显示明文密码；路径与错误信息可以直接选中复制。" />
            </StackPanel>
        </Border>

        <!-- ============ 底部按钮区 ============ -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock Text="{Binding FileName}"
                           Style="{StaticResource HintTextStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FileName}" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="复制全部信息"
                            MinWidth="112"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="把下面全部信息复制到剪贴板（不含明文密码）"
                            Click="CopyAllButton_Click" />

                    <Button Content="关闭"
                            MinWidth="88"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsCancel="True"
                            IsDefault="True"
                            Click="CloseButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>

                <!-- 基本信息 -->
                <GroupBox Header="基本信息">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="序号：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Index}" Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="文件名：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FileName}" Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="原始路径：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OriginalPath}" Style="{StaticResource DetailPathTextBoxStyle}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="当前路径：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentPath}" Style="{StaticResource DetailPathTextBoxStyle}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="所在目录：" Style="{StaticResource DetailLabelStyle}" Margin="0,0,10,0" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DirectoryPath}" Style="{StaticResource DetailPathTextBoxStyle}" Margin="0" />
                    </Grid>
                </GroupBox>

                <!-- 识别与后缀 -->
                <GroupBox Header="识别与后缀">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="当前后缀：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentExtension}" Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="检测格式：" Style="{StaticResource DetailLabelStyle}" Margin="16,0,10,10" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DetectedFormat}" Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="建议后缀：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SuggestedExtension}" Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="后缀状态：" Style="{StaticResource DetailLabelStyle}" Margin="16,0,10,10" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ExtensionStatus}" Style="{StaticResource DetailValueStyle}" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="是否压缩包：" Style="{StaticResource DetailLabelStyle}" Margin="0,0,10,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IsArchive}" Style="{StaticResource DetailValueStyle}" Margin="0" />

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="是否加密：" Style="{StaticResource DetailLabelStyle}" Margin="16,0,10,0" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding IsEncrypted}" Style="{StaticResource DetailValueStyle}" Margin="0" />
                    </Grid>
                </GroupBox>

                <!-- 解压与状态 -->
                <GroupBox Header="解压与状态">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="输出目录：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OutputPath}" Style="{StaticResource DetailPathTextBoxStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="密码状态：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PasswordStatus}" Style="{StaticResource DetailValueStyle}" />

                        <!--
                            分卷情况。主界面 DataGrid 的「分卷」列默认隐藏（只有分卷组那一行有内容），
                            所以这里必须常驻显示，否则"缺哪几卷"就没地方看了（AGENTS.md §9.3）。
                        -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="分卷：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VolumeInfoText}" Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="当前操作：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Operation}" Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="状态：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding Status}"
                                   Style="{StaticResource DetailValueStyle}"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="进度：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="错误信息：" Style="{StaticResource DetailLabelStyle}" Margin="0,0,10,0" />
                        <TextBox Grid.Row="6" Grid.Column="1"
                                 Text="{Binding ErrorMessage}"
                                 Style="{StaticResource DetailPathTextBoxStyle}"
                                 Foreground="{StaticResource DangerTextBrush}"
                                 Margin="0" />
                    </Grid>
                </GroupBox>

                <!-- 时间信息 -->
                <GroupBox Header="时间信息">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="开始时间：" Style="{StaticResource DetailLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="结束时间：" Style="{StaticResource DetailLabelStyle}" Margin="16,0,10,10" />
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="{Binding EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   Style="{StaticResource DetailValueStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="耗时：" Style="{StaticResource DetailLabelStyle}" Margin="0,0,10,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ElapsedText}" Style="{StaticResource DetailValueStyle}" Margin="0" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="最后更新：" Style="{StaticResource DetailLabelStyle}" Margin="16,0,10,0" />
                        <TextBlock Grid.Row="1" Grid.Column="3"
                                   Text="{Binding LastUpdatedTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                   Style="{StaticResource DetailValueStyle}" Margin="0" />
                    </Grid>
                </GroupBox>

                <!-- 任务日志摘要 -->
                <GroupBox Header="任务日志摘要" Margin="0">
                    <StackPanel>
                        <TextBox x:Name="TaskLogTextBox"
                                 Style="{StaticResource CodeTextBoxStyle}"
                                 MinHeight="140"
                                 TextWrapping="NoWrap" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0"
                                   Text="完整日志在主界面底部日志区，以及 data\logs 目录下的日志文件里；这里是这个任务的摘要，可直接 Ctrl+A / Ctrl+C。" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
