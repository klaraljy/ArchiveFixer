<Window x:Class="ArchiveFixer.Views.PasswordPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        Height="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock x:Name="HintText"
                   DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Foreground="Gray"
                   Margin="0,0,0,8"
                   Text="从密码列表里挑一条（只在内存里用到，不写进日志、不落盘）。" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="用这一条"
                    Padding="16,4"
                    IsDefault="True"
                    Click="OnPick" />
            <Button Content="取消"
                    Padding="16,4"
                    Margin="10,0,0,0"
                    IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>

        <ListBox x:Name="PasswordList" MouseDoubleClick="OnDoubleClick" />
    </DockPanel>
</Window>
