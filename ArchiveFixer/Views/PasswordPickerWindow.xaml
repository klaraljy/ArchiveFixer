<Window x:Class="ArchiveFixer.Views.PasswordPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从密码列表里选一条"
        Width="460"
        Height="460"
        MinWidth="380"
        MinHeight="320"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <!--
        用户 2026-09-26："选择密码的时候就非常的丑陋，最少每个密码框起来一下，全是文字根本就不好看"。
        改法：一条密码 = 一个带边框的小卡片（等宽、等间距、左对齐），底下是提示与按钮 —— 排版统一。
    -->
    <DockPanel Margin="16">

        <TextBlock x:Name="HintTextBlock"
                   DockPanel.Dock="Top"
                   Text="从密码列表里挑一条（只在内存里用到，不写进日志、不落盘）。"
                   Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="用这一条"
                    MinWidth="96"
                    Padding="14,5"
                    IsDefault="True"
                    Click="OnPick" />
            <Button Content="取消"
                    MinWidth="80"
                    Padding="14,5"
                    Margin="10,0,0,0"
                    IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>

        <Border Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="2">
            <ListBox x:Name="PasswordList"
                     MouseDoubleClick="OnDoubleClick"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Padding="6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#D8D8D8"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,7">
                            <TextBlock Text="{Binding}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
