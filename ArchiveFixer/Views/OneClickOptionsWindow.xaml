<Window x:Class="ArchiveFixer.Views.OneClickOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="一键处理 · 确认"
        Width="620"
        MaxHeight="780"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
        一键处理的**那一个**确认框（用户 2026-09-24 第 17 条）。

        用户原话："现在规定点击完一键处理，就只能有一个弹窗提醒，而且这个可以选中以后不弹出……
        弹窗里面的东西改为『内容物会生成在什么地方，而且其余物是否自动删除』……
        为什么我一键处理还没有开始确认，你的进度条就开始动了"

        所以这个窗口只有三段东西：
        ① 正文两行（+ 需要时再加两行提示）：内容物落点 + 其余物是否自动删除（用户点名要的那两件事）；
        ② 一个**默认收起**的折叠区：真要临时改落点 / 终端落法 / 源包处理时才展开 ——
           旧版把这一整套摊在正文里，正是他嫌"这么的啰嗦"的那部分；
        ③ 「以后不再询问」+ 开始 / 取消。

        ⚠ 三条不许回退的纪律：
        · 正文措辞全部来自 StatusText（§7：界面文案的唯一来源），本文件里不写死文案常量；
        · 勾「以后不再询问」写的是**设置**（AppSettings.SkipOneClickConfirm），界面上有开关能再打开；
        · 这个窗口**不写任何设置**：只有用户勾了「把本次选择存为默认」，才由调用方写一次
          （§9.2 硬要求②：不勾就一个字节都不改）。
    -->

    <DockPanel Margin="12">

        <!-- ============ 正文：他点名的那两件事 ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="一键处理 · 确认" Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock Text="内容物会生成在："
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,8,0,0" />

                <TextBlock x:Name="DestinationText"
                           x:FieldModifier="public"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding DestinationEcho}" />

                <TextBlock Text="其余物："
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,8,0,0" />

                <TextBlock x:Name="RestText"
                           x:FieldModifier="public"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding RestEcho}" />

                <TextBlock x:Name="SourceText"
                           x:FieldModifier="public"
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding SourceEcho}" />

                <!-- 无用物 / 没有可用密码两段（有才出现；两段都空时整块收起） -->
                <TextBlock x:Name="NoticeText"
                           x:FieldModifier="public"
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Text="{Binding NoticeEcho}" />
            </StackPanel>
        </Border>

        <!-- ============ 底部按钮区 ============ -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
            <StackPanel>
                <CheckBox x:Name="SuppressPanelBox"
                          x:FieldModifier="public"
                          Content="以后不再询问，按当前设置直接开始（可在「解压方式」页再打开）"
                          Checked="Option_Changed"
                          Unchecked="Option_Changed" />

                <DockPanel Margin="0,8,0,0">
                    <TextBlock x:Name="ValidationText"
                               x:FieldModifier="public"
                               Style="{StaticResource HintTextStyle}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton"
                                x:FieldModifier="public"
                                Content="取消"
                                MinWidth="88"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelButton_Click"
                                IsCancel="True" />

                        <Button x:Name="StartButton"
                                x:FieldModifier="public"
                                Content="开始处理"
                                MinWidth="112"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True"
                                Click="StartButton_Click" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ============ 要改才展开（默认收起） ============ -->
        <Expander Header="本次改一下（落点 / 终端落法 / 源包处理）"
                  x:Name="TweakExpander"
                  x:FieldModifier="public"
                  IsExpanded="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="420"
                          Padding="0,0,6,0">
                <StackPanel>

                    <!-- ==================== 本次落点（二选一） ==================== -->
                    <GroupBox Header="本次落点">
                        <StackPanel>
                            <RadioButton x:Name="PlacementPerArchiveOption"
                                         x:FieldModifier="public"
                                         GroupName="Placement"
                                         Checked="Placement_Checked">
                                <TextBlock Text="以包名命名的子文件夹（默认）" Style="{StaticResource BodyTextStyle}" />
                            </RadioButton>

                            <RadioButton x:Name="PlacementCustomPerArchiveOption"
                                         x:FieldModifier="public"
                                         GroupName="Placement"
                                         Margin="0,4,0,0"
                                         Checked="Placement_Checked">
                                <TextBlock Text="解压到指定位置，并建立同名子文件夹" Style="{StaticResource BodyTextStyle}" />
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>

                    <!-- ==================== 指定位置 ==================== -->
                    <GroupBox Header="指定位置">
                        <DockPanel>
                            <Button x:Name="BrowseButton"
                                    x:FieldModifier="public"
                                    DockPanel.Dock="Right"
                                    Content="浏览…"
                                    MinWidth="78"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseButton_Click" />

                            <TextBox x:Name="CustomRootBox"
                                     x:FieldModifier="public"
                                     TextChanged="CustomRootBox_TextChanged"
                                     ToolTip="只对上面「解压到指定位置」那一档生效" />
                        </DockPanel>
                    </GroupBox>

                    <!-- ==================== 终端落法 ==================== -->
                    <GroupBox Header="终端落法（内容物最后那一层）">
                        <StackPanel>
                            <RadioButton x:Name="TerminalKeepLastFolderOption"
                                         x:FieldModifier="public"
                                         GroupName="TerminalLayout"
                                         Checked="TerminalLayout_Checked">
                                <TextBlock Text="多文件时保留最后一层文件夹名（默认）" Style="{StaticResource BodyTextStyle}" />
                            </RadioButton>

                            <RadioButton x:Name="TerminalUseArchiveNameOption"
                                         x:FieldModifier="public"
                                         GroupName="TerminalLayout"
                                         Margin="0,4,0,0"
                                         Checked="TerminalLayout_Checked">
                                <TextBlock Text="多文件时用压缩包名当最后一层" Style="{StaticResource BodyTextStyle}" />
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>

                    <!-- ==================== 源包处理 ==================== -->
                    <GroupBox Header="源包处理">
                        <StackPanel>
                            <RadioButton x:Name="SourceMoveToRestOption"
                                         x:FieldModifier="public"
                                         GroupName="SourceHandling"
                                         Checked="SourceHandling_Checked">
                                <StackPanel>
                                    <TextBlock Text="移入「其余物」（默认，推荐）" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Text="成功 + 校验通过之后才搬；失败 / 取消一律原地不动" Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="SourceKeepInPlaceOption"
                                         x:FieldModifier="public"
                                         GroupName="SourceHandling"
                                         Margin="0,4,0,0"
                                         Checked="SourceHandling_Checked">
                                <StackPanel>
                                    <TextBlock Text="留在原地（不动源包）" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Text="传统解压器语义：源包一个字节都不搬" Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="SourceDeleteAfterVerifyOption"
                                         x:FieldModifier="public"
                                         GroupName="SourceHandling"
                                         Margin="0,4,0,0"
                                         Checked="SourceHandling_Checked">
                                <StackPanel>
                                    <TextBlock Text="校验通过后删除" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Text="沿用清理源包的规则；失败一律不删" Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="SaveAsDefaultBox"
                              x:FieldModifier="public"
                              Margin="0,4,0,0"
                              Content="把本次选择存为默认（写入设置文件，下次启动仍是它）"
                              Checked="Option_Changed"
                              Unchecked="Option_Changed" />
                </StackPanel>
            </ScrollViewer>
        </Expander>
    </DockPanel>
</Window>
