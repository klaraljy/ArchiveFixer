<Window x:Class="ArchiveFixer.Views.OneClickOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="一键处理 · 本次选项"
        Width="640"
        MaxHeight="760"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
        一键处理的「本次选项」面板（规格 docs/输出与整理模型.md §9）。

        为什么要有它：WinRAR 把"解压到"做成每次操作可临时选的运行期选项，而我们四种落点
        只能进设置里改 —— 逼用户"进设置 → 改 → 回来"是最典型的冗余操作，而落点恰恰是最常
        需要临时改的一项。

        三条界面纪律：
        ① 只影响**这一次**：面板自己不写设置；勾了「把本次选择存为默认」才由主窗口写 appsettings.json；
        ② 落点仍然只有一处实现（OutputPlacement）：这里只选"哪一档 + 哪个目录"，
           路径怎么拼一个字都不在这里决定（见 Models/ExtractOptions.cs 的 OneClickRunOptions.ApplyTo）；
        ③ 全部视觉资源来自 App.xaml（§UI v2 的唯一色板），本窗口不自带色板。
    -->

    <DockPanel Margin="12">

        <!-- ============ 标题区 ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="一键处理 · 本次选项" Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"
                           Text="这些选择只对这一次生效。不勾「把本次选择存为默认」时，设置文件一个字节都不会改；整个过程只问你这一次（不会每个包问一遍）。" />

                <!-- 实时摘要：选什么就写清"会落到哪"（数据来源是 OneClickRunOptions.Describe） -->
                <TextBlock x:Name="SummaryText"
                                     x:FieldModifier="public"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,7,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding Summary}" />
            </StackPanel>
        </Border>

        <!-- ============ 底部按钮区 ============ -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock x:Name="ValidationText"
                                     x:FieldModifier="public"
                           Style="{StaticResource HintTextStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                                     x:FieldModifier="public"
                            Content="取消"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CancelButton_Click"
                            IsCancel="True" />

                    <Button x:Name="StartButton"
                                     x:FieldModifier="public"
                            Content="开始处理"
                            MinWidth="112"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Click="StartButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>

                <!-- ==================== 本次落点（四选一） ==================== -->
                <GroupBox Header="本次落点">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"
                                   Text="四选一，互斥。默认取设置里的当前值；改这里不会写回设置。" />

                        <RadioButton x:Name="PlacementPerArchiveOption"
                                     x:FieldModifier="public"
                                     GroupName="Placement"
                                     Checked="Placement_Checked">
                            <StackPanel>
                                <TextBlock Text="以包名命名的子文件夹（默认）" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 111\222\内容物" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="PlacementSourceDirectoryOption"
                                     x:FieldModifier="public"
                                     GroupName="Placement"
                                     Checked="Placement_Checked">
                            <StackPanel>
                                <TextBlock Text="解压到压缩包所在目录" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 111\内容物（产物直接落在包旁边）" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="PlacementCustomPerArchiveOption"
                                     x:FieldModifier="public"
                                     GroupName="Placement"
                                     Checked="Placement_Checked">
                            <StackPanel>
                                <TextBlock Text="解压到指定位置，并建立同名子文件夹" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 333\222\内容物（每个包各占一个文件夹）" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="PlacementCustomFlatOption"
                                     x:FieldModifier="public"
                                     GroupName="Placement"
                                     Checked="Placement_Checked">
                            <StackPanel>
                                <TextBlock Text="解压到指定位置，直接放在该目录下" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 333\内容物（所有包的内容物摊在同一个目录里）" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 指定位置 ==================== -->
                <GroupBox Header="指定位置">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="BrowseButton"
                                     x:FieldModifier="public"
                                    DockPanel.Dock="Right"
                                    Content="浏览…"
                                    MinWidth="78"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseButton_Click" />

                            <TextBox x:Name="CustomRootBox"
                                     x:FieldModifier="public"
                                     TextChanged="CustomRootBox_TextChanged"
                                     ToolTip="只对上面两种「指定位置」模式生效" />
                        </DockPanel>

                        <TextBlock x:Name="CustomRootHint"
                                     x:FieldModifier="public"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   Text="只对上面两种「指定位置」模式生效；选另外两种模式时这里留着不影响结果。" />
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 终端落法 ==================== -->
                <GroupBox Header="终端落法（内容物最后那一层）">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"
                                   Text="只影响「多文件 / 自带一层文件夹」时套出来的那一层叫什么；终端只有一个文件时两种取值结果相同。" />

                        <RadioButton x:Name="TerminalKeepLastFolderOption"
                                     x:FieldModifier="public"
                                     GroupName="TerminalLayout"
                                     Checked="TerminalLayout_Checked">
                            <StackPanel>
                                <TextBlock Text="多文件时保留最后一层文件夹名（默认）" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 111\222\666\内容物（保留包内那一层名字）" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TerminalUseArchiveNameOption"
                                     x:FieldModifier="public"
                                     GroupName="TerminalLayout"
                                     Margin="0,6,0,0"
                                     Checked="TerminalLayout_Checked">
                            <StackPanel>
                                <TextBlock Text="多文件时用压缩包名当最后一层" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 111\222\内容物（少一层点击，丢掉包内那层名字）" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 源包处理 ==================== -->
                <GroupBox Header="源包处理">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"
                                   Text="只有「内容物已定稿 + 输出校验通过 + 未取消 + 属于本任务分卷组」四条同时成立才会动源包；失败 / 取消时一律原地不动。" />

                        <RadioButton x:Name="SourceMoveToRestOption"
                                     x:FieldModifier="public"
                                     GroupName="SourceHandling"
                                     Checked="SourceHandling_Checked">
                            <StackPanel>
                                <TextBlock Text="移入「其余物」（默认，推荐）" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="整理完删一个「其余物」目录就干净了（源包 + 过程物都在里面）" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="SourceKeepInPlaceOption"
                                     x:FieldModifier="public"
                                     GroupName="SourceHandling"
                                     Margin="0,6,0,0"
                                     Checked="SourceHandling_Checked">
                            <StackPanel>
                                <TextBlock Text="留在原地（不动源包）" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="传统解压器语义：源包一个字节都不搬" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="SourceDeleteAfterVerifyOption"
                                     x:FieldModifier="public"
                                     GroupName="SourceHandling"
                                     Margin="0,6,0,0"
                                     Checked="SourceHandling_Checked">
                            <StackPanel>
                                <TextBlock Text="校验通过后删除" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="沿用清理源包的规则：回收站 / 彻底删除按设置里的那一档；失败一律不删" Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 两个勾选项 ==================== -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox x:Name="SaveAsDefaultBox"
                                     x:FieldModifier="public"
                                  Content="把本次选择存为默认（写入设置文件，下次启动仍是它）"
                                  Checked="Option_Changed"
                                  Unchecked="Option_Changed" />

                        <CheckBox x:Name="SuppressPanelBox"
                                     x:FieldModifier="public"
                                  Content="以后不再询问，直接按设置走（只对本次运行有效，不写设置文件）"
                                  Checked="Option_Changed"
                                  Unchecked="Option_Changed" />

                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"
                                   Text="不勾第一项时，appsettings.json 一个字节都不会改 —— 这次的落点、终端落法、源包处理只活在这一次运行里。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
