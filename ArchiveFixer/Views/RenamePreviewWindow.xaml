<Window x:Class="ArchiveFixer.Views.RenamePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="改名预览"
        Width="1100"
        Height="640"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <DockPanel Margin="10">

        <!-- 顶部说明 -->
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="请确认以下改名操作。新文件名可以手动编辑，只有选中的项目会被改名。"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#333333"
                           Margin="0,0,0,8" />

                <WrapPanel>
                    <TextBlock Text="总数："
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalCount}"
                               Margin="0,0,16,0" />

                    <TextBlock Text="已选："
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedCount}"
                               Margin="0,0,16,0" />

                    <TextBlock Text="可改名："
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding CanRenameCount}"
                               Margin="0,0,16,0" />

                    <TextBlock Text="冲突："
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding ConflictCount}"
                               Margin="0,0,16,0" />

                    <TextBlock Text="跳过："
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding SkipCount}"
                               Margin="0,0,16,0" />

                    <TextBlock Text="{Binding Message}"
                               Foreground="#666666"
                               Margin="20,0,0,0" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <Border DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,8,0,0">
            <DockPanel>
                <TextBlock Text="提示：确认前请仔细检查新文件名和新路径。改名操作会真实修改文件名。"
                           Foreground="#777777"
                           VerticalAlignment="Center" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="全选"
                            Width="90"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding SelectAllCommand}" />

                    <Button Content="全不选"
                            Width="90"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding SelectNoneCommand}" />

                    <Button Content="反选"
                            Width="90"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding InvertSelectionCommand}" />

                    <Button Content="仅选可改名"
                            Width="110"
                            Height="32"
                            Margin="0,0,20,0"
                            Command="{Binding SelectCanRenameCommand}" />

                    <Button Content="确认改名"
                            Width="110"
                            Height="34"
                            Margin="0,0,8,0"
                            FontWeight="Bold"
                            IsEnabled="{Binding HasExecutableItems}"
                            Click="ConfirmButton_Click" />

                    <Button Content="取消"
                            Width="90"
                            Height="34"
                            IsCancel="True"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 预览表格 -->
        <DataGrid x:Name="RenamePreviewGrid"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="White"
                  BorderBrush="#DDDDDD"
                  BorderThickness="1"
                  RowHeaderWidth="0"
                  AlternatingRowBackground="#FAFAFA"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">

            <DataGrid.Columns>

                <DataGridCheckBoxColumn Header="选择"
                                        Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Width="60" />

                <DataGridTextColumn Header="原文件名"
                                    Binding="{Binding OriginalFileName}"
                                    Width="180"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="检测格式"
                                    Binding="{Binding DetectedFormat}"
                                    Width="90"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="操作"
                                    Binding="{Binding Operation}"
                                    Width="140"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="新文件名，可编辑"
                                    Binding="{Binding NewFileName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="230"
                                    IsReadOnly="False" />

                <DataGridTextColumn Header="冲突处理"
                                    Binding="{Binding ConflictAction}"
                                    Width="120"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="状态"
                                    Binding="{Binding Status}"
                                    Width="130"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="错误信息"
                                    Binding="{Binding ErrorMessage}"
                                    Width="240"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="原路径"
                                    Binding="{Binding OriginalPath}"
                                    Width="360"
                                    IsReadOnly="True" />

                <DataGridTextColumn Header="新路径"
                                    Binding="{Binding NewPath}"
                                    Width="420"
                                    IsReadOnly="True" />

            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
