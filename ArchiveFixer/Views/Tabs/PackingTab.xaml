<UserControl x:Class="ArchiveFixer.Views.Tabs.PackingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ⑤ 打包页（用户 2026-09-24 第 11 条："我要是想打包一个文件还得在里面找这么小的一个位置"）。
        整页从原「打包文件夹为加密分卷」窗口搬进来（**没有第二份界面**），
        DataContext 指向 MainViewModel.PackingEditor。

        行结构（第 20 条）：提示条 Auto / 表单 星号可滚 / 操作栏 Auto —— 窗口拉大时表单跟着长。
    -->

    <Grid DataContext="{Binding PackingEditor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="220" />
            <!-- 可拖的分隔条（用户 2026-09-26："两个大框都不能上下移动间距来调整大小"） -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="150" />
        </Grid.RowDefinitions>

        <!-- ============ 提示条：校验不过 / 结果提示 ============ -->
        <Border Grid.Row="0"
                Margin="0,0,0,8"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource InfoBannerStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoticeKind}" Value="Success">
                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NoticeKind}" Value="Warning">
                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NoticeKind}" Value="Error">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BannerTextStyle}">
                        <Setter Property="Foreground" Value="{StaticResource InfoTextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NoticeKind}" Value="Success">
                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NoticeKind}" Value="Warning">
                                <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NoticeKind}" Value="Error">
                                <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ============ 表单（可滚） ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <StackPanel>

                    <!--
                        ==================== 源（文件夹或单个文件）====================
                        用户 2026-09-26 第 46 条："用户有权利直接选择一个文件"——
                        选文件时程序会在它旁边建同名文件夹把它装进去再打包（源文件不动）。
                    -->
                    <TextBlock Text="要打包的东西（选一个文件夹，或直接选一个文件）"
                               Style="{StaticResource LabelTextStyle}" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SourceFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="要打包的文件夹，或者一个文件。选文件时程序会在它旁边建同名文件夹把它放进去（不动源文件），再按文件夹打包" />

                        <Button Grid.Column="1"
                                Content="选文件夹…"
                                MinWidth="92"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseFolderCommand}" />

                        <Button Grid.Column="2"
                                Content="选文件…"
                                MinWidth="80"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseFileCommand}"
                                ToolTip="例如 111.mp4：程序会在它旁边建一个 111 文件夹把它装进去再打包（源文件一个字节都不动）" />
                    </Grid>

                    <TextBlock Text="{Binding SourceKindText}"
                               Style="{StaticResource HintTextStyle}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />

                    <!--
                        ==================== 密码 ====================
                        用户 2026-09-26 第 46 条："做成选择，相同或者不同，默认就是相同；
                        如果选择同一个密码用户只需要输入一次密码就够了，而且只有一个框……
                        旁边就是可以从用户密码列表里面去选择的按钮"。
                    -->
                    <TextBlock Text="密码（必填）" Style="{StaticResource LabelTextStyle}" Margin="0,14,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <RadioButton GroupName="PackPasswordMode"
                                     Content="两层相同（默认）"
                                     IsChecked="{Binding PasswordsAreSame, Mode=TwoWay}" />

                        <RadioButton GroupName="PackPasswordMode"
                                     Margin="16,0,0,0"
                                     Content="两层不同"
                                     IsChecked="{Binding UseSeparateOuterPassword, Mode=TwoWay}"
                                     ToolTip="第一层是 7z 分卷，最外层是最后那个 .rar / .7z" />
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="第一层："
                                   Style="{StaticResource LabelTextStyle}"
                                   VerticalAlignment="Center" />

                        <PasswordBox Grid.Column="1"
                                     x:Name="PasswordInput"
                                     PasswordChanged="PasswordInput_PasswordChanged"
                                     ToolTip="7z 分卷这一层的密码（连文件名一起加密）。密码只存在内存里，不写设置、不记日志" />

                        <Button Grid.Column="2"
                                Content="从密码列表选…"
                                MinWidth="110"
                                Margin="8,0,0,0"
                                Click="PickPassword_Click"
                                ToolTip="从④「密码」页那份列表里挑一条" />
                    </Grid>

                    <Grid Margin="0,6,0,0"
                          IsEnabled="{Binding OuterPasswordEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="最外层："
                                   Style="{StaticResource LabelTextStyle}"
                                   VerticalAlignment="Center" />

                        <PasswordBox Grid.Column="1"
                                     x:Name="OuterPasswordInput"
                                     PasswordChanged="OuterPasswordInput_PasswordChanged"
                                     ToolTip="最后那个 .rar / .7z 的密码（只有选「两层不同」时才用）" />

                        <Button Grid.Column="2"
                                Content="从密码列表选…"
                                MinWidth="110"
                                Margin="8,0,0,0"
                                Tag="Outer"
                                Click="PickPassword_Click" />
                    </Grid>

                    <!--
                        ==================== 外层容器（不再让用户选）====================
                        第 46 条：外层**默认 rar**；本机没装 WinRAR 时**自动改用 7z**
                        （用户原话："如果用户没有装 WinRAR，那就弄 7z 吧"）。
                        这一格只**如实显示**当前会用哪个。
                    -->
                    <Border Margin="0,12,0,0" Padding="10" CornerRadius="4" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoRar}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="{Binding RarStatusText}"
                                   Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!--
                        ==================== 落点（**选择在页面上**）====================
                        用户 2026-09-26 追加："选择还是得放在页面"；默认那一档的意思是
                        "跟①页「输出位置」走，没设过就是源旁边"。
                    -->
                    <TextBlock Text="最终压缩包放在哪" Style="{StaticResource LabelTextStyle}" Margin="0,14,0,0" />

                    <StackPanel Margin="0,4,0,0">
                        <RadioButton x:Name="PlacementFollow"
                                     GroupName="PackPlacement"
                                     Content="默认（放在源所在的目录旁边，也就是源旁边）"
                                     IsChecked="{Binding PlacementIsFollowDefault, Mode=TwoWay}" />

                        <RadioButton x:Name="PlacementCustom"
                                     GroupName="PackPlacement"
                                     Margin="0,6,0,0"
                                     Content="指定位置"
                                     IsChecked="{Binding PlacementIsCustom, Mode=TwoWay}" />

                        <DockPanel Margin="20,4,0,0">
                            <Button DockPanel.Dock="Right"
                                    Content="选择…"
                                    Padding="10,2"
                                    Margin="8,0,0,0"
                                    MinWidth="72"
                                    IsEnabled="{Binding PlacementIsEditable}"
                                    Command="{Binding PickPlacementDirectoryCommand}" />

                            <TextBox Text="{Binding CustomPlacementDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding PlacementIsEditable}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="这里是最终 .rar / .7z 会落到的目录（⛔ 只在你点「打包…」并确认之后才会往里写）" />
                        </DockPanel>

                        <TextBlock Text="{Binding PlacementSummaryText}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 摘要（点「打包…」还会弹一个小窗确认两档操作） -->
                    <TextBlock Text="摘要" Style="{StaticResource LabelTextStyle}" Margin="0,14,0,0" />

                    <Border Background="{StaticResource PanelSunkenBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SummaryText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding PlacementText}"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="点「打包…」还会弹一个小窗：确认原包操作 + 其余物操作（都会记住，下次照上次的来；落点在上面选）。" />

                            <!--
                                压缩流程（用户 2026-09-26："下面加一个压缩流程描述，将这个打包功能详细的给用户看"）。
                                ⛔ 文案与实际行为一一对应（改管线就要改这里）。
                            -->
                            <Border Background="{StaticResource PanelSunkenBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="压缩流程（点「打包…」并确认之后，程序按这四步走）"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,6" />

                                    <TextBlock TextWrapping="Wrap"
                                               LineHeight="20"
                                               Text="1）切分卷：把源里的东西用内置 7-Zip 打成加密分卷（-mhe 连文件名一起加密；内容 &lt;1 GiB 切 2 卷、≥1 GiB 切 3 卷，前面每卷装满、最后一卷是零头）。&#10;2）分卷就地落盘：分卷直接落在上面那个落点目录里（不再套一层同名文件夹），名字 = 源名 + .7z.001/.002…，撞名自动让位成 源名(1).7z.001。&#10;3）做外层容器：把上面那几个分卷压成一个带密码的 rar（本机没装 WinRAR 时自动用 7z，产物就是 .7z）；分卷在归档里是**顶层**的，解出来就是这几个分卷。&#10;4）校验 + 收尾：列一遍外层容器里的条目、与磁盘上的分卷逐个核对（对不上不显示成功）；通过之后才按你选的两档处理原包与其余物（其余物 = 那几个分卷文件，默认彻底删除）。失败 / 取消一个字节都不动。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 上下两块之间的分隔条：拖它就能调两块的间距（用户 2026-09-26 点名要的） -->
        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      Cursor="SizeNS"
                      ToolTip="上下拖动，调整「表单」与「进度 / 结果」两块的高度" />

        <!-- ============ 操作栏 + 进度 + 结果（内容自己滚，不再把上面那块压扁） ============ -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,4,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="打包…"
                                MinWidth="104"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartCommand}"
                                ToolTip="先校验落点与空间，再开始切分卷、做外层容器（还会弹一个小窗确认两档操作）" />

                        <Button Content="取消"
                                MinWidth="80"
                                Margin="8,0,0,0"
                                Command="{Binding CancelCommand}"
                                ToolTip="取消当前打包：只结束本程序启动的那个进程及其子进程；已经切出来的分卷保留" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="复制密码"
                                MinWidth="88"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="0,0,8,0"
                                Command="{Binding CopyPasswordCommand}"
                                ToolTip="把这次用的密码复制到剪贴板（程序自己不保存密码）" />

                        <Button Content="打开输出目录"
                                MinWidth="104"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding OpenOutputFolderCommand}" />
                    </StackPanel>

                    <Border />
                </DockPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="进度"
                               Style="{StaticResource LabelTextStyle}"
                               Margin="0,0,8,0" />

                    <ProgressBar Grid.Column="1"
                                 Height="16"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding ProgressPercent, Mode=OneWay, StringFormat={}{0}%}"
                               Style="{StaticResource HintTextStyle}"
                               MinWidth="44"
                               TextAlignment="Right"
                               Margin="8,0,0,0" />
                </Grid>

                <TextBlock Text="{Binding CurrentStepText}"
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding ProgressDetailText}"
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- 结果区 -->
                <Border Margin="0,10,0,0"
                        Padding="10"
                        CornerRadius="4"
                        BorderThickness="1"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultKind}" Value="Success">
                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultKind}" Value="Warning">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultKind}" Value="Error">
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock Text="{Binding ResultText}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding ResultOuterPath}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasOuterResult, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <DataGrid ItemsSource="{Binding Volumes}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="160"
                                  Margin="0,8,0,0"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="分卷" Binding="{Binding FileName}" Width="*" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding KeepFolderHint}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
