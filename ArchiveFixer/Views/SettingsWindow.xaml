<Window x:Class="ArchiveFixer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="760"
        Height="680"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

	<Window.Resources>
		<!-- 本窗口色板：把原先散落的 #RRGGBB 字面量收敛到一处。 -->
		<SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
		<SolidColorBrush x:Key="PanelBorderBrush" Color="#DDDDDD" />
		<SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333" />
		<SolidColorBrush x:Key="TextSecondaryBrush" Color="#555555" />
		<SolidColorBrush x:Key="TextMutedBrush" Color="#666666" />
		<SolidColorBrush x:Key="TextHintBrush" Color="#777777" />
		<SolidColorBrush x:Key="WarningTextBrush" Color="#B25E00" />
	</Window.Resources>

	<DockPanel Margin="10">

		<Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,8">
			<StackPanel>
				<TextBlock Text="设置"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

				<TextBlock Text="修改扫描、识别、改名、解压、密码和日志相关选项。点击保存后生效。"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextMutedBrush}" />
			</StackPanel>
		</Border>

		<Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,8,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock Text="{Binding Message}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />

				<StackPanel Grid.Column="1"
                            Orientation="Horizontal">
					<Button Content="恢复默认"
                            Width="90"
                            Margin="0,0,12,0"
                            Command="{Binding ResetDefaultCommand}" />

					<Button Content="保存"
                            Width="90"
                            Margin="0,0,6,0"
                            FontWeight="Bold"
                            Command="{Binding SaveCommand}" />

					<Button Content="取消"
                            Width="90"
                            IsCancel="True"
                            Command="{Binding CancelCommand}" />
				</StackPanel>
			</Grid>
		</Border>

		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel>

				<!-- 扫描设置 -->
				<GroupBox Header="扫描设置"
                          Margin="0,0,0,8"
                          Padding="10"
                          Background="{StaticResource PanelBrush}">
					<StackPanel>
						<CheckBox Content="递归扫描文件夹"
                                  IsChecked="{Binding Settings.RecursiveScan, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

						<CheckBox Content="拖拽导入后自动扫描"
                                  IsChecked="{Binding Settings.AutoScanAfterDrop, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

						<Grid Margin="0,0,0,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="扫描模式："
                                       VerticalAlignment="Center" />

							<ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.ScanMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
								<ComboBoxItem Content="扫描全部文件"
                                              Tag="ScanAllFiles" />
								<ComboBoxItem Content="只扫描常见压缩后缀"
                                              Tag="ScanKnownArchiveExtensions" />
								<ComboBoxItem Content="扫描可疑文件"
                                              Tag="ScanSuspiciousFiles" />
							</ComboBox>
						</Grid>
					</StackPanel>
				</GroupBox>

				<!-- 识别设置 -->
				<GroupBox Header="识别设置"
                          Margin="0,0,0,8"
                          Padding="10"
                          Background="{StaticResource PanelBrush}">
					<StackPanel>
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="未知格式处理："
                                       VerticalAlignment="Center" />

							<ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.UnknownFormatAction, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
								<ComboBoxItem Content="加入列表并标记未知"
                                              Tag="MarkUnknown" />
								<ComboBoxItem Content="跳过"
                                              Tag="Skip" />
								<ComboBoxItem Content="仍尝试解压"
                                              Tag="TryExtract" />
							</ComboBox>
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="默认补充后缀："
                                       VerticalAlignment="Center" />

							<TextBox Grid.Column="1"
                                     Text="{Binding Settings.DefaultExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     ToolTip="例如 .7z、.zip、.rar" />
						</Grid>
					</StackPanel>
				</GroupBox>

				<!-- 后缀修正设置 -->
				<GroupBox Header="后缀修正设置"
                          Margin="0,0,0,8"
                          Padding="10"
                          Background="{StaticResource PanelBrush}">
					<StackPanel>
						<CheckBox Content="改名前显示预览"
                                  IsChecked="{Binding Settings.PreviewBeforeRename, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="改名冲突处理："
                                       VerticalAlignment="Center" />

							<ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.ConflictAction, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
								<ComboBoxItem Content="跳过"
                                              Tag="Skip" />
								<ComboBoxItem Content="覆盖"
                                              Tag="Overwrite" />
								<ComboBoxItem Content="自动重命名"
                                              Tag="AutoRename" />
								<ComboBoxItem Content="询问"
                                              Tag="Ask" />
							</ComboBox>
						</Grid>
					</StackPanel>
				</GroupBox>

				<!-- 解压设置 -->
				<GroupBox Header="解压设置"
                          Margin="0,0,0,8"
                          Padding="10"
                          Background="{StaticResource PanelBrush}">
					<StackPanel>
						<CheckBox Content="解压到压缩包所在目录"
                                  IsChecked="{Binding Settings.ExtractToOriginalDirectory, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

						<CheckBox Content="保留压缩包同名文件夹"
                                  IsChecked="{Binding Settings.KeepArchiveNameFolder, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

						<CheckBox Content="解压前测试完整性"
                                  IsChecked="{Binding Settings.TestBeforeExtract, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="自定义输出目录："
                                       VerticalAlignment="Center" />

							<TextBox Grid.Column="1"
                                     Text="{Binding Settings.CustomOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center" />

							<Button Grid.Column="2"
                                    Content="选择"
                                    Width="70"
                                    Margin="8,0,0,0"
                                    Command="{Binding SelectOutputDirectoryCommand}" />
						</Grid>

						<!-- M3：结果归集。把每个包的产物移动到一个统一目录，方便一次性整理走。 -->
						<CheckBox Content="把解压结果归集到统一目录"
                                  IsChecked="{Binding Settings.CollectResultsToDirectory, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="归集目标目录："
                                       VerticalAlignment="Center" />

							<TextBox Grid.Column="1"
                                     Text="{Binding Settings.CollectTargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center" />

							<Button Grid.Column="2"
                                    Content="选择"
                                    Width="70"
                                    Margin="8,0,0,0"
                                    Command="{Binding SelectCollectTargetDirectoryCommand}" />
						</Grid>

						<!-- M3：清理源包。不可逆操作，因此默认关闭，并且只有"解压成功 + 校验通过"才删。 -->
						<CheckBox Content="解压成功且校验通过后删除源压缩包／源分卷"
                                  IsChecked="{Binding Settings.DeleteSourceAfterExtract, Mode=TwoWay}"
                                  Margin="0,0,0,4" />

						<TextBlock Text="⚠ 删除不可逆：校验不通过、被取消、只完成一部分时一律不删。默认关闭。"
                                   Foreground="{StaticResource WarningTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="24,0,0,8" />

						<!-- M4：递归解压。多分支默认不展开，必须问（AGENTS.md §6 第 8 条）。 -->
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="嵌套压缩包："
                                       VerticalAlignment="Center" />

							<ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.RecursionMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
								<ComboBoxItem Content="只解当前这一层"
                                              Tag="SingleLayer" />
								<ComboBoxItem Content="单链自动展开（推荐：只有一个内层包时才继续）"
                                              Tag="SingleChain" />
								<ComboBoxItem Content="展开所有分支（内层有多个包时全部解开）"
                                              Tag="AllBranches" />
							</ComboBox>
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="最大嵌套层数："
                                       VerticalAlignment="Center" />

							<TextBox Grid.Column="1"
                                     Text="{Binding Settings.MaxRecursionDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80"
                                     HorizontalAlignment="Left"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     ToolTip="1~10。到达上限会安全停下并报告停在哪一层，不会无限展开。" />
						</Grid>

						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="解压覆盖策略："
                                       VerticalAlignment="Center" />

							<ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.OverwriteMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
								<ComboBoxItem Content="跳过已存在文件"
                                              Tag="SkipExisting" />
								<ComboBoxItem Content="覆盖全部"
                                              Tag="OverwriteAll" />
								<ComboBoxItem Content="自动重命名解压出的文件"
                                              Tag="AutoRenameExtracted" />
								<ComboBoxItem Content="自动重命名已存在文件"
                                              Tag="AutoRenameExisting" />
							</ComboBox>
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="120" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="最大并发解压数："
                                       VerticalAlignment="Center" />

							<TextBox Grid.Column="1"
                                     Text="{Binding Settings.MaxParallelExtractCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center" />

							<TextBlock Grid.Column="2"
                                       Text="默认建议为 1，串行更稳定。"
                                       Margin="8,0,0,0"
                                       Foreground="{StaticResource TextHintBrush}"
                                       VerticalAlignment="Center" />
						</Grid>
					</StackPanel>
				</GroupBox>

				<!-- 密码设置 -->
				<GroupBox Header="密码设置"
                          Margin="0,0,0,8"
                          Padding="10"
                          Background="{StaticResource PanelBrush}">
					<StackPanel>
						<CheckBox Content="优先尝试空密码"
                                  IsChecked="{Binding Settings.TryEmptyPasswordFirst, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

						<CheckBox Content="对所有任务使用统一密码"
                                  IsChecked="{Binding Settings.UseGlobalPasswordForAllTasks, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

						<!-- M2：旁路说明文件。这是"猜"出来的候选，默认关闭（AGENTS.md §9.4）。 -->
						<CheckBox Content="从压缩包同目录的说明文件里提取密码候选（.txt/.bat 等）"
                                  IsChecked="{Binding Settings.EnableSidecarPassword, Mode=TwoWay}"
                                  Margin="0,0,0,4" />

						<TextBlock Text="开启后会把同目录说明文件里像密码的内容当作候选；候选排在用户明确给的密码之后。默认关闭。"
                                   Foreground="{StaticResource TextHintBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="24,0,0,8" />

						<!-- 每层的密码尝试上限（AGENTS.md §9.2）：到上限时状态是「达到密码尝试上限」，不是"密码错误"。 -->
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="120" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="每层密码尝试上限："
                                       VerticalAlignment="Center" />

							<TextBox Grid.Column="1"
                                     Text="{Binding Settings.MaxPasswordAttemptsPerLayer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     ToolTip="1~1000。每个包最多真的试这么多条候选；到上限会明确报「达到密码尝试上限」，不会报成密码错误。" />

							<TextBlock Grid.Column="2"
                                       Text="默认 10。密码本很长时调大才会试更多，但每个包都会更慢。"
                                       Margin="8,0,0,0"
                                       Foreground="{StaticResource TextHintBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
						</Grid>
					</StackPanel>
				</GroupBox>

				<!-- 日志设置 -->
				<GroupBox Header="日志设置"
                          Margin="0,0,0,8"
                          Padding="10"
                          Background="{StaticResource PanelBrush}">
					<StackPanel>
						<CheckBox Content="启用日志文件"
                                  IsChecked="{Binding Settings.EnableLog, Mode=TwoWay}" />
					</StackPanel>
				</GroupBox>

				<!-- 高级设置 -->
				<GroupBox Header="高级设置"
                          Margin="0,0,0,8"
                          Padding="10"
                          Background="{StaticResource PanelBrush}">
					<StackPanel>
						<CheckBox Content="记住上次输出目录"
                                  IsChecked="{Binding Settings.RememberLastOutputDirectory, Mode=TwoWay}"
                                  Margin="0,0,0,8" />

						<!-- 7z.exe 路径只有这一个入口，程序不再猜 D:\7-Zip（AGENTS.md §3.1）。 -->
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="130" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock Text="7z.exe 路径："
                                       VerticalAlignment="Center" />

							<TextBox Grid.Column="1"
                                     Text="{Binding Settings.CustomSevenZipExePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     ToolTip="留空表示使用程序目录下的 tools\7zip\7z.exe" />
						</Grid>

						<TextBlock Text="安全提示：默认不覆盖用户文件，Unknown 默认跳过，改名前应显示预览。"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource TextHintBrush}" />
					</StackPanel>
				</GroupBox>

			</StackPanel>
		</ScrollViewer>
	</DockPanel>
</Window>
