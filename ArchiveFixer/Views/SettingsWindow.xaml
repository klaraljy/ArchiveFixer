<Window x:Class="ArchiveFixer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="设置"
        Width="840"
        Height="720"
        MinWidth="780"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <!--
        设置窗口（UI v2）。
        改之前：8 个分组框挤在一起、字号只有一档、主次不分，而且"解压到哪"要靠
        「解压到压缩包所在目录」+「保留压缩包同名文件夹」两个开关自己组合。
        现在：分组标题独立成行、说明文字统一小字灰、输出位置改成四选一 + 实时示例，
        底部按钮按"危险在左、主操作在最右"排列。
    -->

    <DockPanel Margin="12">

        <!-- ============ 标题区 ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"
                           Text="修改扫描、识别、改名、解压、密码和日志相关选项。改完点右下角「保存」才生效；点「取消」不写入。" />
            </StackPanel>
        </Border>

        <!-- ============ 底部按钮区：危险操作在左，主操作在最右 ============ -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="恢复默认"
                        MinWidth="96"
                        Style="{StaticResource DangerOutlineButtonStyle}"
                        ToolTip="把这一页恢复成默认值（不会马上写盘，仍需点「保存」）"
                        Command="{Binding ResetDefaultCommand}" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            MinWidth="88"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Command="{Binding CancelCommand}" />

                    <Button Content="保存"
                            MinWidth="96"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="写入 appsettings.json 并立即生效"
                            Command="{Binding SaveCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding Message}"
                           Style="{StaticResource HintTextStyle}"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- ==================== 输出位置（四选一） ==================== -->
                <GroupBox Header="输出位置（解压到哪）">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,0,0,8"
                                   Text="四选一，互斥。下面写的就是这一档的实际落点，括号里是例子。" />

                        <RadioButton GroupName="OutputPlacement"
                                     IsChecked="{Binding OutputPlacement, Converter={StaticResource EnumOptionConverter}, ConverterParameter=ArchiveNamedSubfolder, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="解压到以压缩包名命名的子文件夹（默认）" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 111\222\内容物　（与 WinRAR 默认一致，不会和同目录其它文件混在一起）"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="OutputPlacement"
                                     IsChecked="{Binding OutputPlacement, Converter={StaticResource EnumOptionConverter}, ConverterParameter=SourceDirectory, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="解压到压缩包所在目录" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 111\内容物　（产物直接落在包旁边）"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="OutputPlacement"
                                     IsChecked="{Binding OutputPlacement, Converter={StaticResource EnumOptionConverter}, ConverterParameter=CustomNamedSubfolder, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="解压到指定位置，并建立同名子文件夹" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 333\222\内容物　（多个包各占一个文件夹，适合归集整理）"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="OutputPlacement"
                                     IsChecked="{Binding OutputPlacement, Converter={StaticResource EnumOptionConverter}, ConverterParameter=CustomFlat, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="解压到指定位置，直接放在该目录下" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 333\内容物　（所有包的内容物摊在同一个目录里）"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- 实时示例：切换单选后马上能看出落点 -->
                        <Border Style="{StaticResource InfoBannerStyle}" Margin="0,10,0,10">
                            <StackPanel>
                                <TextBlock Text="当前落点" Style="{StaticResource CardTitleTextStyle}"
                                           Foreground="{StaticResource InfoTextBrush}" />
                                <TextBlock Text="{Binding OutputPlacementSummary}"
                                           Style="{StaticResource BannerTextStyle}"
                                           Foreground="{StaticResource InfoTextBrush}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="指定位置："
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding CustomOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsCustomOutputEnabled}"
                                     ToolTip="只有上面选了「解压到指定位置」的两档才用得上；留空时按压缩包所在目录处理。" />

                            <Button Grid.Column="2"
                                    Content="选择"
                                    MinWidth="72"
                                    Margin="8,0,0,0"
                                    IsEnabled="{Binding IsCustomOutputEnabled}"
                                    Command="{Binding SelectOutputDirectoryCommand}" />

                            <TextBlock Grid.Column="3"
                                       Text="（不适用）"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCustomOutputEnabled}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0"
                                   Text="说明：改这里只影响之后启动的解压；已经解压过的任务保持原落点。" />
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 内容物最后一层（终端落法） ==================== -->
                <GroupBox Header="内容物最后那一层（终端落法）">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,0,0,8"
                                   Text="二选一。只影响“多文件 / 自带一层文件夹”时套出来的那一层叫什么；终端只有一个文件时本来就没有这一层，两种取值结果相同。" />

                        <RadioButton GroupName="TerminalLayout"
                                     IsChecked="{Binding TerminalLayout, Converter={StaticResource EnumOptionConverter}, ConverterParameter=KeepLastFolder, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="多文件时保留最后一层文件夹名（默认）" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 111\222\666\内容物　（保留包内那一层名字，不丢信息）"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="TerminalLayout"
                                     Margin="0,6,0,0"
                                     IsChecked="{Binding TerminalLayout, Converter={StaticResource EnumOptionConverter}, ConverterParameter=UseArchiveName, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="多文件时用压缩包名当最后一层" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="111\222.rar → 111\222\内容物　（少一层点击，但丢掉了包内那层名字）"
                                           Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </RadioButton>

                        <Separator Margin="0,10,0,8" />

                        <!-- 场景 B 塌缩（规格 §3.3，默认开） -->
                        <CheckBox Content="包名与所在文件夹同名时，去掉重复的那一层"
                                  IsChecked="{Binding CollapseRepeatedFolderLayer, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="22,0,0,0"
                                   Text="111\222\名字\名字.rar → 111\222\名字\内容物（默认开）。仅当该文件夹下没有别的包时才生效；还有别的包时保留完整一层，免得两个包的产物混在一起。" />
                    </StackPanel>
                </GroupBox>

                <!--
                    ==================== 引擎（用哪个程序解压） ====================
                    用户 2026-09-22 指示："先是 winrar、7z、然后就是后面的引擎"。
                    选择规则是**先按能力筛（谁能干这活），再用这个顺序做 tiebreaker**；
                    不可用的引擎自动跳过 —— 排第一但没装的引擎不会让包打不开。
                    AGENTS.md §3.1 还要求"界面显示当前是否在用"，所以每行都带：
                    检测状态 + 路径 + 版本 + 它当前负责哪些格式。
                -->
                <GroupBox Header="引擎（用哪个程序解压）">
                    <StackPanel>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="顺序 = 优先级（默认：UnRAR → 7-Zip）。规则是「先看谁能干这活（能力），再按这个顺序挑」：RAR 包优先用 UnRAR，zip / 7z / tar 等格式只有 7-Zip 能做，永远走 7-Zip。排在前面的引擎没检测到会自动跳到下一个，不会因此打不开包。" />

                        <ItemsControl ItemsSource="{Binding Engines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource OptionRowStyle}"
                                            Background="{StaticResource PanelSunkenBrush}"
                                            BorderBrush="{StaticResource PanelBorderBrush}"
                                            Margin="0,0,0,6"
                                            Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding HeaderText}"
                                                           Style="{StaticResource BodyTextStyle}" />

                                                <TextBlock Style="{StaticResource HintTextStyle}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"
                                                           Text="{Binding Path, StringFormat=路径：{0}}" />

                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Style="{StaticResource HintTextStyle}"
                                                               Text="{Binding SourceText, StringFormat=来源：{0}}" />

                                                    <TextBlock Margin="10,0,0,0"
                                                               Text="{Binding UsageText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Grid.Column="2"
                                                    Content="上移"
                                                    MinWidth="56"
                                                    Margin="0,0,6,0"
                                                    Style="{StaticResource ToolbarButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanMoveUp}"
                                                    ToolTip="把它的优先级提前一位（排在前面的优先被选上）"
                                                    Command="{Binding DataContext.MoveEngineUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />

                                            <Button Grid.Column="3"
                                                    Content="下移"
                                                    MinWidth="56"
                                                    Style="{StaticResource ToolbarButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanMoveDown}"
                                                    ToolTip="把它的优先级推后一位"
                                                    Command="{Binding DataContext.MoveEngineDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource InfoBannerStyle}" Margin="0,4,0,10">
                            <TextBlock Style="{StaticResource BannerTextStyle}"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding EngineSelectionSummary}" />
                        </Border>

                        <!-- UnRAR.exe 路径：留空 = 本机已装的 WinRAR 目录 → 程序内置 tools\unrar -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="UnRAR.exe 路径："
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding CustomUnRarExePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="留空表示自动：先找本机已装 WinRAR 目录里的 UnRAR.exe，再退回程序内置的 tools\unrar\UnRAR.exe。" />
                        </Grid>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="140,0,0,10"
                                   TextWrapping="Wrap"
                                   Text="留空 = 自动（已装的 WinRAR 目录 → 程序内置 tools\unrar）。只解压、不改包：程序不会调用建包 / 修包命令。7z.exe 的路径在下方「高级设置」里改。" />

                        <!--
                            保留受损文件（-kb，默认关）。依据 docs/WinRAR功能参考.md §2 C 组。
                            ⚠ 它只对 RAR 引擎（UnRAR）生效：7-Zip 26.01 **没有** -kb 这个开关
                            （实测 `7z x -kb` → "Unknown switch: -kb"，退出码 7），
                            而且 7-Zip 本来就保留校验失败的半成品 —— 两种情况下行为都已经是对的。
                            它也**绝不**把失败变成成功：损坏的包仍然是「失败 / 部分完成」（不变量 6）。
                        -->
                        <CheckBox Content="保留受损的文件（校验和不符的半成品留在磁盘上，默认关）"
                                  IsChecked="{Binding KeepBrokenFiles, Mode=TwoWay}"
                                  Margin="0,0,0,2" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="22,0,0,0"
                                   TextWrapping="Wrap"
                                   Text="开着只是让 RAR 引擎（UnRAR）别把校验失败的半成品删掉（-kb）。7-Zip 没有这个开关、本来就保留半成品，所以这一项对它不加任何参数。任务状态仍然是「失败 / 部分完成」—— 校验和不符就是失败，不会因为这个开关显示成功。" />
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 扫描设置 ==================== -->
                <GroupBox Header="扫描设置">
                    <StackPanel>
                        <CheckBox Content="递归扫描文件夹"
                                  IsChecked="{Binding Settings.RecursiveScan, Mode=TwoWay}" />

                        <CheckBox Content="拖拽导入后自动扫描"
                                  IsChecked="{Binding Settings.AutoScanAfterDrop, Mode=TwoWay}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="扫描模式："
                                       Style="{StaticResource LabelTextStyle}" />

                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.ScanMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="扫描全部文件" Tag="ScanAllFiles" />
                                <ComboBoxItem Content="只扫描常见压缩后缀" Tag="ScanKnownArchiveExtensions" />
                                <ComboBoxItem Content="扫描可疑文件" Tag="ScanSuspiciousFiles" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0"
                                   Text="格式靠文件头识别，不靠后缀 —— 后缀被改坏的包也能认出来。" />
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 识别设置 ==================== -->
                <GroupBox Header="识别设置">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="未知格式处理："
                                       Style="{StaticResource LabelTextStyle}" />

                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.UnknownFormatAction, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="加入列表并标记未知" Tag="MarkUnknown" />
                                <ComboBoxItem Content="跳过" Tag="Skip" />
                                <ComboBoxItem Content="仍尝试解压" Tag="TryExtract" />
                            </ComboBox>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="默认补充后缀："
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding Settings.DefaultExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="例如 .7z、.zip、.rar" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 后缀与改名 ==================== -->
                <GroupBox Header="后缀与改名">
                    <StackPanel>
                        <!--
                            这里以前有一个「改名前显示预览」复选框，但改名**永远**会先弹预览
                            （不变量 §6 第 3 条：PreviewBeforeRename 不得被任何代码旁路），
                            勾不勾都不影响行为 —— 属于"改了没用"的开关，所以直接删掉，只留说明。
                        -->
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="改名一定会先弹预览，改完由你确认才落盘（安全约束，没有开关可以跳过）。" />

                        <!--
                            同名冲突处理（ConflictAction）：**一处设置，两处生效** ——
                            ① 解压落位（输出目录已存在且非空、定稿搬运时同名）；② 改名冲突（预览里逐条列出）。
                            「询问」以前是典型的"界面说一套、代码做一套"：选了询问却被静默自动重命名
                            （PathService 把它和 AutoRename 并到同一个分支）。现在它真的会暂停任务问一次，
                            语义写在下面的提示行里 —— 界面上的每一档都必须能在行为里找到对应。
                        -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="同名冲突处理："
                                       Style="{StaticResource LabelTextStyle}"
                                       ToolTip="解压落位与改名遇到同名时的处置方式（默认自动重命名，绝不覆盖）。" />

                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.ConflictAction, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      ToolTip="默认「自动重命名」：新产物落成 名字(1)，不动已存在的文件。">
                                <ComboBoxItem Content="跳过（不动已存在的文件）" Tag="Skip" />
                                <ComboBoxItem Content="覆盖（先挪到临时名，落位成功后才删旧的）" Tag="Overwrite" />
                                <ComboBoxItem Content="自动重命名（默认，绝不覆盖）" Tag="AutoRename" />
                                <ComboBoxItem Content="询问（第一次冲突时暂停任务问一次）" Tag="Ask" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="110,4,0,0"
                                   Text="「询问」作用于解压落位（输出目录已存在且非空 / 定稿时同名）：第一次撞上时暂停该任务，弹一次聚合询问 —— 覆盖 / 跳过 / 自动重命名，勾上「对后面所有同名冲突都照此办理」就对整批生效（本批不会再问第二次，50~200 个包也只打断你一次）；直接关掉那个窗口 = 取消本批。没有界面宿主时（命令行 / 测试）按「自动重命名」保守落位，绝不覆盖。改名冲突在预览表里逐条列出、点确认才落盘，那一步没有询问弹窗（预览本身就是确认）。" />
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 解压与整理 ==================== -->
                <GroupBox Header="解压与整理">
                    <StackPanel>
                        <CheckBox Content="解压前测试完整性"
                                  IsChecked="{Binding Settings.TestBeforeExtract, Mode=TwoWay}" />

                        <!--
                            定稿完成后打开输出目录（**默认关**）。
                            依据 docs/WinRAR功能参考.md §2 C 组 / §3 第 7 条：「整理完就想看一眼结果」
                            是这个产品的自然下一步动作，但它**会动用户桌面**，所以必须由用户显式开启。
                            ⚠ 打开时只开文件夹（复用 SafePathHelper.OpenDirectory → explorer.exe <目录>），
                            **不置前、不最大化、不抢焦点**（AGENTS.md §13 同精神）。
                        -->
                        <CheckBox Content="定稿完成后在资源管理器里打开输出目录（默认关）"
                                  IsChecked="{Binding Settings.OpenOutputFolderWhenDone, Mode=TwoWay}"
                                  Margin="0,8,0,2" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="22,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="只在任务真正定稿成功（内容物已落盘 + 输出校验通过）之后打开；失败 / 部分完成 / 取消时一律不打开（那时打开一个空目录只会误导你）。只打开文件夹，不会把本程序窗口置前或最大化。" />

                        <!--
                            危险条目统计（默认开，**只提示不阻断**）。
                            docs/WinRAR功能参考.md §2 F 组 / §3 第 5 条：我们的场景里安装器 / 补丁
                            经常就是内容物，所以**不做**它的全局硬排除掩码，只把「本包含 N 个可执行文件」
                            写进任务详情与失败清单（复用既有那一遍解压前条目预检，不额外扫一遍）。
                        -->
                        <CheckBox Content="统计并提示可疑条目（可执行文件 / 脚本，默认开）"
                                  IsChecked="{Binding Settings.ReportDangerousEntries, Mode=TwoWay}"
                                  Margin="0,0,0,2" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="22,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="在既有那一遍解压前条目预检里顺便统计 .exe/.scr/.lnk/.bat/.cmd/.ps1/.vbs，把「本包含 N 个可执行文件（前几个列出名字）」写进任务详情与失败清单。只提示、绝不阻断：不会因此跳过任何条目，也不会改变落盘结果；关掉只是不统计。" />

                        <!-- M3：结果归集。把每个包的产物移动到一个统一目录，方便一次性整理走。 -->
                        <CheckBox Content="把解压结果归集到统一目录"
                                  IsChecked="{Binding Settings.CollectResultsToDirectory, Mode=TwoWay}"
                                  Margin="0,8,0,4" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="归集目标目录："
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding Settings.CollectTargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="2"
                                    Content="选择"
                                    MinWidth="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding SelectCollectTargetDirectoryCommand}" />
                        </Grid>

                        <Separator Margin="0,4,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="嵌套压缩包："
                                       Style="{StaticResource LabelTextStyle}" />

                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.RecursionMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="只解当前这一层" Tag="SingleLayer" />
                                <ComboBoxItem Content="单链自动展开（推荐：只有一个内层包时才继续）" Tag="SingleChain" />
                                <ComboBoxItem Content="展开所有分支（内层有多个包时全部解开）" Tag="AllBranches" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="最大嵌套层数："
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding Settings.MaxRecursionDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="1~10。到达上限会安全停下并报告停在哪一层，不会无限展开。" />

                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="1~10。到上限会停下并报告，不会无限展开。" />
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="解压覆盖策略："
                                       Style="{StaticResource LabelTextStyle}" />

                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.OverwriteMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="跳过已存在文件" Tag="SkipExisting" />
                                <ComboBoxItem Content="覆盖全部" Tag="OverwriteAll" />
                                <ComboBoxItem Content="自动重命名解压出的文件" Tag="AutoRenameExtracted" />
                                <ComboBoxItem Content="自动重命名已存在文件" Tag="AutoRenameExisting" />
                            </ComboBox>
                        </Grid>

                        <!--
                            D-9（用户 2026-09-22 拍板）：源包处理的默认档 = 移入「其余物」。
                            三档互斥，只有这一处设置；列表顺序按"从最保守到最激进"排，
                            所以默认的第二项是「移入其余物」。
                        -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="源包处理："
                                       Style="{StaticResource LabelTextStyle}"
                                       ToolTip="「一键处理」里怎么处理你给的那个源包（含分卷整组）。" />

                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding SourceHandling, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      ToolTip="一键处理与手动「只解压」读的是同一档（用户 2026-09-22 版本二）。">
                                <ComboBoxItem Content="留在原地（不动源包）" Tag="KeepInPlace" />
                                <ComboBoxItem Content="移入「其余物」（默认，推荐）" Tag="MoveToRest" />
                                <ComboBoxItem Content="校验通过后删除（不可逆）" Tag="DeleteAfterVerify" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="110,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="两条路径（一键处理与手动「只解压」）读的是同一档：默认把源包（含分卷整组）移进输出目录里的「其余物」，整理完删一个目录就干净了。只有「内容物已定稿 + 输出校验通过 + 未取消 + 属于本任务分卷组」四条同时成立才动源包；失败 / 部分完成 / 取消时源包一律原地不动、其余物不生成。想要「传统解压器」语义就选「留在原地」。" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="最大并发解压数："
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding Settings.MaxParallelExtractCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="默认 1（串行）更稳定。" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!--
                    ==================== 清理（不可逆） ====================
                    两件事同组：①「其余物 / 空文件夹」清理的**默认档**；② 地基路径上更老的清理源包开关。
                    两者的默认值都取最保守的那一侧：回收站 / 不删。
                -->
                <GroupBox Header="清理（不可逆）">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="其余物清理默认档："
                                       Style="{StaticResource LabelTextStyle}"
                                       ToolTip="只决定删除确认框里那个「改为彻底删除」勾选框的默认状态。" />

                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding Settings.RestRemovalDefaultMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      ToolTip="无论哪一档，删除前都先预览 + 确认；彻底删除还要二次确认。">
                                <ComboBoxItem Content="移入回收站（默认，可从回收站还原）" Tag="RecycleBin" />
                                <ComboBoxItem Content="彻底删除（不可恢复，仍要二次确认）" Tag="Permanent" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="140,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="只是确认框的默认档，不是「跳过确认」：删除前一定先列出条目数与总大小让你确认；选「彻底删除」还要勾一次「我知道不可恢复」。回收站不可用时（网络盘 / 策略禁用 / 卷没回收站）一律不删并说明原因，绝不会因为这一项就降级成彻底删除。" />

                        <Separator Margin="0,4,0,10" />

                        <CheckBox Content="手动「只解压」：解压成功且校验通过后删除源压缩包／源分卷"
                                  IsChecked="{Binding Settings.DeleteSourceAfterExtract, Mode=TwoWay}" />

                        <Border Style="{StaticResource WarningBannerStyle}" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource BannerTextStyle}"
                                       Foreground="{StaticResource WarningTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="⚠ 删除不可逆。默认关闭。它只在上面「源包处理」选了「留在原地」时的手动「只解压」路径上参与（那是「传统解压器 + 解压后清理源包」的老组合）；默认的「移入其余物」档下它不参与 —— 否则刚搬进其余物的源包会被立刻删掉。只有「解压成功 + 输出校验通过」才会删；校验不通过、被取消、只完成一部分时一律不删。" />
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 密码设置 ==================== -->
                <GroupBox Header="密码设置">
                    <StackPanel>
                        <CheckBox Content="优先尝试空密码"
                                  IsChecked="{Binding Settings.TryEmptyPasswordFirst, Mode=TwoWay}" />

                        <CheckBox Content="对所有任务使用统一密码"
                                  IsChecked="{Binding Settings.UseGlobalPasswordForAllTasks, Mode=TwoWay}" />

                        <!-- M2：旁路说明文件。这是"猜"出来的候选，默认关闭（AGENTS.md §9.4）。 -->
                        <CheckBox Content="从压缩包同目录的说明文件里提取密码候选（.txt/.bat 等）"
                                  IsChecked="{Binding Settings.EnableSidecarPassword, Mode=TwoWay}"
                                  Margin="0,8,0,2" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="22,0,0,8"
                                   Text="开启后会把同目录说明文件里像密码的内容当作候选；候选排在用户明确给的密码之后。默认关闭。" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="每层尝试上限："
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding Settings.MaxPasswordAttemptsPerLayer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="1~1000。每个包最多真的试这么多条候选；到上限会明确报「达到密码尝试上限」，不会报成密码错误。" />

                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="默认 10。密码本很长时调大才会试更多，但每个包都会更慢。" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 日志设置 ==================== -->
                <GroupBox Header="日志设置">
                    <StackPanel>
                        <CheckBox Content="启用日志文件"
                                  IsChecked="{Binding Settings.EnableLog, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="22,0,0,0"
                                   Text="关掉之后不再往 data\logs 追加文件日志（屏幕上的日志照旧显示）；日志里的密码一律脱敏。" />
                    </StackPanel>
                </GroupBox>

                <!--
                    ==================== 常规与性能 ====================
                    低运行优先级（**默认开**）。依据 docs/WinRAR功能参考.md §2 D 组 / §3 第 9 条：
                    这一段以前硬编码在 App.xaml.cs 里，用户觉得"卡 / 慢"时**没有任何可调项**。
                    ⚠ 它与上面「最大并发解压数」是两个**互相独立**的旋钮，界面上必须说清
                    （抄的是 WinRAR 6.02 修过的坑：两个调节项互相覆盖）。
                -->
                <GroupBox Header="常规与性能">
                    <StackPanel>
                        <CheckBox Content="低运行优先级运行（默认开）"
                                  IsChecked="{Binding Settings.LowProcessPriority, Mode=TwoWay}"
                                  ToolTip="让本程序与它启动的解压进程（7z.exe）让出 CPU / 磁盘优先级。" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="22,0,0,6"
                                   TextWrapping="Wrap"
                                   Text="开着：批量解压时还让得开手，前台程序不会被拖卡（代价是纯后台跑时慢一点）。关掉：跑得更快，但更容易把你正在用的桌面拖住。重启程序后生效。" />

                        <Border Style="{StaticResource InfoBannerStyle}" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource BannerTextStyle}"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="「低运行优先级」与上面「最大并发解压数」是两个互相独立的旋钮：这一项决定让不让出 CPU / 磁盘优先级，并发数决定同时跑几个包。改其中一个不会顺手改另一个（WinRAR 6.02 修过「两个调节项互相覆盖」这个坑，我们不重蹈）。" />
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- ==================== 高级设置 ==================== -->
                <GroupBox Header="高级设置">
                    <StackPanel>
                        <CheckBox Content="记住上次输出目录"
                                  IsChecked="{Binding Settings.RememberLastOutputDirectory, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="22,0,0,0"
                                   Text="关掉之后：下次启动不再把上次的输出目录填回来，主窗口里临时选的目录也不会写进设置。" />

                        <!--
                            缓存根目录（日志 / 临时 / 递归工作区都放它下面）。
                            留空 = 程序目录下的 data；填了必须在**非 C 盘**上，保存时会拦住 C 盘并说明原因。
                        -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="缓存根目录："
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding CacheRootDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="留空表示用程序目录下的 data。日志、临时文件、递归工作区都放它下面；不能填 C 盘。" />

                            <Button Grid.Column="2"
                                    Content="选择"
                                    MinWidth="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding SelectCacheRootDirectoryCommand}" />
                        </Grid>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   Text="留空 = 程序目录下的 data（默认，跟着安装位置走）。缓存不能落 C 盘：填了系统盘会拒绝保存并说明原因。" />

                        <!-- 7z.exe 路径只有这一个入口，程序不再猜 D:\7-Zip（AGENTS.md §3.1）。 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="7z.exe 路径："
                                       Style="{StaticResource LabelTextStyle}" />

                            <TextBox Grid.Column="1"
                                     Text="{Binding Settings.CustomSevenZipExePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="留空表示使用程序目录下的 tools\7zip\7z.exe" />
                        </Grid>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,8,0,0"
                                   Text="安全提示：默认不覆盖用户文件；未知格式默认跳过；改名一定会先给预览。" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
