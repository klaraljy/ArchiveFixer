<Window x:Class="ArchiveFixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ArchiveFixer.ViewModels"
        xmlns:converters="clr-namespace:ArchiveFixer.Converters"
        Title="ArchiveFixer 第十一版 - 批量压缩包识别与解压工具"
        Width="1380"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:EmptyStringToTextConverter x:Key="EmptyStringToTextConverter" />

        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- 顶部菜单：低频操作收进菜单，主界面不再堆一排按钮 -->
        <Menu DockPanel.Dock="Top"
              Margin="0,0,0,6"
              Background="Transparent">
            <MenuItem Header="文件">
                <MenuItem Header="添加文件..." Command="{Binding AddFilesCommand}" />
                <MenuItem Header="添加文件夹..." Command="{Binding AddFolderCommand}" />

                <MenuItem Header="重新扫描" Command="{Binding ScanCommand}" />
                <MenuItem Header="移除选中" Command="{Binding RemoveSelectedCommand}" />
                <MenuItem Header="清空列表" Command="{Binding ClearCommand}" />
            </MenuItem>
            <MenuItem Header="工具">
                <MenuItem Header="设置..." Command="{Binding OpenSettingsCommand}" />
                <MenuItem Header="密码列表..." Command="{Binding OpenPasswordListCommand}" />

                <MenuItem Header="打开输出目录" Command="{Binding OpenOutputDirectoryCommand}" />
                <MenuItem Header="打开工作区目录" Command="{Binding OpenWorkDirectoryCommand}" />




                <MenuItem Header="导出日志" Command="{Binding ExportLogCommand}" />
                <MenuItem Header="打开日志目录" Command="{Binding OpenLogDirectoryCommand}" />
            </MenuItem>
        </Menu>

        <!-- 主操作条：只留真正常用的三件事 —— 导入、选输出目录、一键处理 -->
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="添加文件"
                            MinWidth="88"
                            Command="{Binding AddFilesCommand}" />

                    <Button Content="添加文件夹"
                            MinWidth="96"
                            Margin="6,0,0,0"
                            Command="{Binding AddFolderCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="16,0">
                    <TextBlock Text="输出到："
                               VerticalAlignment="Center"
                               Foreground="#555555" />

                    <TextBox Text="{Binding SelectedOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="300"
                             Height="26"
                             VerticalContentAlignment="Center"
                             ToolTip="留空表示解压到压缩包所在目录" />

                    <Button Content="选择"
                            Margin="6,0,0,0"
                            Command="{Binding SelectOutputDirectoryCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="停止后续"
                            Margin="0,0,6,0"
                            ToolTip="当前任务继续跑完，但不再启动新任务"
                            Command="{Binding StopCommand}" />

                    <Button Content="取消当前"
                            Margin="0,0,12,0"
                            ToolTip="强制结束当前任务的 7-Zip 进程（保留工作区与日志）"
                            Command="{Binding CancelCurrentCommand}" />

                    <!-- 主按钮：对勾选的任务走完 识别 → 修正后缀 → 按密码本解压 → 汇总 -->
                    <Button Content="一键处理"
                            MinWidth="120"
                            Height="34"
                            FontWeight="Bold"
                            FontSize="15"
                            Background="#FFE8F4FF"
                            ToolTip="对勾选的任务依次做：识别格式 → 修正伪装后缀（先给你看预览）→ 按密码本解压 → 汇总结果"
                            Command="{Binding OneClickProcessCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 手动操作：默认收起。不常用，但需要时就在那儿，不必记快捷键 -->
        <Expander DockPanel.Dock="Top"
                  Header="手动操作（单独改后缀 / 单独解压 / 重新扫描）"
                  Margin="0,0,0,8"
                  Padding="10,8"
                  Background="White"
                  BorderBrush="#DDDDDD"
                  BorderThickness="1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="智能修正后缀"
                        MinWidth="110"
                        FontWeight="Bold"
                        Command="{Binding SmartRenameCommand}" />

                <Button Content="添加后缀"
                        Command="{Binding AddExtensionCommand}" />

                <Button Content="替换后缀"
                        Command="{Binding ReplaceExtensionCommand}" />

                <Button Content="删除后缀"
                        Command="{Binding DeleteLastExtensionCommand}" />

                <Button Content="删除多个后缀"
                        MinWidth="110"
                        Command="{Binding DeleteMultipleExtensionsCommand}" />

                <Border Width="1"
                        Height="24"
                        Background="#DDDDDD"
                        Margin="10,0" />

                <Button Content="开始解压"
                        MinWidth="90"
                        FontWeight="Bold"
                        Command="{Binding StartExtractCommand}" />

                <Button Content="重新扫描"
                        Margin="10,0,0,0"
                        Command="{Binding ScanCommand}" />

                <Button Content="移除选中"
                        Command="{Binding RemoveSelectedCommand}" />

                <Button Content="清空列表"
                        Command="{Binding ClearCommand}" />
            </WrapPanel>
        </Expander>

        <!-- 底部日志区 -->
        <Grid DockPanel.Dock="Bottom"
              Height="180"
              Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1,1,1,0"
                    CornerRadius="4,4,0,0"
                    Padding="8,6">
                <DockPanel>
                    <TextBlock Text="日志"
                               FontWeight="Bold"
                               Foreground="#333333"
                               VerticalAlignment="Center" />

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="复制失败列表"
                                Height="26"
                                Command="{Binding CopyFailedListCommand}" />

                        <Button Content="导出失败清单"
                                Height="26"
                                Margin="8,0,0,0"
                                ToolTip="把失败任务与原因导出成 txt，便于逐条处理或留档"
                                Command="{Binding ExportFailedListCommand}" />

                        <Button Content="打开输出目录"
                                Height="26"
                                Command="{Binding OpenOutputDirectoryCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="0,0,4,4">
                <ListBox ItemsSource="{Binding Logs}"
                         BorderThickness="0"
                         Background="White"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="NoWrap">
                                <Run Text="{Binding Time, StringFormat=[{0:yyyy-MM-dd HH:mm:ss}]}" />
                                <Run Text=" [" />
                                <Run Text="{Binding Level}" />
                                <Run Text="] " />
                                <Run Text="{Binding Message}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- 主体区域 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 扫描和解压选项区 -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <TextBlock Text="扫描选项："
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <CheckBox Content="递归扫描"
                                  IsChecked="{Binding Settings.RecursiveScan, Mode=TwoWay}" />

                        <CheckBox Content="拖拽后自动扫描"
                                  IsChecked="{Binding Settings.AutoScanAfterDrop, Mode=TwoWay}" />

                        <TextBlock Text="扫描模式："
                                   VerticalAlignment="Center"
                                   Margin="8,0,6,0" />

                        <ComboBox Width="180"
                                  SelectedValue="{Binding Settings.ScanMode, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="扫描全部文件"
                                          Tag="ScanAllFiles" />
                            <ComboBoxItem Content="常见压缩后缀"
                                          Tag="ScanKnownArchiveExtensions" />
                            <ComboBoxItem Content="可疑文件"
                                          Tag="ScanSuspiciousFiles" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,8">
                        <TextBlock Text="解压选项："
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <CheckBox Content="原目录"
                                  IsChecked="{Binding Settings.ExtractToOriginalDirectory, Mode=TwoWay}" />

                        <CheckBox Content="保留同名文件夹"
                                  IsChecked="{Binding Settings.KeepArchiveNameFolder, Mode=TwoWay}" />

                        <CheckBox Content="解压前测试"
                                  IsChecked="{Binding Settings.TestBeforeExtract, Mode=TwoWay}" />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="输出目录："
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SelectedOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="为空时根据设置解压到原目录或默认目录。" />

                        <Button Grid.Column="2"
                                Content="选择"
                                Margin="6,0,12,0"
                                Command="{Binding SelectOutputDirectoryCommand}" />

                        <TextBlock Grid.Column="3"
                                   Text="如果启用“原目录”，此处可为空；如果选择自定义输出目录，会自动关闭原目录模式。"
                                   Foreground="#777777"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Column="4"
                                   Text="覆盖策略："
                                   VerticalAlignment="Center"
                                   Margin="12,0,6,0" />

                        <ComboBox Grid.Column="5"
                                  SelectedValue="{Binding Settings.OverwriteMode, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="跳过已存在文件"
                                          Tag="SkipExisting" />
                            <ComboBoxItem Content="覆盖全部"
                                          Tag="OverwriteAll" />
                            <ComboBoxItem Content="自动重命名解压文件"
                                          Tag="AutoRenameExtracted" />
                            <ComboBoxItem Content="自动重命名已有文件"
                                          Tag="AutoRenameExisting" />
                        </ComboBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- 密码区 -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="统一密码："
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />

                    <Grid Grid.Column="1">
                        <!-- 明文显示时使用 TextBox -->
                        <TextBox x:Name="GlobalPasswordTextBox"
             Text="{Binding GlobalPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="输入统一密码">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- 隐藏显示时使用 PasswordBox，仍然可以正常输入 -->
                        <PasswordBox x:Name="GlobalPasswordBox"
                 PasswordChanged="GlobalPasswordBox_PasswordChanged"
                 ToolTip="输入统一密码">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                    </Grid>


                    <Button Grid.Column="2"
                            Content="显示/隐藏"
                            Margin="6,0,6,0"
                            Command="{Binding ToggleShowPasswordCommand}" />

                    <CheckBox Grid.Column="3"
                              Content="使用统一密码"
                              IsChecked="{Binding Settings.UseGlobalPasswordForAllTasks, Mode=TwoWay}" />

                    <Button Grid.Column="4"
                            Content="密码列表管理"
                            MinWidth="110"
                            Command="{Binding OpenPasswordListCommand}" />

                    <TextBlock Grid.Column="5"
                               Text="日志不会记录明文密码；密码包含空格、中文和特殊符号时会通过 ArgumentList 安全传递。"
                               Foreground="#777777"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0,0,0" />
                </Grid>
            </Border>

            <!-- 任务列表 -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4">
                <DataGrid x:Name="TaskDataGrid"
                    ItemsSource="{Binding Tasks}"
                    SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    SelectionMode="Extended"
                    SelectionUnit="FullRow"
                    RowHeaderWidth="0"
                    AlternatingRowBackground="#FAFAFA"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    PreviewMouseRightButtonDown="TaskDataGrid_PreviewMouseRightButtonDown">


                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="打开文件所在目录"
                                      Command="{Binding PlacementTarget.DataContext.OpenTaskDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                            <MenuItem Header="打开输出目录"
                                      Command="{Binding PlacementTarget.DataContext.OpenTaskOutputDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

            

                            <MenuItem Header="复制文件路径"
                                      Command="{Binding PlacementTarget.DataContext.CopyTaskPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                            <MenuItem Header="复制错误信息"
                                      Command="{Binding PlacementTarget.DataContext.CopyTaskErrorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                            <MenuItem Header="复制任务信息"
                                      Command="{Binding PlacementTarget.DataContext.CopyTaskInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

            

                            <MenuItem Header="重新扫描此文件"
                                      Command="{Binding PlacementTarget.DataContext.RescanTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                            <MenuItem Header="智能修正此文件后缀"
                                      Click="SmartRenameCurrentTaskMenuItem_Click" />

            

                            <MenuItem Header="从列表移除"
                                      Command="{Binding PlacementTarget.DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                            <MenuItem Header="查看任务详情"
                                      Click="TaskDetailMenuItem_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="选择"
                                                Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="60" />

                        <DataGridTextColumn Header="序号"
                                            Binding="{Binding Index}"
                                            Width="60"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="文件名"
                                            Binding="{Binding FileName}"
                                            Width="180"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="完整路径"
                                            Binding="{Binding CurrentPath}"
                                            Width="360"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="当前后缀"
                                            Binding="{Binding CurrentExtension}"
                                            Width="90"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="检测格式"
                                            Binding="{Binding DetectedFormat}"
                                            Width="90"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="建议后缀"
                                            Binding="{Binding SuggestedExtension}"
                                            Width="90"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="后缀状态"
                                            Binding="{Binding ExtensionStatus}"
                                            Width="150"
                                            IsReadOnly="True" />

                        <!-- 分卷情况：一组分卷只占一行，这里说明有几卷、缺不缺（AGENTS.md §9.3）。 -->
                        <DataGridTextColumn Header="分卷"
                                            Binding="{Binding VolumeInfoText}"
                                            Width="200"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="密码状态"
                                            Binding="{Binding PasswordStatus}"
                                            Width="110"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="输出目录"
                                            Binding="{Binding OutputPath}"
                                            Width="260"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="操作"
                                            Binding="{Binding Operation}"
                                            Width="80"
                                            IsReadOnly="True" />

                        <DataGridTemplateColumn Header="状态"
                                                Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="进度"
                                            Binding="{Binding ProgressText}"
                                            Width="90"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="错误信息"
                                            Binding="{Binding ErrorMessage}"
                                            Width="260"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="耗时"
                                            Binding="{Binding ElapsedText}"
                                            Width="90"
                                            IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 汇总区 -->
            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,8,0,0">
                <WrapPanel VerticalAlignment="Center">

                    <TextBlock Text="汇总："
                               FontWeight="Bold"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="总数："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.TotalCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="选中："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.SelectedCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="已识别："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.RecognizedCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="格式未知："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.UnknownCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="改名成功："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.RenameSuccessCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="改名失败："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.RenameFailedCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="测试通过："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.TestSuccessCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="测试失败："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.TestFailedCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="解压成功："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.ExtractSuccessCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="解压失败："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.ExtractFailedCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="密码错误："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.PasswordErrorCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="文件损坏："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.CorruptedCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="已跳过："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.SkippedCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="已取消："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.CancelledCount}"
                               FontWeight="Bold"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <TextBlock Text="其他失败："
                               Foreground="#666666"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Summary.OtherFailedCount}"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </WrapPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
