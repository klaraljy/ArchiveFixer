<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ArchiveFixer</AssemblyName>
    <RootNamespace>ArchiveFixer</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
    <Version>11.0.0</Version>
    <Authors>ArchiveFixer</Authors>
    <Company>ArchiveFixer</Company>
    <Product>ArchiveFixer</Product>
    <Description>批量压缩包识别、伪装后缀修正、密码管理与 7-Zip 解压工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="tools\7zip\7z.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tools\7zip\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
