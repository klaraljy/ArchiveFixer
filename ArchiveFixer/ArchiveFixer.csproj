<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ArchiveFixer</AssemblyName>
    <RootNamespace>ArchiveFixer</RootNamespace>
    <ApplicationIcon>Assets\ArchiveFixer.ico</ApplicationIcon>
    <Version>11.0.0</Version>
    <Authors>ArchiveFixer</Authors>
    <Company>ArchiveFixer</Company>
    <Product>ArchiveFixer</Product>
    <Description>批量压缩包识别、伪装后缀修正、密码管理与 7-Zip 解压工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="tools\7zip\7z.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tools\7zip\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
        许可文本必须随分发（7-Zip 主体 LGPL + unRAR 限制条款）。
        2026-09-22 升级到 26.03 时才补上 —— 之前内置了 7z 却没有许可文本，是分发合规缺口。
    -->
    <None Include="tools\7zip\License.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tools\7zip\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
      RAR 侧的第二引擎：RARLAB 官方的免费件 UnRAR.exe（+ 其许可文本）。
      照 tools\7zip\ 的同一套写法复制到输出目录，不新造机制。
      来源、版本、SHA256 与许可要点见 tools\unrar\README.md（AGENTS.md §3.1）。
  -->
  <ItemGroup>
    <None Include="tools\unrar\UnRAR.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tools\unrar\license.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
