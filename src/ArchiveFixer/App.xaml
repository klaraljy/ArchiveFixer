<Application x:Class="ArchiveFixer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ArchiveFixer.Converters"
             xmlns:helpers="clr-namespace:ArchiveFixer.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!--
            ============================================================
            统一视觉资源（UI v2）
            ============================================================
            为什么所有颜色/字号/间距都收在这一个文件里：
            以前 5 个窗口各自定义一套私有色板，同一个"灰"有 #DDDDDD / #D1D5DB 两个值、
            文字灰有 5 档（#222/#333/#555/#666/#777），主窗口的隐式样式还会整个顶掉
            App.xaml 的同类型样式（WPF 隐式样式不合并）——于是"同一个按钮在两个窗口手感不同"。
            现在：颜色只在这里定义一次，窗口只引用；窗口不再自带色板。
        -->

        <!-- ============ 颜色 / 画刷 ============ -->

        <!-- 底与面板 -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F4F6" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#FAFBFC" />
        <SolidColorBrush x:Key="PanelSunkenBrush" Color="#F6F7F9" />
        <SolidColorBrush x:Key="GroupHeaderBackgroundBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D8DCE3" />
        <SolidColorBrush x:Key="PanelBorderStrongBrush" Color="#BFC6D1" />
        <SolidColorBrush x:Key="DividerBrush" Color="#E5E8ED" />

        <!-- 文字（收敛到 4 档，不再有 5 档灰） -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2430" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A5160" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="TextHintBrush" Color="#8A93A3" />
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

        <!-- 主色 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E8F1FE" />
        <SolidColorBrush x:Key="PrimarySoftHoverBrush" Color="#D6E6FD" />
        <SolidColorBrush x:Key="PrimarySoftPressedBrush" Color="#C3DAFB" />

        <!-- 危险 / 警告 / 成功 -->
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="DangerDarkBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#F3BDBD" />
        <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C" />

        <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF7E8" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#F0C36D" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#92400E" />

        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EAF7EE" />
        <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7DCB8" />
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#166534" />

        <SolidColorBrush x:Key="InfoSoftBrush" Color="#EAF2FE" />
        <SolidColorBrush x:Key="InfoBorderBrush" Color="#BBD3F8" />
        <SolidColorBrush x:Key="InfoTextBrush" Color="#1D4ED8" />

        <!--
            批末汇总框的三档配色（用户 2026-09-29："最后的总结也要分颜色，一般情况下是蓝白字黑，
            加上两种就是橙白字黑和红白字黑"）= 底色三档 + 白字 + 黑框。
            ⛔ 这三条画刷只由 BatchSummarySeverity 选中（Views\AppDialogWindow.ApplySummarySeverity），
            别处不许按"这批像不像成功"自己挑颜色。
        -->
        <SolidColorBrush x:Key="SummarySuccessBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="SummaryPartialBrush" Color="#EA580C" />
        <SolidColorBrush x:Key="SummaryFailedBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="SummaryBorderBrush" Color="#111827" />

        <!-- 行状态（DataGrid 悬停 / 选中 / 禁用） -->
        <SolidColorBrush x:Key="RowHoverBrush" Color="#F1F5FD" />
        <SolidColorBrush x:Key="RowSelectedBrush" Color="#DCE9FB" />
        <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#F1F2F4" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#A3A9B5" />
        <SolidColorBrush x:Key="OverlayHoverBrush" Color="#12000000" />
        <SolidColorBrush x:Key="OverlayPressedBrush" Color="#24000000" />

        <!-- ============ 字号 / 间距 / 圆角 ============ -->

        <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI, Segoe UI, Arial</FontFamily>
        <FontFamily x:Key="MonoFontFamily">Consolas, Microsoft YaHei UI</FontFamily>

        <!--
            字号层级（4 档，写在各文字样式里，不再散落到窗口）：
            18 页面标题 / 14.5 分组标题 / 13 正文与按钮 / 11.5 说明与表头
        -->

        <Thickness x:Key="CardPadding">12</Thickness>
        <Thickness x:Key="CardMargin">0,0,0,8</Thickness>
        <Thickness x:Key="BarPadding">10,8</Thickness>
        <Thickness x:Key="BannerPadding">10,8</Thickness>
        <Thickness x:Key="InlineGap">0,0,8,0</Thickness>

        <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="CardCornerRadiusTop">6,6,0,0</CornerRadius>
        <CornerRadius x:Key="CardCornerRadiusBottom">0,0,6,6</CornerRadius>
        <CornerRadius x:Key="BadgeCornerRadius">11</CornerRadius>

        <!-- ============ Converter ============ -->

        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- 单选组（RadioButton ↔ 枚举）用；见 Helpers\UiConverters.cs -->
        <helpers:EnumOptionConverter x:Key="EnumOptionConverter" />
        <!-- 输出位置摘要（两个布尔 + 自定义路径 → 一句人话） -->
        <helpers:OutputPlacementSummaryConverter x:Key="OutputPlacementSummaryConverter" />
        <!-- 改名冲突策略的中文显示（模型里存的是 AutoRename 这类枚举名） -->
        <helpers:ConflictActionTextConverter x:Key="ConflictActionTextConverter" />
        <!-- 布尔 → 固定文案（「未写回」这类小标记；文案仍从 StatusText 取，见 PasswordListWindow） -->
        <helpers:BoolToTextConverter x:Key="BoolToTextConverter" />

        <!-- ============ 文字样式 ============ -->

        <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 说明/引导文字：所有"点哪里、会怎样"的句子都用这一档 -->
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="StatLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MonoTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <!-- ============ 卡片 / 提示条 ============ -->

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        </Style>

        <!-- 窗口内的醒目提示条：导入结果、解析警告、删除警告都用这一类 -->
        <Style x:Key="InfoBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource InfoBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Padding" Value="{StaticResource BannerPadding}" />
        </Style>

        <Style x:Key="SuccessBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Padding" Value="{StaticResource BannerPadding}" />
        </Style>

        <Style x:Key="WarningBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Padding" Value="{StaticResource BannerPadding}" />
        </Style>

        <Style x:Key="ErrorBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
            <Setter Property="Padding" Value="{StaticResource BannerPadding}" />
        </Style>

        <Style x:Key="BannerTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="{StaticResource DividerBrush}" />
            <Setter Property="Margin" Value="10,0" />
        </Style>

        <!-- ============ 窗口基线 ============ -->

        <Style x:Key="AppWindowStyle" TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <!-- ============ 按钮 ============ -->

        <!--
            自绘按钮模板：只有一套（以前主窗口自己定义了一份隐式样式，
            把 App.xaml 里那份整个顶掉，于是主窗口按钮没有手型光标、对话框有）。
            悬停/按下用一层半透明覆盖层实现 —— 这样同一套模板对"浅色按钮"和
            "实心主色按钮"都成立，不必给每种颜色各写一份模板。
        -->
        <Style x:Key="AppButtonBaseStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True" />

                            <!-- 悬停/按下的统一覆盖层：与底色无关 -->
                            <Border x:Name="Overlay"
                                    Background="{StaticResource OverlayHoverBrush}"
                                    CornerRadius="4"
                                    Opacity="0"
                                    SnapsToDevicePixels="True" />

                            <ContentPresenter x:Name="Cp"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource OverlayPressedBrush}" />
                            </Trigger>

                            <!-- 焦点态：换边框色而不是加粗，避免布局跳动 -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <!--
                                    禁用的按钮**不许再显示 hover**（用户 2026-09-29："鼠标放上去还是有显示的反应
                                    而且鼠标的图案也会变"）。光标那一条原来就有，但悬停覆盖层漏了：
                                    `IsMouseOver` 在 `IsEnabled=false` 的元素上照样为 true，两个触发器各改各的属性，
                                    于是灰底上仍然浮着一层 hover 高亮 —— 看起来就像"这颗还是能点的"。
                                    这里把它压回 0（触发器顺序也在起作用：这一条排在 IsMouseOver / IsPressed 之后）。
                                -->
                                <Setter TargetName="Overlay" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 默认按钮：所有没写样式的 Button 都长这样（以前只有 App.xaml 这一份，现在也是唯一一份） -->
        <Style TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="16,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="16,4" />
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerDarkBrush}" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource PanelSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <!-- 工具按钮：工具栏/表格上方的小按钮，不抢主按钮的视觉 -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Background" Value="{StaticResource PanelSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <!-- 危险但次要的操作（清空、删除全部）：描边警示，不用实心红抢主按钮 -->
        <Style x:Key="DangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
        </Style>

        <!-- 链接式按钮：关闭提示条之类 -->
        <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- ============ 输入控件 ============ -->

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TextHintBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,12,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,12,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 四选一/长文案单选项：整行可点，选中时整块高亮 -->
        <Style x:Key="OptionRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 分组框 ============ -->

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="{StaticResource CardMargin}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 组标题：独立一行 + 底色，和正文拉开层级 -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource GroupHeaderBackgroundBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="{StaticResource CardCornerRadiusTop}"
                                        Padding="12,7">
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.FontSize="14.5"
                                                      TextBlock.FontWeight="SemiBold"
                                                      TextBlock.Foreground="{StaticResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center" />
                                </Border>

                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 表格 ============ -->

        <Style x:Key="AppDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelSunkenBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="0,0,1,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="0" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="{StaticResource PanelBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource AppDataGridColumnHeaderStyle}" />
            <Setter Property="CellStyle" Value="{StaticResource AppDataGridCellStyle}" />
            <Setter Property="RowStyle" Value="{StaticResource AppDataGridRowStyle}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="EnableRowVirtualization" Value="True" />
        </Style>

        <!-- ============ 日志 / 列表 ============ -->

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 主界面选项卡（用户 2026-09-24 第 11 条） ============ -->

        <!--
            选项卡条是主界面的"主目录"，所以它必须自己有一套自绘样式：
            默认的 Aero2 标签页在浅灰底上是一块立体凸起，与程序里其余控件（扁平、细边框）拼在一起很显乱。
            选中态用主色下划线 + 面板底色，未选中态保持透明 —— 一眼能看出"现在在哪一页"。
            ⚠ 模板里每个 TemplateBinding 都必须留着：去掉 ContentPresenter 的 ContentSource="Header"
              选项卡就变成空白，这是这类模板最常见的一次性错误。
        -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="HeaderContent"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource PanelBrush}" />
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource OverlayHoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- 拖动分隔条：细，但要有可抓的宽度（太细会拖不住）。 -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{StaticResource DividerBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- ============ 其它 ============ -->

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="MaxWidth" Value="520" />
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource DividerBrush}" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <!-- 只读、可选中复制的正文（对话框正文、详情里的路径都用它） -->
        <Style x:Key="SelectableBodyTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Style.Triggers>
                <!-- 只做"悬停提示可复制"，不给焦点态底色：
                     对话框一打开焦点就在正文上，加底色会看起来像一个输入框。 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PanelSunkenBrush}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 代码/日志只读框 -->
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Background" Value="{StaticResource PanelSunkenBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="8" />
        </Style>

    </Application.Resources>
</Application>
