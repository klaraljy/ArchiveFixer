<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ArchiveFixer</AssemblyName>
    <RootNamespace>ArchiveFixer</RootNamespace>
    <ApplicationIcon>Assets\ArchiveFixer.ico</ApplicationIcon>
    <Version>11.0.0</Version>
    <Authors>ArchiveFixer</Authors>
    <Company>ArchiveFixer</Company>
    <Product>ArchiveFixer</Product>
    <Description>批量压缩包识别、伪装后缀修正、密码管理与 7-Zip 解压工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="tools\7zip\7z.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tools\7zip\7z.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
        许可文本必须随分发（7-Zip 主体 LGPL + unRAR 限制条款）。
        2026-09-22 升级到 26.03 时才补上 —— 之前内置了 7z 却没有许可文本，是分发合规缺口。
    -->
    <None Include="tools\7zip\License.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tools\7zip\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
      RAR 侧的第二引擎：RARLAB 官方的免费件 UnRAR.exe（+ 其许可文本）。
      照 tools\7zip\ 的同一套写法复制到输出目录，不新造机制。
      来源、版本、SHA256 与许可要点见 tools\unrar\README.md（AGENTS.md §3.1）。
  -->
  <ItemGroup>
    <None Include="tools\unrar\UnRAR.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="tools\unrar\license.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
      面向用户的四份文档跟着程序一起复制到输出目录的 docs\ 下（用户 2026-09-27 真机：
      "我选中最上端的帮助点击提示显示路径错误" —— 绿色目录 E:\ArchiveFixer\ 里根本没有 docs\，
      而帮助菜单要按 <程序目录>\docs\使用说明.md 去找）。

      ⛔ 只拷这四份"给用户看的"，不拷开发文档（需求书 / 需求变更 / AGENTS 那一类不该随分发出去）。
      路径用 Link 固定成 docs\<名字>，与仓库里的相对位置一致 —— 帮助菜单与 scripts\package.ps1
      读的都是同一个相对路径。
  -->
  <ItemGroup>
    <None Include="..\..\docs\使用说明.md" Link="docs\使用说明.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\docs\功能一览.md" Link="docs\功能一览.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\docs\设置项.md" Link="docs\设置项.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\docs\人工测试清单.md" Link="docs\人工测试清单.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
