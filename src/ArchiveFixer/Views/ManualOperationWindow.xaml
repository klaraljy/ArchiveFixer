<Window x:Class="ArchiveFixer.Views.ManualOperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ArchiveFixer.Models"
        Style="{StaticResource AppWindowStyle}"
        Title="手动操作"
        Width="1200"
        Height="640"
        MinWidth="1080"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ManualActionButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="ManualDangerActionButton" TargetType="Button" BasedOn="{StaticResource DangerOutlineButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 当前操作对象：只有一个任务，没有复选框 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="手动操作"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="{Binding SelectedTask.LogName, TargetNullValue=未选中任务}"
                           Style="{StaticResource CardTitleTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="620"
                           ToolTip="{Binding SelectedTask.CurrentPath}" />
                <TextBlock Text="{Binding SelectedTask.StatusDisplayText}"
                           Style="{StaticResource HintTextStyle}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding SelectedTask.ProgressDetail}"
                       Style="{StaticResource HintTextStyle}"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding ManualGuideText}"
                       Style="{StaticResource HintTextStyle}"
                       Margin="0,4,0,0" />
            <TextBlock Text="操作对象固定为当前选中的这一行；下面目录只用于查看分布，不在这里勾选或操作。"
                       Style="{StaticResource HintTextStyle}"
                       Margin="0,2,0,0" />
        </StackPanel>

        <!-- 所有手动操作集中在第一行 -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Padding="8,6"
                Margin="0,10,0,8">
            <WrapPanel x:Name="ManualActionBar" Orientation="Horizontal">
                <Button Content="看内容" Style="{StaticResource ManualActionButton}" ToolTip="只列当前任务的目录，不解压、不写盘。" Command="{Binding InspectCurrentTaskCommand}" />
                <Button Content="试密码" Style="{StaticResource ManualActionButton}" ToolTip="逐个候选问引擎，只显示候选序号。" Command="{Binding TryPasswordsForCurrentTaskCommand}" />
                <Button Content="源目录" Style="{StaticResource ManualActionButton}" ToolTip="在资源管理器中打开当前源包所在目录。" Command="{Binding OpenCurrentSourceDirectoryCommand}" />
                <Button Content="复制路径" Style="{StaticResource ManualActionButton}" ToolTip="复制当前同组文件路径，便于定位缺片。" Command="{Binding CopyCurrentVolumeGroupPathsCommand}" />
                <Button Content="重扫" Style="{StaticResource ManualActionButton}" ToolTip="重新识别当前任务的格式、加密状态与分卷信息。" Command="{Binding RescanTaskCommand}" CommandParameter="{Binding SelectedTask}" />
                <Button Content="找同组" Style="{StaticResource ManualActionButton}" ToolTip="按基名在入口包目录及输出目录查找其他分卷；只提示，不移动。" Command="{Binding FindVolumeSiblingsCommand}" />

                <Button Content="修分卷名" Style="{StaticResource ManualActionButton}" ToolTip="{x:Static models:StatusText.VolumeRepairButtonToolTip}" Command="{Binding RepairVolumeNameCurrentTaskCommand}" />
                <Button Content="智能修正" Style="{StaticResource ManualActionButton}" ToolTip="按识别结果修正当前任务后缀，先弹出预览。" Command="{Binding SmartRenameCurrentTaskCommand}" />
                <Button Content="改名" Style="{StaticResource ManualActionButton}" ToolTip="自定义替换、添加或删除后缀，先出预览。" Command="{Binding ChangeNameCurrentTaskCommand}" />

                <Button Content="只解压" Style="{StaticResource ManualActionButton}" FontWeight="SemiBold" ToolTip="只解当前任务这一层，不自动续解。" Command="{Binding StartExtractCurrentTaskCommand}" />
                <Button Content="解压到当前" Style="{StaticResource ManualActionButton}" ToolTip="{x:Static models:StatusText.ExtractIntoSourceFolderToolTip}" Command="{Binding ExtractIntoSourceFolderCurrentTaskCommand}" />
                <Button Content="下一层" Style="{StaticResource ManualActionButton}" ToolTip="把当前输出目录加入任务列表，供手动逐层继续；不会自动递归。" Command="{Binding AddCurrentOutputFolderToTasksCommand}" />

                <Button Content="回收站" Style="{StaticResource ManualActionButton}" ToolTip="预览并把当前任务产物移入回收站。" Command="{Binding RecycleCurrentTaskArtifactsCommand}" />
                <Button Content="彻底删除" Style="{StaticResource ManualDangerActionButton}" ToolTip="预览并彻底删除当前任务产物，不可恢复。" Command="{Binding CleanCurrentTaskArtifactsCommand}" />
                <Button Content="空文件夹" Style="{StaticResource ManualDangerActionButton}" ToolTip="预览并清理当前任务输出根下的空目录。" Command="{Binding CleanCurrentTaskEmptyFoldersCommand}" />
            </WrapPanel>
        </Border>

        <!-- 目录分布 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ManualDistributionTitle}"
                           Style="{StaticResource CardTitleTextStyle}" />
                <TextBlock Text="{Binding ManualDistributionPath}"
                           Style="{StaticResource HintTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ManualDistributionPath}" />
                <TextBlock Text="{Binding ManualDistributionEmptyText}"
                           Foreground="{StaticResource WarningTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />

                <Expander Header="{Binding ManualVolumeSearchText}"
                          Margin="0,8,0,0"
                          IsExpanded="True"
                          MaxHeight="110">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ManualVolumeCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullPath}"
                                               Style="{StaticResource HintTextStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FullPath}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="查找同组"
                        MinWidth="104"
                        Command="{Binding FindVolumeSiblingsCommand}" />
                <Button Content="打开输出目录"
                        MinWidth="104"
                        Margin="0,6,0,0"
                        Command="{Binding OpenCurrentTaskOutputDirectoryCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" Margin="0,8,0,8">
            <DataGrid ItemsSource="{Binding ManualDistributionEntries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="72" />
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100" />
                    <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedText}" Width="170" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0">
            <Button Content="关闭"
                    HorizontalAlignment="Right"
                    MinWidth="92"
                    IsCancel="True"
                    Click="CloseButton_Click" />
        </Border>
    </Grid>
</Window>
