<Window x:Class="ArchiveFixer.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="日志"
        Width="1000"
        Height="620"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <!--
        独立日志窗口（用户 2026-09-24 第 18 条：日志区太小）。
        它与主界面①页的日志区是**同一个集合**（都绑 MainViewModel.Logs），
        所以两边永远一致；窗口开着时主界面照样能跑批。
        DataContext 由打开它的那一处（TaskTab / 视图菜单）设成主窗口的 MainViewModel。
    -->

    <DockPanel Margin="12">

        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock Text="日志"
                           Style="{StaticResource PageTitleTextStyle}"
                           VerticalAlignment="Center" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="复制失败列表"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding CopyFailedListCommand}" />

                    <Button Content="导出失败清单"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="8,0,0,0"
                            Command="{Binding ExportFailedListCommand}" />

                    <Button Content="打开日志目录"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="8,0,0,0"
                            Command="{Binding OpenLogDirectoryCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="4">
            <ListBox x:Name="LogList"
                     ItemsSource="{Binding Logs}"
                     BorderThickness="0"
                     FontSize="12.5"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 按级别上色（与①页日志区同一份口径：红 ERROR / 黄 WARN / 黑 INFO）。 -->
                        <TextBlock TextWrapping="NoWrap"
                                   Foreground="{Binding Level, Converter={StaticResource StatusToBrushConverter}}">
                            <!-- Run.Text 默认 TwoWay，绑只读属性必须显式 OneWay -->
                            <Run Text="{Binding TimeText, Mode=OneWay, StringFormat=[{0}]}" />
                            <Run Text=" [" />
                            <Run Text="{Binding Level, Mode=OneWay}" />
                            <Run Text="] " />
                            <Run Text="{Binding Message, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
