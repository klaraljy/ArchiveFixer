<Window x:Class="ArchiveFixer.Views.RenamePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="改名预览"
        Width="1100"
        Height="600"
        MinWidth="920"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">

    <!--
        改名预览（UI v3，2026-09-26 审计后瘦身）。
        v2 是 1330×680、10 列：固定列宽合计 1096px，「新路径」再吃掉一条星号列 —— 窗口改不小，
        而真正要看的**后缀**偏偏被截掉（「原文件名」用 CharacterEllipsis = 尾省略）。

        v3 砍掉三处冗余、把宽度花在该花的地方：
        · 「检测格式」并进「操作」列（"按真实格式修正（ZIP）"）—— 5 种操作里只有这一种用得上它；
        · 「冲突处理」+「冲突选择（询问档）」合成一列「冲突」（能选的行给下拉框，其余给档位文字）；
        · 「新路径」整列删掉（同目录改名时它就是 原目录+新文件名，纯重复），完整新路径进 ToolTip；
        · 「状态」列里带一行错误原因（原来单开一列「错误信息」）。
        · 两个名字列改用**中间省略**（FileNameMiddleEllipsis）：尾部后缀永远看得见。
    -->

    <DockPanel Margin="12">

        <!-- ============ 标题 + 统计 ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="请确认以下改名操作" Style="{StaticResource PageTitleTextStyle}" />

                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"
                               Text="只有勾选、且状态为「可改名」的行会被改；名字太长时中间用 … 省略（后缀照旧看得到），悬停可看全名。" />

                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,3,0,0"
                               Text="「新文件名」那一格可以直接双击改；撞名的行在「冲突」列里逐条选（不选 = 自动重命名，绝不覆盖）。" />
                </StackPanel>

                <WrapPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,2,0,0">
                    <Border Style="{StaticResource CardStyle}" Padding="10,5" Margin="0,0,6,0"
                            Background="{StaticResource PanelSunkenBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="总数" Style="{StaticResource StatLabelTextStyle}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValueTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="10,5" Margin="0,0,6,0"
                            Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="已选" Style="{StaticResource StatLabelTextStyle}" Margin="0,0,5,0"
                                       Foreground="{StaticResource InfoTextBrush}" />
                            <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource StatValueTextStyle}"
                                       Foreground="{StaticResource InfoTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="10,5" Margin="0,0,6,0"
                            Background="{StaticResource SuccessSoftBrush}" BorderBrush="{StaticResource SuccessBorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="可改名" Style="{StaticResource StatLabelTextStyle}" Margin="0,0,5,0"
                                       Foreground="{StaticResource SuccessTextBrush}" />
                            <TextBlock Text="{Binding CanRenameCount}" Style="{StaticResource StatValueTextStyle}"
                                       Foreground="{StaticResource SuccessTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="10,5" Margin="0,0,6,0"
                            Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="冲突" Style="{StaticResource StatLabelTextStyle}" Margin="0,0,5,0"
                                       Foreground="{StaticResource WarningTextBrush}" />
                            <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource StatValueTextStyle}"
                                       Foreground="{StaticResource WarningTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="10,5"
                            Background="{StaticResource PanelSunkenBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="跳过" Style="{StaticResource StatLabelTextStyle}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding SkipCount}" Style="{StaticResource StatValueTextStyle}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ============ 底部按钮区 ============ -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
            <DockPanel>
                <!-- 选择辅助：次要操作，靠左、工具按钮样式 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="全选"
                            MinWidth="64"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0"
                            Command="{Binding SelectAllCommand}" />

                    <Button Content="全不选"
                            MinWidth="72"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,6,0"
                            Command="{Binding SelectNoneCommand}" />

                    <Button Content="反选"
                            MinWidth="64"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding InvertSelectionCommand}" />

                    <!--
                        「询问」档的批量出口（等价 WinRAR 覆盖询问里的「全部重命名」那一档）：
                        只在**还有待选的冲突**时出现 —— 不是询问档、冲突都选完了的时候它按下去只会
                        回一句"没有需要选择的同名冲突"，白占位置（2026-09-26 审计）。
                    -->
                    <Button Content="冲突全部自动重命名"
                            MinWidth="150"
                            Margin="8,0,0,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="把所有「同名冲突」一次设为自动重命名：产物落成 名字(1)，已有文件一个字节都不动。"
                            Visibility="{Binding HasPendingConflictChoices, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="ConflictAllAutoRenameButton_Click" />
                </StackPanel>

                <!-- 主操作在最右：确认改名（主色）> 取消 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            MinWidth="88"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Command="{Binding CancelCommand}" />

                    <Button Content="确认改名"
                            MinWidth="112"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding HasExecutableItems}"
                            ToolTip="对勾选且可改名的项目执行改名"
                            Click="ConfirmButton_Click" />
                </StackPanel>

                <TextBlock Text="{Binding Message}"
                           Style="{StaticResource HintTextStyle}"
                           VerticalAlignment="Center"
                           Margin="12,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Message}" />
            </DockPanel>
        </Border>

        <!-- ============ 预览表格 ============ -->
        <Border Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <DataGrid x:Name="RenamePreviewGrid"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          IsReadOnly="False"
                          SelectionMode="Extended"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Margin="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
                            <Style.Triggers>
                                <!-- 不改名的行整行压暗：一眼看出这次会动哪些 -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- 模板列：DataGridCheckBoxColumn 要点两次才勾得上 -->
                        <DataGridTemplateColumn Header="选择" Width="52">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              Margin="0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--
                            「原文件名」：中间省略、**后缀一定看得见**（FileNameMiddleEllipsis）。
                            以前是 150px + CharacterEllipsis（尾省略）—— 长名字第一个没的就是后缀，
                            而这正是用户唯一要对比的东西。完整路径在 ToolTip 里。
                        -->
                        <DataGridTemplateColumn Header="原文件名" Width="260" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OriginalFileNameDisplay}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding OriginalPath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 操作（智能修正这一类把检测格式并进来，例如"按真实格式修正（ZIP）"） -->
                        <DataGridTextColumn Header="操作"
                                            Binding="{Binding Operation}"
                                            Width="120"
                                            IsReadOnly="True" />

                        <!--
                            「新文件名」：可编辑（双击进编辑态，编辑时看到的是**全名**）。
                            非编辑态走中间省略，完整落点路径在 ToolTip 里 —— 以前这一列既不省略也不给提示，
                            长名字直接被格子切断，连"…"都没有。
                        -->
                        <DataGridTemplateColumn Header="新文件名（可编辑）" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NewFileNameDisplay}"
                                               VerticalAlignment="Center"
                                               Margin="4,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding NewPath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding NewFileName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="{Binding NewPath}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!--
                            「冲突」= 原来的「冲突处理」+「冲突选择（询问档）」两列合一。
                            撞名且档位是「询问」的行给下拉框；其余行给档位文字（只读）。
                            没选的行用警示底色标出来 —— 不选不放行（见窗口 code-behind 的 pending 拦截）。
                        -->
                        <DataGridTemplateColumn Header="冲突" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding ConflictAction, Converter={StaticResource ConflictActionTextConverter}}"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ConflictAction, Converter={StaticResource ConflictActionTextConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsConflictChoice}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ComboBox SelectedValue="{Binding ConflictChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag"
                                                  Margin="0"
                                                  ToolTip="目标文件已存在 —— 选怎么办。不选 = 自动重命名（不会覆盖）。">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NeedsConflictChoice}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>

                                            <ComboBoxItem Content="自动重命名（默认，不覆盖）" Tag="AutoRename" />
                                            <ComboBoxItem Content="跳过（已有文件不动）" Tag="Skip" />
                                            <ComboBoxItem Content="覆盖（先移开旧文件）" Tag="Overwrite" />
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 状态（+ 一行原因）：原来「状态」与「错误信息」是两列，合成一列省 130px -->
                        <DataGridTemplateColumn Header="状态" Width="190" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2">
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />

                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ErrorMessage}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <!-- 有原因才占一行（多数行是干净的） -->
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 空状态 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="没有需要改名的项目"
                               Style="{StaticResource SectionTitleTextStyle}"
                               HorizontalAlignment="Center" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,6,0,0"
                               TextAlignment="Center"
                               MaxWidth="460"
                               Text="当前选中的任务后缀都正常，或还没有扫描出可改名的项目。可以先在主界面点「添加文件 / 添加文件夹」并扫描后再来。" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
