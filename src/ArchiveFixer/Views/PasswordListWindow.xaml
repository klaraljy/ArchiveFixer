<Window x:Class="ArchiveFixer.Views.PasswordListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ArchiveFixer.ViewModels"
        xmlns:models="clr-namespace:ArchiveFixer.Models"
        Style="{StaticResource AppWindowStyle}"
        Title="密码列表管理"
        Width="900"
        Height="640"
        MinWidth="780"
        MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
        密码列表窗口（UI v2）。
        改之前：一张没有主次的表 + 一排 8 个等宽小按钮，导入结果只写在底部一行小字里。
        现在：
        · 顶部标题区写清"列表按本机加密保存（可关）、日志不记明文、列表顺序就是尝试顺序"；
        · 结果/警告走窗口内的提示条（按类别换色换图标），不再只写一行 Message；
        · 主操作（添加 / 导入 txt）在输入框右侧，危险操作（清空）用警示描边 + 二次确认；
        · 显示明文时提示条转成警告色，禁用行整行变灰 —— 状态都能直接看出来。
    -->

    <DockPanel Margin="12">

        <!-- ============ 标题区 ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="密码列表管理" Style="{StaticResource PageTitleTextStyle}" />

                    <!--
                        顶部这句必须与事实一致。
                        改之前写的是"密码只存在内存里" —— 那是 2026-09-24 之前的实话；
                        现在列表可以按本机 DPAPI（机器范围）加密落盘，界面上留着一句过期的话
                        比没有那句话更糟（用户会照着它做判断）。文案的唯一来源是 StatusText（§7）。
                    -->
                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.PasswordListPrivacyHint}" />

                    <!-- 当前列表：总数 / 启动时由记忆恢复的条数 / 记住的密码本本数 -->
                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,3,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding MemorySummary}" />
                </StackPanel>

                <!-- 统计：总数 / 启用数 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                    <Border Style="{StaticResource CardStyle}" Padding="12,6" Margin="0,0,8,0"
                            Background="{StaticResource PanelSunkenBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="总数" Style="{StaticResource StatLabelTextStyle}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValueTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="12,6"
                            Background="{StaticResource SuccessSoftBrush}"
                            BorderBrush="{StaticResource SuccessBorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="启用" Style="{StaticResource StatLabelTextStyle}" Margin="0,0,6,0"
                                       Foreground="{StaticResource SuccessTextBrush}" />
                            <TextBlock Text="{Binding EnabledCount}" Style="{StaticResource StatValueTextStyle}"
                                       Foreground="{StaticResource SuccessTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 提示条：导入结果 / 解析警告 / 状态变化 ============ -->
        <Border DockPanel.Dock="Top"
                Margin="0,0,0,8"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource InfoBannerStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoticeKind}" Value="Success">
                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NoticeKind}" Value="Warning">
                            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding NoticeKind}" Value="Error">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding NoticeGlyph}"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,10,0"
                           VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource InfoTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="Success">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="Warning">
                                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="Error">
                                    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="1"
                           Text="{Binding NoticeText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BannerTextStyle}">
                            <Setter Property="Foreground" Value="{StaticResource InfoTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="Success">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="Warning">
                                    <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NoticeKind}" Value="Error">
                                    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="2"
                        Content="关闭提示"
                        Style="{StaticResource LinkButtonStyle}"
                        VerticalAlignment="Top"
                        Margin="12,0,0,0"
                        Command="{Binding DismissNoticeCommand}" />
            </Grid>
        </Border>

        <!-- ============ 添加 / 导入 ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="新密码"
                           Style="{StaticResource LabelTextStyle}"
                           Margin="0,0,8,0" />

                <TextBox Grid.Column="1"
                         Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="输入新密码。允许空格，不会自动 Trim；回车可直接添加。">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddPasswordCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="添加"
                            MinWidth="88"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            ToolTip="把上面输入的密码加到列表末尾（回车同效）"
                            Command="{Binding AddPasswordCommand}" />

                    <Button Content="导入 txt"
                            MinWidth="96"
                            ToolTip="从 txt 密码本导入：一行一个密码，# 开头是注释；导入后会记住这个文件"
                            Command="{Binding ImportPasswordsCommand}" />

                    <!--
                        写回密码本（用户 2026-09-24）。
                        手动添加的密码**只在本次运行内有效**（不落盘是红线），重启就没了 ——
                        要长期保留只能追加进用户自己那份密码本 txt。没有待写条目时按钮置灰。
                        文案一律从 StatusText 取（AGENTS.md §7），这里通过 x:Static 引常量。
                    -->
                    <Button Margin="8,0,0,0"
                            MinWidth="118"
                            Content="{x:Static models:StatusText.PasswordWriteBackButtonText}"
                            ToolTip="{x:Static models:StatusText.PasswordWriteBackButtonHint}"
                            Command="{Binding WriteBackPasswordsCommand}" />

                    <Border Style="{StaticResource DividerStyle}" Height="22" />

                    <!-- 显示/隐藏：文案随状态变，一眼能看出当前是哪种 -->
                    <Button Command="{Binding ToggleShowPasswordsCommand}"
                            MinWidth="104"
                            ToolTip="切换密码列的显示方式">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
                                <Setter Property="Content" Value="显示明文" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPasswords}" Value="True">
                                        <Setter Property="Content" Value="隐藏明文" />
                                        <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}" />
                                        <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 底部操作栏 ============ -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel>
                    <!-- 左：顺序（顺序就是尝试顺序）+ 批量启用/禁用 -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="上移"
                                MinWidth="64"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="0,0,6,0"
                                ToolTip="{x:Static models:StatusText.PasswordListMoveHint}"
                                Command="{Binding MoveUpCommand}" />

                        <Button Content="下移"
                                MinWidth="64"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding MoveDownCommand}" />

                        <Border Style="{StaticResource DividerStyle}" Height="22" />

                        <Button Content="启用全部"
                                MinWidth="80"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="0,0,6,0"
                                Command="{Binding EnableAllCommand}" />

                        <Button Content="禁用全部"
                                MinWidth="80"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding DisableAllCommand}" />
                    </StackPanel>

                    <!-- 右：删除（次要危险）/ 清空（危险 + 二次确认，靠左于关闭）/ 关闭 -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="删除选中"
                                MinWidth="88"
                                Style="{StaticResource DangerOutlineButtonStyle}"
                                Margin="0,0,8,0"
                                ToolTip="删除当前选中的那一条（会先确认）"
                                Command="{Binding RemovePasswordCommand}" />

                        <Button Content="清空"
                                MinWidth="72"
                                Style="{StaticResource DangerOutlineButtonStyle}"
                                Margin="0,0,12,0"
                                ToolTip="移除列表里的全部密码（会先确认，不可撤销）"
                                Command="{Binding ClearPasswordsCommand}" />

                        <Button Content="关闭"
                                MinWidth="88"
                                IsCancel="True"
                                Click="CloseButton_Click" />
                    </StackPanel>

                    <!-- 占位：让左右两组在窄窗口下也不重叠 -->
                    <Border />
                </DockPanel>

                <TextBlock Text="{Binding Message}"
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============ 密码表格 ============ -->
        <Border Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Passwords}"
                          SelectedItem="{Binding SelectedPassword, Mode=TwoWay}"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Margin="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">

                    <!-- 禁用行整行变灰：启用/禁用不需要另加一列状态文字也能看出来 -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- 用模板列而不是 DataGridCheckBoxColumn：后者要点两次才勾得上 -->
                        <DataGridTemplateColumn Header="启用" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              Margin="0"
                                              ToolTip="取消勾选即跳过这条密码（列表里仍然保留）" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--
                            列头必须与**真实顺序**一致（用户 2026-10-04 真机）：实际尝试顺序是
                            空密码 → 密码本命中 → 这张表，而表内按历史成功次数从多到少排。
                            文案从 StatusText 取（AGENTS.md §7），这里不另写一份。
                        -->
                        <DataGridTemplateColumn Header="{x:Static models:StatusText.PasswordListOrderHeader}" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- 隐藏时显示脱敏值 -->
                                        <TextBlock Text="{Binding MaskedValue}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.ShowPasswords, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 用户主动显示明文时才显示明文 -->
                                        <TextBlock Text="{Binding Value}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Value}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.ShowPasswords, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 长度：隐藏状态下也能区分两条不同的密码，且不泄露内容 -->
                        <DataGridTextColumn Header="长度"
                                            Binding="{Binding LengthText}"
                                            Width="72"
                                            IsReadOnly="True" />

                        <DataGridTextColumn Header="来源"
                                            Binding="{Binding Source}"
                                            Width="120"
                                            IsReadOnly="True" />

                        <!--
                            备注列：手动添加、还没写回密码本的条目在这里挂一个小标记。
                            为什么要有它：那些条目**只在本次运行内有效**，关掉程序就没了 ——
                            用户 2026-09-24 就是因为看不见这件事才以为"我加的密码不见了"。
                            标记的文案来自 StatusText（唯一来源），转换器只负责"true 才显示"。
                        -->
                        <DataGridTemplateColumn Header="备注（可编辑）" Width="*" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding ShowUnwrittenMarker, Converter={StaticResource BoolToTextConverter}, ConverterParameter={x:Static models:StatusText.PasswordWriteBackPendingHint}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Margin="0,0,6,0"
                                                Padding="5,1"
                                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                                Background="{StaticResource WarningSoftBrush}"
                                                BorderBrush="{StaticResource WarningBorderBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding ShowUnwrittenMarker, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Static models:StatusText.PasswordWriteBackPendingMarker}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource WarningTextBrush}" />
                                        </Border>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 空状态：不要给用户一张空白表格 -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="列表里还没有密码"
                               Style="{StaticResource SectionTitleTextStyle}"
                               HorizontalAlignment="Center" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,6,0,0"
                               TextAlignment="Center"
                               MaxWidth="420"
                               Text="在上面输入一条密码点「添加」，或用「导入 txt」加载密码本（一行一个；「名称:密码」这种映射式写法也认，命中名称的会优先尝试）。" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
