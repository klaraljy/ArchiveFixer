<Window x:Class="ArchiveFixer.Views.PackingConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindowStyle}"
        Title="打包 · 确认"
        Width="680"
        MaxHeight="820"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <!--
        ⑤ 打包的唯一确认窗。保持原来的两档选择，只把“内层 7z 分卷 / 外层一个文件”
        和最终落点说清楚；正文文案由 PackingConfirmRequest / PackingRunOptions 提供。
    -->

    <DockPanel Margin="0">

        <!-- ============ 顶部标题 ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PrimarySoftBrush}"
                Padding="18,16"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="打包 · 确认"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="看清最终落点，再开始打包。"
                               Style="{StaticResource HintTextStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#22FFFFFF"
                        CornerRadius="12"
                        Padding="10,5"
                        VerticalAlignment="Top">
                    <TextBlock Text="一次确认"
                               FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- ============ 底部按钮 ============ -->
        <Border DockPanel.Dock="Bottom"
                Style="{StaticResource CardStyle}"
                Margin="0,8,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="开始打包"
                        MinWidth="112"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="OnStart" />
                <Button Content="取消"
                        MinWidth="88"
                        Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="OnCancel" />
            </StackPanel>
        </Border>

        <!-- ============ 正文 ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="620"
                      Padding="0,0,6,0">
            <StackPanel>

                <!-- 本次打包摘要 -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,14"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="本次打包"
                                   Style="{StaticResource LabelTextStyle}" />

                        <Border Background="{StaticResource PanelSunkenBrush}"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,8,0,0">
                            <ItemsControl x:Name="HeadList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="19"
                                                   Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 最终落点 -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,14"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="最终压缩包落在"
                                   Style="{StaticResource LabelTextStyle}" />

                        <Border Background="{StaticResource PanelSunkenBrush}"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,6,0,0">
                            <TextBlock x:Name="PlacementText"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       LineHeight="19" />
                        </Border>

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   Text="落点是在⑤「打包」页上选的；这里只显示最终会落在哪。" />
                    </StackPanel>
                </Border>

                <!-- 源包处理 -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,14"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="源包处理"
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBlock x:Name="SourceExplanationText"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />

                        <RadioButton x:Name="SourceKeep"
                                     GroupName="PackSource"
                                     Margin="0,8,0,0"
                                     Content="保留源包（默认，一个字节都不动）"
                                     IsChecked="True"
                                     Checked="OnOptionsChanged" />

                        <RadioButton x:Name="SourceMove"
                                     GroupName="PackSource"
                                     Margin="0,6,0,0"
                                     Content="移入其余物（程序建一个以源名命名的文件夹，把源包搬进去）"
                                     Checked="OnOptionsChanged" />
                    </StackPanel>
                </Border>

                <!-- 其余物处理 -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,14"
                        Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="其余物（分卷文件）处理"
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBlock x:Name="RestExplanationText"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />

                        <RadioButton x:Name="RestDelete"
                                     GroupName="PackRest"
                                     Margin="0,8,0,0"
                                     Content="彻底删除（默认，不进回收站、不可恢复）"
                                     IsChecked="True"
                                     Checked="OnOptionsChanged" />

                        <RadioButton x:Name="RestRecycle"
                                     GroupName="PackRest"
                                     Margin="0,6,0,0"
                                     Content="移入回收站（可还原）"
                                     Checked="OnOptionsChanged" />

                        <RadioButton x:Name="RestKeep"
                                     GroupName="PackRest"
                                     Margin="0,6,0,0"
                                     Content="保留（方便自己检查分卷）"
                                     Checked="OnOptionsChanged" />
                    </StackPanel>
                </Border>

                <!-- 危险组合警告 -->
                <Border x:Name="DangerBox"
                        Style="{StaticResource WarningBannerStyle}"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="DangerText"
                               Style="{StaticResource BannerTextStyle}"
                               Foreground="{StaticResource DangerTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="19" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
