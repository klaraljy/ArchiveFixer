<Window x:Class="ArchiveFixer.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ArchiveFixer.Views"
        Style="{StaticResource AppWindowStyle}"
        Title="说明"
        Width="880"
        Height="720"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <!--
        「说明」窗（用户 2026-09-27："在选项卡那一行在设置右边弄一个说明…"）。
        ⚠ 2026-10-14：正文抽成共用面板 Views/HelpBodyPanel.xaml（与⑨「说明」页签同一份），
        这个窗口从此只负责窗框与那两颗按钮 —— ⛔ 文案不许在这里留第二份。
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:HelpBodyPanel Grid.Row="0" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="复制全部说明"
                    MinWidth="120"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="CopyAll_Click"
                    ToolTip="把这一份说明（含术语表）整段复制到剪贴板，方便贴给别人" />

            <Button Content="关闭"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Style="{StaticResource ToolbarButtonStyle}"
                    IsCancel="True"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
