<Window x:Class="ArchiveFixer.Views.OneClickOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ArchiveFixer.Models"
        Style="{StaticResource AppWindowStyle}"
        Title="一键处理 · 确认"
        Width="660"
        MaxHeight="800"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <!--
        一键处理的唯一确认框：先把「落点 / 源包 / 其余物」三件事放在一张摘要卡里，
        需要临时改才展开下面的折叠区。正文措辞来自调用方/StatusText；本文件只负责排版。
    -->

    <DockPanel Margin="0">

        <!-- ============ 标题区 ============ -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PrimarySoftBrush}"
                Padding="18,16"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="一键处理 · 确认"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="先看清这批会怎么跑，再开始处理。"
                               Style="{StaticResource HintTextStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#22FFFFFF"
                        CornerRadius="12"
                        Padding="10,5"
                        VerticalAlignment="Top">
                    <TextBlock Text="一次确认"
                               FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- ============ 正文摘要 ============ -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,8"
                Padding="16,14">
            <StackPanel>
                <TextBlock Text="内容物会生成在"
                           Style="{StaticResource HintTextStyle}" />

                <Border Background="{StaticResource PanelSunkenBrush}"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,4,0,12">
                    <TextBlock x:Name="DestinationText"
                               x:FieldModifier="public"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Text="{Binding DestinationEcho}" />
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelSunkenBrush}"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="源包"
                                       Style="{StaticResource HintTextStyle}" />
                            <TextBlock x:Name="SourceText"
                                       x:FieldModifier="public"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Text="{Binding SourceEcho}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{StaticResource PanelSunkenBrush}"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="其余物"
                                       Style="{StaticResource HintTextStyle}" />
                            <TextBlock x:Name="RestText"
                                       x:FieldModifier="public"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Text="{Binding RestEcho}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock x:Name="NestedCaveatText"
                           x:FieldModifier="public"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           FontSize="11.5"
                           Foreground="{StaticResource WarningTextBrush}"
                           Text="{x:Static models:StatusText.OneClickConfirmNestedCaveat}" />

                <Border x:Name="SpecialText"
                        x:FieldModifier="public"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="6"
                        Padding="10,7"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap"
                               Text="{Binding SpecificExtractionEcho}" />
                </Border>

                <Border x:Name="SpaceTightNotice"
                        x:FieldModifier="public"
                        Style="{StaticResource WarningBannerStyle}"
                        Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SpaceTightNoticeText"
                               x:FieldModifier="public"
                               Style="{StaticResource BannerTextStyle}"
                               Foreground="{StaticResource DangerTextBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding SpaceTightEcho}" />
                </Border>

                <TextBlock x:Name="NoticeText"
                           x:FieldModifier="public"
                           Style="{StaticResource HintTextStyle}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Text="{Binding NoticeEcho}" />
            </StackPanel>
        </Border>

        <!-- ============ 底部按钮区 ============ -->
        <Border DockPanel.Dock="Bottom"
                Style="{StaticResource CardStyle}"
                Margin="0,8,0,0"
                Padding="16,12">
            <StackPanel>
                <CheckBox x:Name="SuppressPanelBox"
                          x:FieldModifier="public"
                          Content="{x:Static models:StatusText.OneClickConfirmSuppressText}"
                          Checked="Option_Changed"
                          Unchecked="Option_Changed" />

                <DockPanel Margin="0,8,0,0">
                    <TextBlock x:Name="ValidationText"
                               x:FieldModifier="public"
                               Style="{StaticResource HintTextStyle}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton"
                                x:FieldModifier="public"
                                Content="取消"
                                MinWidth="88"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CancelButton_Click"
                                IsCancel="True" />

                        <Button x:Name="StartButton"
                                x:FieldModifier="public"
                                Content="开始处理"
                                MinWidth="118"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True"
                                Click="StartButton_Click" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ============ 要改才展开（默认收起） ============ -->
        <Expander Header="{x:Static models:StatusText.OneClickConfirmExpanderHeader}"
                  x:Name="TweakExpander"
                  x:FieldModifier="public"
                  IsExpanded="False"
                  Margin="0,4,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="420"
                          Padding="0,0,6,0">
                <StackPanel>

                    <!-- ==================== 本次落点（二选一） ==================== -->
                    <GroupBox Header="本次落点">
                        <StackPanel>
                            <RadioButton x:Name="PlacementPerArchiveOption"
                                         x:FieldModifier="public"
                                         GroupName="PanelPlacement"
                                         Checked="Placement_Checked">
                                <TextBlock Text="以包名命名的子文件夹（默认）" Style="{StaticResource BodyTextStyle}" />
                            </RadioButton>

                            <RadioButton x:Name="PlacementCustomPerArchiveOption"
                                         x:FieldModifier="public"
                                         GroupName="PanelPlacement"
                                         Margin="0,4,0,0"
                                         Checked="Placement_Checked">
                                <TextBlock Text="解压到指定位置，并建立同名子文件夹" Style="{StaticResource BodyTextStyle}" />
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>

                    <!-- ==================== 指定位置 ==================== -->
                    <GroupBox Header="指定位置">
                        <DockPanel>
                            <Button x:Name="BrowseButton"
                                    x:FieldModifier="public"
                                    DockPanel.Dock="Right"
                                    Content="浏览…"
                                    MinWidth="78"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseButton_Click" />

                            <TextBox x:Name="CustomRootBox"
                                     x:FieldModifier="public"
                                     TextChanged="CustomRootBox_TextChanged"
                                     ToolTip="只对上面「解压到指定位置」那一档生效" />
                        </DockPanel>
                    </GroupBox>

                    <!-- ==================== 源包操作 ==================== -->
                    <GroupBox Header="1 源包操作（成功之后，源包放哪）">
                        <StackPanel>
                            <RadioButton x:Name="PanelSourceKeepInPlaceOption"
                                         x:FieldModifier="public"
                                         GroupName="PanelSourceHandling"
                                         Checked="SourceHandling_Checked">
                                <StackPanel>
                                    <TextBlock Text="留下（默认，原来的位置不动）" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Text="程序一个字节都不碰你的源包" Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="PanelSourceDeleteOption"
                                         x:FieldModifier="public"
                                         GroupName="PanelSourceHandling"
                                         Margin="0,4,0,0"
                                         Checked="SourceHandling_Checked">
                                <StackPanel>
                                    <TextBlock Text="彻底删除（就地删掉源包，不可恢复）" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Text="成功 + 校验通过之后才删，就地删、不搬进其余物；失败 / 取消一律原地不动" Style="{StaticResource HintTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </GroupBox>

                    <!-- ==================== 删除操作 ==================== -->
                    <GroupBox Header="2 最后一层过程物操作（失败 / 部分完成时，链停下那一层的包怎么办）">
                        <StackPanel>
                            <RadioButton x:Name="PanelRestKeepOption"
                                         x:FieldModifier="public"
                                         GroupName="PanelRestHandling"
                                         Checked="RestHandling_Checked">
                                <TextBlock Text="留下（默认，留在原地）" Style="{StaticResource BodyTextStyle}" />
                            </RadioButton>

                            <RadioButton x:Name="PanelRestDeleteOption"
                                         x:FieldModifier="public"
                                         GroupName="PanelRestHandling"
                                         Margin="0,4,0,0"
                                         Foreground="{StaticResource DangerTextBrush}"
                                         Checked="RestHandling_Checked">
                                <TextBlock Text="彻底删除，直接省空间（不可恢复）" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource DangerTextBrush}" />
                            </RadioButton>

                            <Border x:Name="RestDeleteNotice"
                                    x:FieldModifier="public"
                                    Style="{StaticResource WarningBannerStyle}"
                                    Margin="0,8,0,0"
                                    Visibility="Collapsed">
                                <TextBlock Style="{StaticResource BannerTextStyle}"
                                           Foreground="{StaticResource DangerTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="彻底删除不可恢复：只作用于失败 / 部分完成时链停下那一层要解的包（最后一层过程物）。成功链上的其他过程物本来就按固定规则当场删除；失败 / 取消的源包一个字节都不动。" />
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <CheckBox x:Name="SaveAsDefaultBox"
                              x:FieldModifier="public"
                              Margin="0,4,0,0"
                              Content="把本次选择存为默认（写入设置文件，下次启动仍是它）"
                              Checked="Option_Changed"
                              Unchecked="Option_Changed" />
                </StackPanel>
            </ScrollViewer>
        </Expander>
    </DockPanel>
</Window>
