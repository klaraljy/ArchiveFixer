<UserControl x:Class="ArchiveFixer.Views.Tabs.ExtractionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ArchiveFixer.Models"
             xmlns:storage="clr-namespace:ArchiveFixer.Storage">

    <!--
        ② 解压方式页（用户 2026-09-24 第 11 条）。
        内容全部按功能归位：落点 / 嵌套与覆盖 / 解压前后 / 并发与空间 / 引擎。
        ⛔ 页面最底下那块「高风险区（危险模式 + 自测凭证 + 风险四条 + 红横幅）」按用户
        2026-09-25 第 32 条**整块退役**：那条需求现在是③页「删除操作」里的第三档，
        选它时会在下面出现一条不可关闭的红字提示 —— 红字就是警告，不再另配注释。

        第 20 条：整页可滚（内容多），每个分组用 GroupBox + 星号/自动行，没有任何固定高度堆叠。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- ==================== 落点（解压到哪） ==================== -->
            <GroupBox Header="落点（解压到哪）">
                <StackPanel>
                    <RadioButton GroupName="OutputPlacement"
                                 IsChecked="{Binding SettingsEditor.OutputPlacement, Converter={StaticResource EnumOptionConverter}, ConverterParameter=ArchiveNamedSubfolder, Mode=TwoWay}"
                                 Content="同名子文件夹（111\222.rar → 111\222\）"
                                 ToolTip="与 WinRAR 默认一致，不会和同目录其它文件混在一起" />

                    <RadioButton GroupName="OutputPlacement"
                                 Margin="0,6,0,0"
                                 IsChecked="{Binding SettingsEditor.OutputPlacement, Converter={StaticResource EnumOptionConverter}, ConverterParameter=CustomNamedSubfolder, Mode=TwoWay}"
                                 Content="指定位置 + 同名子文件夹（111\222.rar → 333\222\）"
                                 ToolTip="多个包各占一个文件夹，适合归集整理" />

                    <Border Style="{StaticResource InfoBannerStyle}" Margin="0,10,0,8">
                        <TextBlock Text="{Binding SettingsEditor.OutputPlacementSummary}"
                                   Style="{StaticResource BannerTextStyle}"
                                   Foreground="{StaticResource InfoTextBrush}"
                                   FontFamily="{StaticResource MonoFontFamily}" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="指定位置："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.CustomOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding SettingsEditor.IsCustomOutputEnabled}"
                                 ToolTip="只有选了「指定位置 + 同名子文件夹」那一档才用得上" />

                        <Button Grid.Column="2"
                                Content="选择"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding SettingsEditor.IsCustomOutputEnabled}"
                                Command="{Binding SettingsEditor.SelectOutputDirectoryCommand}" />

                        <TextBlock Grid.Column="3"
                                   Text="（不适用）"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsEditor.IsCustomOutputEnabled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!--
                ==================== 内容物最后一层：2026-09-27 整组删除 ====================
                原来这里是「终端落法」两档单选框 + 「包名与文件夹同名时去掉一层」勾选框。
                用户 2026-09-27 拍板：终点的落法**固定**为"保留压缩包自己那一层内层文件夹，
                外面再套一层以包名命名的文件夹"，不再让用户选 —— 于是这组控件连同设置项一起删掉
                （设置项 `TerminalLayoutMode` / `CollapseRepeatedFolderLayer` 已从 AppSettings 移除）。
                要"平铺"只剩一条路：① 页「手动操作」里的「解压到当前文件夹」，且只对当次手动操作生效。
            -->

            <!--
                ==================== 特定解压（用户 2026-09-24 拍板） ====================
                这一栏是**可加的**：规则全部按注册表渲染（Extraction/SpecialExtractionRules.All），
                XAML 里一条规则都没写死 —— 以后加规则 = 加一条描述 + 它的实现，这里一个字都不用动
                （有测试钉住：塞一条假描述进注册表，这一栏自动多一条）。

                优先级必须写明（用户点名要求）：这里的规则**优先于**落点与嵌套的默认落法。
                总开关在①「任务」页、一键处理旁边 —— 这一页只挑规则，不重复放开关
                （两项都绑同一个设置会被界面重构的"一项只有一个家"钉死）。
            -->
            <GroupBox Header="{x:Static models:StatusText.SpecialExtractionRulesGroupHeader}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SpecialExtractionRulesIntro}" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SpecialExtractionPriorityHint}" />

                    <!--
                        规则列表：每条 = 开关 + 名称 + 一句说明 + ToolTip。
                        开关直接写回设置里的规则 Id 清单（SettingsEditor 那一列负责归一化）。
                    -->
                    <ItemsControl ItemsSource="{Binding SettingsEditor.SpecialExtractionRules}"
                                  Margin="0,8,0,0"
                                  Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <CheckBox Content="{Binding Name, Mode=OneWay}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              ToolTip="{Binding ToolTip, Mode=OneWay}" />

                                    <TextBlock Text="{Binding Description, Mode=OneWay}"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="22,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>

            <!-- ==================== 嵌套与覆盖 ==================== -->
            <GroupBox Header="嵌套与覆盖">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="嵌套压缩包："
                                   Style="{StaticResource LabelTextStyle}" />

                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding SettingsEditor.Settings.RecursionMode, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="只解当前这一层" Tag="SingleLayer" />
                            <ComboBoxItem Content="单链自动展开（只有一个内层包时才继续）" Tag="SingleChain" />
                            <ComboBoxItem Content="展开所有分支（出厂默认：有压缩包就解压）" Tag="AllBranches" />
                        </ComboBox>
                    </Grid>

                    <!--
                        用户 2026-10-04：「并且在选择旁边详细说明情况」——
                        三档各写清**它怎么走 / 什么时候会停 / 空间与时间代价**。
                        文案唯一来源 = StatusText（⛔ 这里不许手写中文、不许写 Markdown 强调）。
                    -->
                    <StackPanel Margin="110,0,0,8">
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="{x:Static models:StatusText.RecursionModeHintLabel}" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Text="{x:Static models:StatusText.RecursionModeAllBranchesHint}" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Text="{x:Static models:StatusText.RecursionModeSingleChainHint}" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Text="{x:Static models:StatusText.RecursionModeSingleLayerHint}" />
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="最大嵌套层数："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.MaxRecursionDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="1~10，默认 5。到达上限会安全停下并报告停在哪一层，不会无限展开。一键处理的续解轮数也按这一格走。" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="1~10，默认 5。到上限会停下并报告；一键处理的续解轮数按这一格走。" />
                    </Grid>

                    <!--
                        续解的中间层（用户 2026-09-27 拍板）：首尾两层**永远保留**，中间那些"包里套包"的层
                        默认照忠实档一层一层建出来；勾上这一格 = 简洁档，单链时把中间层省掉。
                        出现分支（那一层里有多个包 / 还有别的文件）时**那一层照建**，并在日志里说明为什么没省。
                    -->
                    <CheckBox Content="续解时省略中间层（只留第一层与最后一层）"
                              Margin="0,0,0,8"
                              IsChecked="{Binding SettingsEditor.OmitMiddleContinuationLayers, Mode=TwoWay}"
                              ToolTip="默认不勾 = 忠实档：111\222\333\444\555\666\内容物；勾上 = 简洁档：111\222\666\内容物。只在单链续解时生效，第一层与最后一层永远保留。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="解压覆盖策略："
                                   Style="{StaticResource LabelTextStyle}" />

                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding SettingsEditor.Settings.OverwriteMode, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="跳过已存在文件" Tag="SkipExisting" />
                            <ComboBoxItem Content="覆盖全部" Tag="OverwriteAll" />
                            <ComboBoxItem Content="自动重命名解压出的文件" Tag="AutoRenameExtracted" />
                            <ComboBoxItem Content="自动重命名已存在文件（仅 7-Zip 支持）" Tag="AutoRenameExisting" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="110,4,0,0"
                               TextWrapping="Wrap"
                               Text="RAR 包默认走 UnRAR，而它没有「自动重命名已存在文件」这一档 —— 那里的实际行为是「跳过已存在文件」。要覆盖就选「覆盖全部」。" />

                    <!--
                        第 42 条的全自动拼装（用户 2026-09-25 选的方案 A：做，默认关）。
                        说明必须把代价写清：它会读源目录、并在工作区里造名字 / 复制卷；
                        判不准的场合一律不动，源文件一个字节不改。
                    -->
                    <CheckBox Content="容器里装的是分卷第 1 卷时，自动接上同目录的后续卷"
                              Margin="0,12,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.AssembleSplitVolumesFromContainer, Mode=TwoWay}"
                              ToolTip="有些包的形状是：一个文件（例如 封面.jpg）里装着的正是 set.7z.001，而 set.7z.002/.003 就在同一个文件夹里。默认关：程序只把话说清（首卷在容器里、外面缺的是后续卷）并给改名建议，不会动。打开：程序在工作区里接出一套名字成套的卷再解压 —— 同一块盘只接名字（硬链接，不复制字节、不改你的文件），跨盘才复制且先查空间；同族两组以上缺首卷或认不准时一律不做。" />
                </StackPanel>
            </GroupBox>

            <!--
                ==================== 内容物保留关键词（用户 2026-10-04 第二次改口径） ====================
                原话：「你这个内容物保留关键词的输入框这么弄的这么大，你应该弄的像密码一样，
                而且是放在解压方式里面」。
                ⇒ 从⑥设置整块搬到这里（⛔ 那边已删掉，入口只有这一处），形态改成与④页密码清单同一种手感：
                单行输入 + 「添加」（回车也行）+ 一行一个词、每条右边能「移除」。
                ⛔ 判据一个字没动（唯一出口 Security\ContentKeepRules.cs），落盘的键也没变。
            -->
            <GroupBox Header="内容物保留关键词（名字里含这些词的内容物一律不碰）">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.ContentKeepKeywordsIntro}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SettingsEditor.NewContentKeepKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{x:Static models:StatusText.ContentKeepKeywordsInputToolTip}">
                            <!-- 回车 = 点「添加」（手不用离开键盘） -->
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding SettingsEditor.AddContentKeepKeywordCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1"
                                Content="{x:Static models:StatusText.ContentKeepKeywordsAddButtonText}"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding SettingsEditor.CanAddContentKeepKeyword}"
                                Command="{Binding SettingsEditor.AddContentKeepKeywordCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding SettingsEditor.ContentKeepKeywordsSummary}" />

                    <!-- 一行一个词；空列表时这一段自然什么都没有（上面那句已经说了"现在是空的"）。 -->
                    <ItemsControl ItemsSource="{Binding SettingsEditor.ContentKeepKeywordItems}"
                                  Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource OptionRowStyle}"
                                        Background="{StaticResource PanelSunkenBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        Margin="0,0,0,4"
                                        Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Button Grid.Column="1"
                                                MinWidth="64"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Content="{x:Static models:StatusText.ContentKeepKeywordsRemoveButtonText}"
                                                Command="{Binding DataContext.SettingsEditor.RemoveContentKeepKeywordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.ContentKeepKeywordsRulesHint}" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 解压前与完成后 ==================== -->
            <GroupBox Header="解压前与完成后">
                <StackPanel>
                    <!--
                        第 17 条：一键处理的那**一个**确认框可以关掉（用户原话："这个可以选中以后不弹出"）。
                        确认框里那个勾选项写的就是这一项 —— 这里是它的"再打开"入口。
                    -->
                    <CheckBox Content="{x:Static models:StatusText.SettingsSkipOneClickConfirmLabel}"
                              IsChecked="{Binding SettingsEditor.Settings.SkipOneClickConfirm, Mode=TwoWay}"
                              ToolTip="{x:Static models:StatusText.SettingsSkipOneClickConfirmHint}" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="22,4,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SettingsSkipOneClickConfirmHint}" />

                    <CheckBox Content="解压前测试完整性"
                              Margin="0,10,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.TestBeforeExtract, Mode=TwoWay}" />

                    <CheckBox Content="定稿完成后在资源管理器里打开输出目录"
                              Margin="0,8,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.OpenOutputFolderWhenDone, Mode=TwoWay}"
                              ToolTip="只在任务真正定稿成功之后打开；失败 / 部分完成 / 取消时一律不打开。只开文件夹，不会把本程序窗口置前。" />

                    <CheckBox Content="统计并提示可疑条目（可执行文件 / 脚本）"
                              Margin="0,8,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.ReportDangerousEntries, Mode=TwoWay}"
                              ToolTip="只提示、绝不阻断：不会因此跳过任何条目，也不会改变落盘结果" />

                    <CheckBox Content="把解压结果归集到统一目录"
                              Margin="0,8,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.CollectResultsToDirectory, Mode=TwoWay}" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="归集目标目录："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.CollectTargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="2"
                                Content="选择"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Command="{Binding SettingsEditor.SelectCollectTargetDirectoryCommand}" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- ==================== 并发与空间 ==================== -->
            <GroupBox Header="并发与空间（从主界面搬来）">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="并发档："
                                   Style="{StaticResource LabelTextStyle}" />

                        <!--
                            可编辑的下拉：1 / 2 / 3 / 4 / 8 是档位，也可以直接填 1~8 的任意数
                            （设置项本身允许 1~8，这里不再把 5~7 挡在门外）。
                        -->
                        <ComboBox Grid.Column="1"
                                  IsEditable="True"
                                  ItemsSource="{Binding MaxParallelChoices}"
                                  Text="{Binding SettingsEditor.Settings.MaxParallelExtractCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                  SelectionChanged="ParallelCount_SelectionChanged"
                                  LostFocus="ParallelCount_LostFocus"
                                  ToolTip="同时解压几个包（1~8，默认 4）。装不下当前可用空间的任务仍然会在启动前被拦下，并如实报告各自需要多少。" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            <Run Text="默认 4（实测：并发 1→4 吞吐 3.08×，4→8 只再快 1.9% 却把单包耗时拉长一倍）—— " />
                            <Run Text="{x:Static storage:ProcessorTopology.ConcurrencyAdvice}" /><Run Text="。" />
                        </TextBlock>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox Content="全速（本批不节流）"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding RunAtFullSpeed, Mode=TwoWay}"
                                  ToolTip="本批忽略并发档，能并行多少就并行多少。这是一个「设置」：改了立刻存、重启后还是勾着的（想恢复排队就把勾去掉）。慢盘上会让磁盘更忙。" />

                        <Button Content="按空间算建议"
                                Margin="16,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="按当前可用空间算出最多能并行几个（要读每个源包的大小，可能要一两秒）"
                                Command="{Binding RefreshParallelAdviceCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ParallelAdviceText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               ToolTip="{Binding ParallelAdviceText}"
                               Style="{StaticResource HintTextStyle}" />

                    <Border Style="{StaticResource InfoBannerStyle}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SpaceModeText}"
                                       Style="{StaticResource BannerTextStyle}"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       TextWrapping="Wrap" />

                            <!--
                                ①页那个「空间不足」开关开着时的**覆盖提示**（用户 2026-09-27）：
                                这一页正是他核对"源包 / 其余物 / 并发"的地方，只写在①页等于没写。
                                关着时整行收起（空字符串 → Collapsed，见 BoolToVisibility 那一套的同款做法）。
                            -->
                            <TextBlock Text="{Binding SpaceTightOverrideText}"
                                       Style="{StaticResource BannerTextStyle}"
                                       Foreground="{StaticResource WarningTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding HasSpaceTightOverride, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock Style="{StaticResource BannerTextStyle}"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Text="空间门：每个任务启动前都按「源包 + 内容物 + 其余物增量 + 512 MiB 余量」核算；不够就不启动，并写明需要多少、可用多少、差多少。取不到目标盘可用空间时「不拦」，但会在日志里明说取不到。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!--
                ==================== 引擎（用哪个程序解压） ====================
                AGENTS.md §3.1 要求"界面显示当前是否在用"，所以每行都带：
                检测状态 + 路径 + 版本 + 它当前负责哪些格式。
            -->
            <GroupBox Header="引擎（用哪个程序解压）">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding SettingsEditor.Engines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource OptionRowStyle}"
                                        Background="{StaticResource PanelSunkenBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        Margin="0,0,0,6"
                                        Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding HeaderText}"
                                                       Style="{StaticResource BodyTextStyle}" />

                                            <TextBlock Style="{StaticResource HintTextStyle}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}"
                                                       Text="{Binding Path, StringFormat=路径：{0}}" />

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Style="{StaticResource HintTextStyle}"
                                                           Text="{Binding SourceText, StringFormat=来源：{0}}" />

                                                <TextBlock Margin="10,0,0,0"
                                                           Text="{Binding UsageText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Grid.Column="2"
                                                Content="上移"
                                                MinWidth="56"
                                                Margin="0,0,6,0"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding CanMoveUp}"
                                                ToolTip="把它的优先级提前一位（排在前面的优先被选上）"
                                                Command="{Binding DataContext.SettingsEditor.MoveEngineUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />

                                        <Button Grid.Column="3"
                                                Content="下移"
                                                MinWidth="56"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding CanMoveDown}"
                                                ToolTip="把它的优先级推后一位"
                                                Command="{Binding DataContext.SettingsEditor.MoveEngineDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource InfoBannerStyle}" Margin="0,4,0,10">
                        <TextBlock Style="{StaticResource BannerTextStyle}"
                                   Foreground="{StaticResource InfoTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding SettingsEditor.EngineSelectionSummary}" />
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="UnRAR.exe 路径："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.CustomUnRarExePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="留空表示自动：先找本机已装 WinRAR 目录里的 UnRAR.exe，再退回程序内置的 tools\unrar\UnRAR.exe。" />
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Rar.exe 路径："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.CustomRarExePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding SettingsEditor.RarExePathHint}" />

                        <Button Grid.Column="2"
                                Content="浏览…"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding SettingsEditor.SelectRarExeCommand}"
                                ToolTip="选你自己安装 / 下载的 WinRAR 里的 Rar.exe（程序不会复制、也不会随包分发它）" />
                    </Grid>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="150,0,0,4"
                               TextWrapping="Wrap"
                               Text="{Binding SettingsEditor.RarExePathHint}" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="150,0,0,10"
                               TextWrapping="Wrap"
                               Text="{Binding SettingsEditor.RarToolStatusText}" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="7z.exe 路径："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.CustomSevenZipExePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="留空表示使用程序目录下的 tools\7zip\7z.exe" />
                    </Grid>

                    <CheckBox Content="保留受损的文件（校验和不符的半成品留在磁盘上）"
                              Margin="0,6,0,0"
                              IsChecked="{Binding SettingsEditor.KeepBrokenFiles, Mode=TwoWay}"
                              ToolTip="只让 RAR 引擎（UnRAR）别把校验失败的半成品删掉（-kb）。7-Zip 没有这个开关。任务状态仍然是「失败 / 部分完成」。" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
