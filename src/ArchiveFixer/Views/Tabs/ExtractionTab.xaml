<UserControl x:Class="ArchiveFixer.Views.Tabs.ExtractionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ArchiveFixer.Views.Controls"
             xmlns:models="clr-namespace:ArchiveFixer.Models"
             xmlns:storage="clr-namespace:ArchiveFixer.Storage">

    <!--
        ② 解压方式页（用户 2026-09-24 第 11 条）。
        内容全部按功能归位：落点 / 嵌套与覆盖 / 解压前后 / 并发与空间 / 引擎。
        ⛔ 页面最底下那块「高风险区（危险模式 + 自测凭证 + 风险四条 + 红横幅）」按用户
        2026-09-25 第 32 条**整块退役**：那条需求现在是③页「删除操作」里的第三档，
        选它时会在下面出现一条不可关闭的红字提示 —— 红字就是警告，不再另配注释。

        第 20 条：整页可滚（内容多），每个分组用 GroupBox + 星号/自动行，没有任何固定高度堆叠。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- ==================== 落点（解压到哪） ==================== -->
            <GroupBox Header="落点（解压到哪）">
                <StackPanel>
                    <RadioButton GroupName="OutputPlacement"
                                 IsChecked="{Binding SettingsEditor.OutputPlacement, Converter={StaticResource EnumOptionConverter}, ConverterParameter=ArchiveNamedSubfolder, Mode=TwoWay}"
                                 Content="同名子文件夹（111\222.rar → 111\222\）"
                                 ToolTip="与 WinRAR 默认一致，不会和同目录其它文件混在一起" />

                    <RadioButton GroupName="OutputPlacement"
                                 Margin="0,6,0,0"
                                 IsChecked="{Binding SettingsEditor.OutputPlacement, Converter={StaticResource EnumOptionConverter}, ConverterParameter=CustomNamedSubfolder, Mode=TwoWay}"
                                 Content="指定位置 + 同名子文件夹（111\222.rar → 333\222\）"
                                 ToolTip="多个包各占一个文件夹，适合归集整理" />

                    <Border Style="{StaticResource InfoBannerStyle}" Margin="0,10,0,8">
                        <TextBlock Text="{Binding SettingsEditor.OutputPlacementSummary}"
                                   Style="{StaticResource BannerTextStyle}"
                                   Foreground="{StaticResource InfoTextBrush}"
                                   FontFamily="{StaticResource MonoFontFamily}" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="指定位置："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.CustomOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding SettingsEditor.IsCustomOutputEnabled}"
                                 ToolTip="只有选了「指定位置 + 同名子文件夹」那一档才用得上" />

                        <Button Grid.Column="2"
                                Content="选择"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding SettingsEditor.IsCustomOutputEnabled}"
                                Command="{Binding SettingsEditor.SelectOutputDirectoryCommand}" />

                        <TextBlock Grid.Column="3"
                                   Text="（不适用）"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsEditor.IsCustomOutputEnabled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!--
                ==================== 内容物最后一层：2026-09-27 整组删除 ====================
                原来这里是「终端落法」两档单选框 + 「包名与文件夹同名时去掉一层」勾选框。
                用户 2026-09-27 拍板：终点的落法**固定**为"保留压缩包自己那一层内层文件夹，
                外面再套一层以包名命名的文件夹"，不再让用户选 —— 于是这组控件连同设置项一起删掉
                （设置项 `TerminalLayoutMode` / `CollapseRepeatedFolderLayer` 已从 AppSettings 移除）。
                要"平铺"只剩一条路：① 页「手动操作」里的「解压到当前文件夹」，且只对当次手动操作生效。
            -->

            <!--
                ==================== 特定解压（用户 2026-09-24 拍板） ====================
                这一栏是**可加的**：规则全部按注册表渲染（Extraction/SpecialExtractionRules.All），
                XAML 里一条规则都没写死 —— 以后加规则 = 加一条描述 + 它的实现，这里一个字都不用动
                （有测试钉住：塞一条假描述进注册表，这一栏自动多一条）。

                优先级必须写明（用户点名要求）：这里的规则**优先于**落点与嵌套的默认落法。
                总开关在①「任务」页、一键处理旁边 —— 这一页只挑规则，不重复放开关
                （两项都绑同一个设置会被界面重构的"一项只有一个家"钉死）。
            -->
            <GroupBox Header="{x:Static models:StatusText.SpecialExtractionRulesGroupHeader}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SpecialExtractionRulesIntro}" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SpecialExtractionPriorityHint}" />

                    <!--
                        规则列表：每条 = 开关 + 名称 + 一句说明 + ToolTip。
                        开关直接写回设置里的规则 Id 清单（SettingsEditor 那一列负责归一化）。
                    -->
                    <ItemsControl ItemsSource="{Binding SettingsEditor.SpecialExtractionRules}"
                                  Margin="0,8,0,0"
                                  Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <CheckBox Content="{Binding Name, Mode=OneWay}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              ToolTip="{Binding ToolTip, Mode=OneWay}" />

                                    <TextBlock Text="{Binding Description, Mode=OneWay}"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="22,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </GroupBox>

            <!-- ==================== 嵌套与覆盖 ==================== -->
            <GroupBox Header="嵌套与覆盖">
                <StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="最大嵌套层数："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.MaxRecursionDepth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="1~10，默认 7。到达上限会安全停下并报告停在哪一层，不会无限展开。一键处理的续解轮数也按这一格走。" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="1~10，默认 7。到上限会停下并报告；一键处理的续解轮数按这一格走。" />
                    </Grid>

                    <!--
                        第 42 条的全自动拼装（用户 2026-09-25 选的方案 A：做，默认关）。
                        说明必须把代价写清：它会读源目录、并在工作区里造名字 / 复制卷；
                        判不准的场合一律不动，源文件一个字节不改。
                        ⚠ 完整说明已按用户 2026-10-04 的口径挪进本组最下面的折叠区。
                    -->
                    <CheckBox Content="容器里装的是分卷第 1 卷时，自动接上同目录的后续卷"
                              Margin="0,12,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.AssembleSplitVolumesFromContainer, Mode=TwoWay}"
                              ToolTip="{x:Static models:StatusText.NestedVolumeAssemblyShortHint}" />

                    <!--
                        本组的长说明统一收在这里（用户 2026-10-04：「你这个嵌套与覆盖你的文字这么多」）——
                        覆盖策略 / 中间层 / 分卷拼装三件事，默认收起、点一下才展开。
                        ⛔ 文字一个字没删，只是不再摊在页面上。
                    -->
                    <Expander Margin="0,10,0,0"
                              Header="{x:Static models:StatusText.NestedExtrasDetailHeader}">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="{x:Static models:StatusText.NestedOverwriteDetail}" />

                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="{x:Static models:StatusText.NestedVolumeAssemblyDetail}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </GroupBox>

            <!--
                ==================== 内容物保留关键词（用户 2026-10-04 第二次改口径） ====================
                原话：「你这个内容物保留关键词的输入框这么弄的这么大，你应该弄的像密码一样，
                而且是放在解压方式里面」。
                ⇒ 从⑥设置整块搬到这里（⛔ 那边已删掉，入口只有这一处），形态改成与④页密码清单同一种手感：
                单行输入 + 「添加」（回车也行）+ 一行一个词、每条右边能「移除」。
                ⛔ 判据一个字没动（唯一出口 Security\ContentKeepRules.cs），落盘的键也没变。
            -->
            <GroupBox Header="内容物保留关键词（名字里含这些词的内容物一律不碰）">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.ContentKeepKeywordsIntro}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SettingsEditor.NewContentKeepKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{x:Static models:StatusText.ContentKeepKeywordsInputToolTip}">
                            <!-- 回车 = 点「添加」（手不用离开键盘） -->
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding SettingsEditor.AddContentKeepKeywordCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1"
                                Content="{x:Static models:StatusText.ContentKeepKeywordsAddButtonText}"
                                MinWidth="72"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding SettingsEditor.CanAddContentKeepKeyword}"
                                Command="{Binding SettingsEditor.AddContentKeepKeywordCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding SettingsEditor.ContentKeepKeywordsSummary}" />

                    <!-- 一行一个词；空列表时这一段自然什么都没有（上面那句已经说了"现在是空的"）。 -->
                    <ItemsControl ItemsSource="{Binding SettingsEditor.ContentKeepKeywordItems}"
                                  Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource OptionRowStyle}"
                                        Background="{StaticResource PanelSunkenBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        Margin="0,0,0,4"
                                        Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />

                                        <Button Grid.Column="1"
                                                MinWidth="64"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Content="{x:Static models:StatusText.ContentKeepKeywordsRemoveButtonText}"
                                                Command="{Binding DataContext.SettingsEditor.RemoveContentKeepKeywordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.ContentKeepKeywordsRulesHint}" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 并发与空间 ==================== -->
            <GroupBox Header="并发与空间">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="并发档："
                                   Style="{StaticResource LabelTextStyle}" />

                        <!--
                            可编辑的下拉：1 / 2 / 3 / 4 / 8 是档位，也可以直接填 1~8 的任意数
                            （设置项本身允许 1~8，这里不再把 5~7 挡在门外）。
                        -->
                        <ComboBox Grid.Column="1"
                                  IsEditable="True"
                                  ItemsSource="{Binding MaxParallelChoices}"
                                  Text="{Binding SettingsEditor.Settings.MaxParallelExtractCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                  SelectionChanged="ParallelCount_SelectionChanged"
                                  LostFocus="ParallelCount_LostFocus"
                                  ToolTip="同时解压几个包（1~8，默认 4）。装不下当前可用空间的任务仍然会在启动前被拦下，并如实报告各自需要多少。" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            <Run Text="默认 4（实测：并发 1→4 吞吐 3.08×，4→8 只再快 1.9% 却把单包耗时拉长一倍）—— " />
                            <Run Text="{x:Static storage:ProcessorTopology.ConcurrencyAdvice}" /><Run Text="。" />
                        </TextBlock>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox Content="全速（本批不节流）"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding RunAtFullSpeed, Mode=TwoWay}"
                                  ToolTip="本批忽略并发档，能并行多少就并行多少。这是一个「设置」：改了立刻存、重启后还是勾着的（想恢复排队就把勾去掉）。慢盘上会让磁盘更忙。" />

                        <Button Content="按空间算建议"
                                Margin="16,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="按当前可用空间算出最多能并行几个（要读每个源包的大小，可能要一两秒）"
                                Command="{Binding RefreshParallelAdviceCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding ParallelAdviceText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               ToolTip="{Binding ParallelAdviceText}"
                               Style="{StaticResource HintTextStyle}" />

                    <Border Style="{StaticResource InfoBannerStyle}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SpaceModeText}"
                                       Style="{StaticResource BannerTextStyle}"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       TextWrapping="Wrap" />

                            <!--
                                ①页那个「空间不足」开关开着时的**覆盖提示**（用户 2026-09-27）：
                                这一页正是他核对"源包 / 其余物 / 并发"的地方，只写在①页等于没写。
                                关着时整行收起（空字符串 → Collapsed，见 BoolToVisibility 那一套的同款做法）。
                            -->
                            <TextBlock Text="{Binding SpaceTightOverrideText}"
                                       Style="{StaticResource BannerTextStyle}"
                                       Foreground="{StaticResource WarningTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding HasSpaceTightOverride, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                        <controls:BoxDetail Header="{x:Static models:StatusText.BoxDetailSpaceGateHeader}"
                                                Detail="{x:Static models:StatusText.BoxDetailSpaceGateDetail}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
