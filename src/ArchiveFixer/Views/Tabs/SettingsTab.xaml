<UserControl x:Class="ArchiveFixer.Views.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ArchiveFixer.Models">

    <!--
        ⑥ 设置页（用户 2026-09-24 第 11 条）：**只剩程序级的东西** ——
        日志、启动时行为、扫描与识别、恢复默认、关于 / 版本 / 许可。
        「解压方式 / 清理与删除 / 密码 / 打包」那几类都已各自成页，这里不再重复一份。
        整页可滚（第 20 条）。

        ⛔ 2026-09-30：「缓存根目录」那一格**已彻底删除**（用户："这个彻底取消，用户没有定工作区的权力，
        就是在解压的地方设立隐形的工作区"）。这一组现在只剩一个"打开工作区目录"按钮 ——
        工作区位置没有任何可以设的地方，它只由这一单的目标目录派生。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- ==================== 工作区 ==================== -->
            <GroupBox Header="工作区目录">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="位置："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBlock Grid.Column="1"
                                   Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Text="只由目标目录决定，没有设置项可以改"
                                   ToolTip="{x:Static models:StatusText.SettingsWorkDirectoryButtonHint}" />

                        <Button Grid.Column="2"
                                Content="打开工作区目录"
                                MinWidth="120"
                                Margin="8,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding OpenWorkDirectoryCommand}"
                                ToolTip="{x:Static models:StatusText.SettingsWorkDirectoryButtonHint}" />
                    </Grid>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="110,6,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SettingsWorkDirectoryButtonHint}" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 日志 ==================== -->
            <GroupBox Header="日志">
                <StackPanel>
                    <CheckBox Content="启用日志文件"
                              IsChecked="{Binding SettingsEditor.Settings.EnableLog, Mode=TwoWay}"
                              ToolTip="关掉之后不再往 data\logs 追加文件日志（屏幕上的日志照旧显示）；日志里的密码一律脱敏。" />

                    <!--
                        详细日志（排查用，用户 2026-09-25 第 44 条追加拍板；2026-09-27 补"到底多出什么"）：
                        默认关 = 成功只留一行摘要；打开 = 每步都写 + **引擎调用参数摘要 + 引擎原话**（递归每层候选明细）。
                        ⚠ 失败与取消的任务**不受这个开关影响**：它们的引擎原话与细节永远写。
                    -->
                    <CheckBox Content="详细日志（排查用）"
                              Margin="0,8,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.VerboseLog, Mode=TwoWay}"
                              ToolTip="默认关：成功的任务只写一行摘要（几十个同形包时日志小一个数量级）。打开后在那一行之外「多出三类」：① 每次引擎调用的参数摘要（密码一律写成 -p******）；② 引擎原话（7-Zip / UnRAR 输出里带 ERROR、Cannot、Wrong password、CRC、Data Error、Missing 等关键字的行，最多 3 行、每行截断 300 字符）；③ 递归展开时每一层的候选明细（第几层、第几个候选、来源）。失败 / 取消 / 部分完成的任务永远保留这些，不受这里影响。" />

                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="导出日志（本次操作）"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="只导出「最近一次操作」的日志（从日志里那行「本次操作开始」起）"
                                Command="{Binding ExportLogCommand}" />

                        <Button Content="导出全部历史日志"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="把日志目录里「每一份」历史日志都拼进来（平时用不上，只在需要翻旧账时用）"
                                Command="{Binding ExportAllLogsCommand}" />

                        <Button Content="打开日志目录"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding OpenLogDirectoryCommand}" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- ==================== 启动时行为 ==================== -->
            <GroupBox Header="启动时行为">
                <StackPanel>
                    <CheckBox Content="记住上次输出目录"
                              IsChecked="{Binding SettingsEditor.Settings.RememberLastOutputDirectory, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="22,4,0,0"
                               TextWrapping="Wrap"
                               Text="关掉之后：下次启动不再把上次的输出目录填回「当前输出位置」。注意输出位置在「任务」页（「输出位置：… 选择…」和「未指定位置」那颗开关）与「解压方式」页都能改，两处写的是同一份设置；这一项管的是「启动时要不要沿用上次那个自定义根」。" />

                    <CheckBox Content="低运行优先级运行"
                              Margin="0,12,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.LowProcessPriority, Mode=TwoWay}"
                              ToolTip="让本程序与它启动的解压进程让出 CPU / 磁盘优先级。重启程序后生效。" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="22,4,0,0"
                               TextWrapping="Wrap"
                               Text="开着：批量解压时还让得开手，前台程序不会被拖卡（代价是纯后台跑时慢一点）。它与「并发档」是两个互相独立的旋钮，改一个不会顺手改另一个。" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 扫描与识别 ==================== -->
            <GroupBox Header="扫描与识别">
                <StackPanel>
                    <CheckBox Content="递归扫描文件夹"
                              IsChecked="{Binding SettingsEditor.Settings.RecursiveScan, Mode=TwoWay}" />

                    <CheckBox Content="导入后自动扫描（拖拽 / 添加文件 / 添加文件夹）"
                              Margin="0,8,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.AutoScanAfterDrop, Mode=TwoWay}"
                              ToolTip="关掉之后导入只加进列表、不自动识别；需要识别时用菜单「文件 → 重新扫描」。" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="扫描模式："
                                   Style="{StaticResource LabelTextStyle}" />

                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding SettingsEditor.Settings.ScanMode, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="扫描全部文件" Tag="ScanAllFiles" />
                            <ComboBoxItem Content="只扫描常见压缩后缀" Tag="ScanKnownArchiveExtensions" />
                            <ComboBoxItem Content="扫描可疑文件" Tag="ScanSuspiciousFiles" />
                        </ComboBox>
                    </Grid>

                    <CheckBox Content="包含隐藏文件"
                              Margin="0,10,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.IncludeHiddenFiles, Mode=TwoWay}"
                              ToolTip="默认不扫隐藏文件（属性里带「隐藏」的）。打开后它们也会进列表。" />

                    <CheckBox Content="包含系统文件"
                              Margin="0,8,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.IncludeSystemFiles, Mode=TwoWay}"
                              ToolTip="默认跳过系统文件（属性里带「系统」的，如 desktop.ini、Thumbs.db）。一般不要打开。" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="单文件上限："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.MaxFileSizeLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="单位 MB；0 = 不限。超过上限的文件在扫描阶段就被跳过。" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="单位 MB，0 = 不限。格式靠文件头识别，不靠后缀。" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="未知格式处理："
                                   Style="{StaticResource LabelTextStyle}" />

                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding SettingsEditor.Settings.UnknownFormatAction, Mode=TwoWay}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="加入列表并标记未知" Tag="MarkUnknown" />
                            <ComboBoxItem Content="跳过" Tag="Skip" />
                            <ComboBoxItem Content="仍尝试解压" Tag="TryExtract" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="默认补充后缀："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.DefaultExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="例如 .7z、.zip、.rar" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="同名冲突处理："
                                   Style="{StaticResource LabelTextStyle}"
                                   ToolTip="解压落位与改名遇到同名时的处置方式（默认自动重命名，绝不覆盖）。" />

                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding SettingsEditor.Settings.ConflictAction, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  ToolTip="默认「自动重命名」：新产物落成 名字(1)，不动已存在的文件。">
                            <ComboBoxItem Content="跳过（不动已存在的文件）" Tag="Skip" />
                            <ComboBoxItem Content="覆盖（先挪到临时名，落位成功后才删旧的）" Tag="Overwrite" />
                            <ComboBoxItem Content="自动重命名（默认，绝不覆盖）" Tag="AutoRename" />
                            <ComboBoxItem Content="询问（第一次冲突时暂停任务问一次）" Tag="Ask" />
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="110,6,0,0"
                               TextWrapping="Wrap"
                               Text="改名一定会先弹预览，改完由你确认才落盘。「询问」在两处都真的会问：解压落位弹一次聚合询问；改名冲突在预览表里逐条确认（没选就按保守档自动重命名，绝不覆盖）。" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 安全上限（解压前预算，第 36 条） ==================== -->
            <GroupBox Header="安全上限（解压前预算）">
                <StackPanel>
                    <!--
                        用户 2026-09-25 第 36 条：这四条以前是硬编码的（4 GiB 单文件 / 20 GiB 总量），
                        界面上一个字都没有 —— 他 12 GiB 的分卷包被拦下时，只看到一句像"包坏了"的判决。
                        现在它们既是设置项，也写在失败文案里（"可在⑥设置 →「安全上限」里调大"）。
                    -->

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="单文件上限："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.MaxSingleExtractedFileGiB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="单位 GiB（1~4096）。解压后「单个文件」超过它就不解这个包 —— 这是安全上限，不是这个包坏了。" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="单位 GiB，默认 64。解压后单个文件超过它就拒绝这个包（一个字节都不写）。" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="总大小上限："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.MaxExtractedTotalGiB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="单位 GiB（1~4096，且不小于单文件上限）。默认 512。" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="单位 GiB，默认 512，且不小于单文件上限（否则单文件那一档永远先命中）。" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="文件数上限："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.MaxExtractedFileCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="解压后条目数上限，默认 20 万。" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="默认 200000。解压后条目数超过它就拒绝这个包。" />
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="展开比上限："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.MaxExtractionRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="解压后总大小 ÷ 压缩包体积，默认 1000 倍，超过按压缩炸弹拒绝。" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="默认 1000 倍。超过按「疑似压缩炸弹」拒绝。" />
                    </Grid>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="110,8,0,0"
                               TextWrapping="Wrap"
                               Text="这四条只「拒绝解压」，不会删任何东西；超过上限时失败清单会写清是哪个上限拦的。另有两道独立的闸门照旧生效：目标盘空间不够就不启动，解压过程中按累计大小设限。" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 恢复默认 / 关于 ==================== -->
            <GroupBox Header="恢复默认与关于">
                <StackPanel>
                    <Button Content="恢复默认设置"
                            MinWidth="128"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DangerOutlineButtonStyle}"
                            ToolTip="把所有设置恢复成默认值（会先确认；恢复后立即生效并写盘）"
                            Command="{Binding ResetSettingsCommand}" />

                    <!--
                        「刚刚做了什么」的一行反馈（2026-09-26 同步审计）：挑 Rar.exe、
                        恢复默认这些动作的结论原来只写在 SettingsViewModel.Message 里 —— 那个框已被用户要求删除，
                        于是"已选择 Rar.exe"这类反馈在界面上**一句都没有**。绑在页内，就一行。
                    -->
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding SettingsEditor.Message}" />

                    <TextBlock Text="{Binding AboutText}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               ToolTip="版本 / 引擎版本 / 许可" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
