<UserControl x:Class="ArchiveFixer.Views.Tabs.HelpTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ArchiveFixer.Views">

    <!--
        ⑨ 说明页（用户 2026-10-14 最终设计：说明独立成一页）。
        正文与「说明」窗共用同一份 HelpBodyPanel；内容按快速开始 / 三种方式 / 功能地图 /
        术语 / 排查与 FAQ 分页，⛔ 不在本文件或 HelpBodyPanel 里手写第二份文案。
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:HelpBodyPanel Grid.Row="0" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="复制全部说明"
                    MinWidth="120"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="CopyAll_Click"
                    ToolTip="把这一份说明（含三种例子、功能地图与术语表）整段复制到剪贴板，方便贴给别人" />
        </StackPanel>
    </Grid>
</UserControl>
