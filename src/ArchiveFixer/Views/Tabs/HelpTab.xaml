<UserControl x:Class="ArchiveFixer.Views.Tabs.HelpTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ArchiveFixer.Views">

    <!--
        ⑨ 说明页（用户 2026-10-14 最终设计：说明独立成一页）。
        正文与「说明」窗**共用同一份** Views/HelpBodyPanel.xaml —— ⛔ 不许在这里再抄一份文案。
        用户口径：详细说明文字写进各页签自己的说明与每个功能框下面的「展示框」，
        平时的功能介绍只留简洁一行；那一档还没做（本页现在先把整份说明摆出来）。
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:HelpBodyPanel Grid.Row="0" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="复制全部说明"
                    MinWidth="120"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Click="CopyAll_Click"
                    ToolTip="把这一份说明（含术语表）整段复制到剪贴板，方便贴给别人" />
        </StackPanel>
    </Grid>
</UserControl>
