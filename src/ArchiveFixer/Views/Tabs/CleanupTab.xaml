<UserControl x:Class="ArchiveFixer.Views.Tabs.CleanupTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ArchiveFixer.Views.Controls"
             xmlns:models="clr-namespace:ArchiveFixer.Models">

    <!--
        ③ 清理与删除页（用户 2026-09-24 第 11 条；2026-09-25 第 32 条按用户口述重排）。
        两组单选，按用户原话摆：
          1 源包操作：1_留下（默认，原来的位置不动） 2_彻底删除（就地删，不可恢复；⛔ 不搬进其余物）
          2 删除操作：1_不动其余物（默认）     2_彻底删除（红字，选它时下面常驻一条提示）
        手工清理入口 2026-11-04 已整组移到「手动操作」窗口。
        整页可滚（第 20 条），没有任何固定高度堆叠。

        ⚠ 2026-10-15：回收站那一档**整条下线**（用户口径逐字：「我们这里现在只有留下和彻底删除操作，
        已经不存在放入回收站了」）⇒ 删除操作只剩"留下 / 彻底删除"两档；「手工删除时的默认档」那一格
        随设置项一起删除（它原来只决定确认框里"改为彻底删除"勾选框的默认状态，现在没有第二档可切）。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!--
                ⚠ 这一页的单选按钮与「一键处理 · 确认」那个弹窗（Views\OneClickOptionsWindow.xaml）里
                是**同一组档位**，两处**必须各自成组**：
                · `GroupName` 这里是 SourceHandling / RestHandling，弹窗那边是 PanelSourceHandling / PanelRestHandling
                  （⛔ 第 34 条那次真机事故就是"两个窗口共用 GroupName"：弹窗填初值时把这一组一起取消，
                  用户关掉弹窗回来看到一组没有黑点的选项）；
                · `x:Name` 也已经错开（弹窗那边统一带 Panel 前缀，有测试钉"两页的 x:Name 集合不相交"）。
                谁把弹窗那几行复制回这一页，这两样都要一起改对。
            -->

            <!--
                ①页那个「空间不足」开关开着时的**覆盖提示**（用户 2026-09-27）：
                这一页正是他核对"源包怎么处理、其余物怎么删"的地方 —— 只写在①页等于没写，
                他翻到这里看到的仍是设置里的黑点，就会读成"程序没按我看到的跑"。
                关着时整行收起（判据是 HasSpaceTightOverride，与文本同时通知）。
            -->
            <Border Style="{StaticResource WarningBannerStyle}"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasSpaceTightOverride, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding SpaceTightOverrideText}"
                           Style="{StaticResource BannerTextStyle}"
                           Foreground="{StaticResource DangerTextBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- ==================== 1 源包操作 ==================== -->
            <!--
                ⚠ 2026-10-15（用户 2026-10-14 口径）：源包操作**只有两个选项**——
                「留下」与「彻底删除」，而且**彻底删除是就地删、⛔ 不搬进其余物**
                （用户逐字：「原包一直在原来的位置，选『彻底删除』也是就地删、不用移入其余物」）。
                原来那一档「放入其余物当中」整条删除。
                ⛔ 两者都**仅仅针对成功**：失败 / 部分完成 / 取消 ⇒ 一个字节都不动（不变量 1）。
            -->
            <GroupBox Header="1 源包操作（成功解完之后拿源包怎么办）">
                <StackPanel>
                    <RadioButton x:Name="SourceKeepInPlaceOption"
                                 GroupName="SourceHandling"
                                 IsChecked="{Binding SettingsEditor.SourceHandling, Converter={StaticResource EnumOptionConverter}, ConverterParameter=KeepInPlace, Mode=TwoWay}"
                                 Content="留下（默认，原来的位置不动）" />

                    <RadioButton x:Name="SourceDeleteOption"
                                 GroupName="SourceHandling"
                                 Margin="0,6,0,0"
                                 Foreground="{StaticResource DangerTextBrush}"
                                 IsChecked="{Binding SettingsEditor.SourceHandling, Converter={StaticResource EnumOptionConverter}, ConverterParameter=DeleteInPlace, Mode=TwoWay}"
                                 Content="彻底删除（就地删掉源包，不可恢复；⛔ 不搬进其余物）" />

                                        <controls:BoxDetail Header="{x:Static models:StatusText.BoxDetailSourceHandlingHeader}"
                                        Detail="{x:Static models:StatusText.BoxDetailSourceHandlingDetail}" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 2 最后一层过程物操作 ==================== -->
            <GroupBox Header="2 最后一层过程物操作（失败 / 部分完成时，链停下那一层的包怎么办）">
                <StackPanel>
                    <RadioButton x:Name="RestKeepOption"
                                 GroupName="RestHandling"
                                 IsChecked="{Binding SettingsEditor.RestHandling, Converter={StaticResource EnumOptionConverter}, ConverterParameter=Keep, Mode=TwoWay}"
                                 Content="留下（默认，留在原地，不占额外动作）" />

                    <RadioButton x:Name="RestDeleteOption"
                                 GroupName="RestHandling"
                                 Margin="0,6,0,0"
                                 Foreground="{StaticResource DangerTextBrush}"
                                 IsChecked="{Binding SettingsEditor.RestHandling, Converter={StaticResource EnumOptionConverter}, ConverterParameter=Delete, Mode=TwoWay}"
                                 Content="彻底删除，直接省空间（不可恢复）" />

                    <!--
                        选「彻底删除」时下面**常驻**一条提示（用户 2026-09-25 第 32 条原话：
                        "当用户点击了彻底删除那个选项时就会在下面出现一个提示的选项，而且不能消掉，
                        用户选择了就一直放在那"）—— 没有关闭按钮，只有把选项改回去它才消失。
                    -->
                    <Border Style="{StaticResource WarningBannerStyle}"
                            Margin="0,8,0,0"
                            Visibility="{Binding SettingsEditor.IsRestDeleteSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource BannerTextStyle}"
                                   Foreground="{StaticResource DangerTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="⚠ 彻底删除不可恢复：只作用于失败 / 部分完成时链停下那一层要解的包（最后一层过程物）。成功链上的其他过程物本来就按固定规则当场删除；失败 / 取消的源包一个字节都不动。" />
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- 手工清理已按用户 2026-11-04 口径整组移到「手动操作」窗口；本页只留源包/过程物两档。 -->

        </StackPanel>
    </ScrollViewer>
</UserControl>
