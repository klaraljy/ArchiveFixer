<UserControl x:Class="ArchiveFixer.Views.Tabs.CleanupTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ArchiveFixer.Models">

    <!--
        ③ 清理与删除页（用户 2026-09-24 第 11 条；2026-09-25 第 32 条按用户口述重排）。
        两组单选，按用户原话摆：
          1 源包操作：1_原来的位置不动（默认） 2_放入其余物当中
          2 删除操作：1_不动其余物（默认）     2_移入回收站     3_彻底删除（红字，选它时下面常驻一条提示）
        下面是手工清理入口 / 提醒 / 工作区残留 —— 都只认勾选。
        整页可滚（第 20 条），没有任何固定高度堆叠。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!--
                ⚠ 这一页的单选按钮与「一键处理 · 确认」那个弹窗（Views\OneClickOptionsWindow.xaml）里
                是**同一组档位**，两处的 `x:Name` 现在重名、`GroupName` 已经隔开
                （这里是 SourceHandling / RestHandling，弹窗那边是 PanelSourceHandling / PanelRestHandling）。
                ⛔ 第 34 条那次真机事故就是"两个窗口共用 GroupName"—— 谁把弹窗那几行复制回这一页，
                必须把 `Panel` 前缀一起丢掉、并确认 `x:Name` 不与这一页重名（同一个窗口里重名会直接报错，
                跨文件重名不会报错但下次就分不清谁是谁）。
            -->

            <!-- ==================== 1 源包操作 ==================== -->
            <GroupBox Header="1 源包操作（解完之后拿源包怎么办）">
                <StackPanel>
                    <RadioButton x:Name="SourceKeepInPlaceOption"
                                 GroupName="SourceHandling"
                                 IsChecked="{Binding SettingsEditor.SourceHandling, Converter={StaticResource EnumOptionConverter}, ConverterParameter=KeepInPlace, Mode=TwoWay}"
                                 Content="原来的位置不动（默认）" />

                    <RadioButton x:Name="SourceMoveToRestOption"
                                 GroupName="SourceHandling"
                                 Margin="0,6,0,0"
                                 IsChecked="{Binding SettingsEditor.SourceHandling, Converter={StaticResource EnumOptionConverter}, ConverterParameter=MoveToRest, Mode=TwoWay}"
                                 Content="放入其余物当中（和中间件一起放进成品目录的「其余物」）" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="只有「内容物已定稿 + 输出校验通过 + 未取消」三条同时成立才动源包；失败 / 部分完成 / 取消时源包一律原地不动。" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 2 删除操作 ==================== -->
            <GroupBox Header="2 删除操作（解压成功后，成品目录里的「其余物」怎么办）">
                <StackPanel>
                    <RadioButton x:Name="RestKeepOption"
                                 GroupName="RestHandling"
                                 IsChecked="{Binding SettingsEditor.RestHandling, Converter={StaticResource EnumOptionConverter}, ConverterParameter=Keep, Mode=TwoWay}"
                                 Content="不动其余物（默认）" />

                    <RadioButton x:Name="RestRecycleOption"
                                 GroupName="RestHandling"
                                 Margin="0,6,0,0"
                                 IsChecked="{Binding SettingsEditor.RestHandling, Converter={StaticResource EnumOptionConverter}, ConverterParameter=RecycleBin, Mode=TwoWay}"
                                 Content="动，但只移到回收站（可还原；空间要等清空回收站才释放）" />

                    <RadioButton x:Name="RestDeleteOption"
                                 GroupName="RestHandling"
                                 Margin="0,6,0,0"
                                 Foreground="{StaticResource DangerTextBrush}"
                                 IsChecked="{Binding SettingsEditor.RestHandling, Converter={StaticResource EnumOptionConverter}, ConverterParameter=Delete, Mode=TwoWay}"
                                 Content="动，而且是彻底删除，直接省空间" />

                    <!--
                        选「彻底删除」时下面**常驻**一条提示（用户 2026-09-25 第 32 条原话：
                        "当用户点击了彻底删除那个选项时就会在下面出现一个提示的选项，而且不能消掉，
                        用户选择了就一直放在那"）—— 没有关闭按钮，只有把选项改回去它才消失。
                    -->
                    <Border Style="{StaticResource WarningBannerStyle}"
                            Margin="0,8,0,0"
                            Visibility="{Binding SettingsEditor.IsRestDeleteSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource BannerTextStyle}"
                                   Foreground="{StaticResource DangerTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="⚠ 彻底删除不可恢复：任务成功后，它的其余物（中间件，以及按上面选择搬进去的源包）会被永久删除，不进回收站。失败 / 部分完成 / 取消的任务一个字节都不删。" />
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- ==================== 手工清理 + 手工删除的默认档 ==================== -->
            <GroupBox Header="手工清理（只作用于勾选的任务，删除前先预览 + 确认）">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="手工删除时的默认："
                                   Style="{StaticResource LabelTextStyle}"
                                   ToolTip="只决定「删除其余物…」确认框里那个「改为彻底删除」勾选框的默认状态，不影响解压时的行为。" />

                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding SettingsEditor.Settings.RestRemovalDefaultMode, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Foreground="{StaticResource DangerTextBrush}"
                                  ToolTip="无论哪一档，删除前都先预览 + 确认；彻底删除还要二次确认。">
                            <ComboBoxItem Content="移入回收站（默认，可从回收站还原）" Tag="RecycleBin" />
                            <ComboBoxItem Content="彻底删除（不可恢复，仍要二次确认）" Tag="Permanent" />
                        </ComboBox>
                    </Grid>

                    <Border Background="{StaticResource DangerSoftBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="{StaticResource BannerPadding}"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="手工删除入口（一律只认勾选：一个都没勾就什么都不做）"
                                       Style="{StaticResource CardTitleTextStyle}"
                                       Foreground="{StaticResource DangerTextBrush}" />

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="删除其余物…"
                                        Style="{StaticResource DangerOutlineButtonStyle}"
                                        ToolTip="删除勾选的每个任务自己那一份「其余物」（内层归档 / 分卷 / 中间件 / 源包）。先预览条目数、总大小与源包个数。"
                                        Command="{Binding CleanProcessArtifactsCommand}" />

                                <Button Content="删除本目录全部其余物…"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource DangerOutlineButtonStyle}"
                                        ToolTip="删除目标任务输出目录下的全部其余物，会影响同目录里的所有包 —— 确认框里会点名影响几个包。"
                                        Command="{Binding CleanAllProcessArtifactsCommand}" />

                                <Button Content="清理空文件夹…"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource DangerOutlineButtonStyle}"
                                        ToolTip="清理勾选的每个任务输出根下「任意层级都没有文件」的子目录。先预览，默认移入回收站。"
                                        Command="{Binding CleanEmptyFoldersCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="「手工删除时的默认」只是确认框的默认值，不是「跳过确认」；回收站不可用时（网络盘 / 策略禁用）一律不删并说明原因，绝不会因此降级成彻底删除。" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 解压前的提醒 ==================== -->
            <GroupBox Header="提醒">
                <StackPanel>
                    <CheckBox Content="{x:Static models:StatusText.SettingsRemindBeforeExtractLabel}"
                              IsChecked="{Binding SettingsEditor.Settings.RemindBeforeExtract, Mode=TwoWay}"
                              ToolTip="{x:Static models:StatusText.SettingsRemindBeforeExtractHint}" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="22,4,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SettingsRemindBeforeExtractHint}" />

                    <!--
                        第 15 条：导入文件夹后**立刻**提醒一次无用物（与上面那条解压前的提醒是两件事：
                        这一条管"选完文件夹就说"，上面那条管"动手解压前再说一次"，两个开关各自可关）。
                    -->
                    <CheckBox Margin="0,10,0,0"
                              Content="{x:Static models:StatusText.SettingsRemindJunkAfterImportLabel}"
                              IsChecked="{Binding SettingsEditor.Settings.RemindJunkAfterImport, Mode=TwoWay}"
                              ToolTip="{x:Static models:StatusText.SettingsRemindJunkAfterImportHint}" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="22,4,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SettingsRemindJunkAfterImportHint}" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 工作区残留（第 22 条 + 第 25 条追加） ==================== -->
            <GroupBox Header="{x:Static models:StatusText.WorkspaceLeftoverGroupHeader}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.WorkspaceLeftoverGroupHint}" />

                    <!--
                        第 25 条追加（用户原话："我不希望有这么多的失败残留……如果解压 40G，两层，
                        解压失败有 80G 的卸载残留"）：默认关 = 失败 / 取消一个中间产物都不留；
                        打开才留现场，而且就留在本页上面那一行里、随时可清。
                    -->
                    <CheckBox Margin="0,10,0,0"
                              Content="{x:Static models:StatusText.SettingsKeepFailedWorkspaceLabel}"
                              IsChecked="{Binding SettingsEditor.Settings.KeepFailedWorkspace, Mode=TwoWay}"
                              ToolTip="{x:Static models:StatusText.SettingsKeepFailedWorkspaceHint}" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="22,4,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SettingsKeepFailedWorkspaceHint}" />

                    <!-- 有残留时才显示这一行（几个 + 共多少），没有就整块不出现 -->
                    <TextBlock Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding WorkspaceLeftoverBanner}"
                               Visibility="{Binding HasWorkspaceLeftovers, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="清理工作区…"
                                MinWidth="112"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="列出每个残留目录的体积与文件数，二次确认之后删掉（只动工作区根目录下的那些任务目录）"
                                Command="{Binding ClearWorkspaceLeftoversCommand}" />

                        <Button Content="打开工作区目录"
                                MinWidth="124"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="在资源管理器里看一眼那些残留（程序不会自动删它们）"
                                Command="{Binding OpenWorkDirectoryCommand}" />
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
