<UserControl x:Class="ArchiveFixer.Views.Tabs.TaskTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ArchiveFixer.Models">

    <!--
        ① 任务页（用户 2026-09-24 第 11 条）：这里是主界面的**主线** ——
        「选任务 → 点一键处理 → 看结果」。并发档、空间管理、危险模式红横幅、
        输出位置那一大块都已经搬去「解压方式」页，这一页不再放它们。

        行结构（第 20 条：窗口拉大时控件要跟着合理伸缩）：
          Auto  危险模式的一行小白字（开启时才出现，不再是红横幅）
          Auto  主操作条
          Auto  手动操作（默认收起）
          72*   任务列表（MinHeight 160：分隔条拖到底也不会把列表压没）
          Auto  GridSplitter（6px，上下拖）
          28*   日志区（默认约占本页高度 28%）
          Auto  汇总一行
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="620" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!--
                比例（用户 2026-09-26："将界面比例调整好"）：列表拿大头（78*）、日志 22* ——
                勾选那一排搬到列表上方之后，主操作条回到一行，列表又多了十几像素；
                日志那一条仍然够看三五行，需要看全的时候有「日志放大」。
            -->
            <RowDefinition Height="78*" MinHeight="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LogRow" Height="22*" MinHeight="72" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 主操作条 ============ -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="添加文件"
                            MinWidth="92"
                            Command="{Binding AddFilesCommand}"
                            ToolTip="{x:Static models:StatusText.AddReplacesListHint}" />

                    <Button Content="添加文件夹"
                            MinWidth="100"
                            Margin="8,0,0,0"
                            Command="{Binding AddFolderCommand}"
                            ToolTip="{x:Static models:StatusText.AddReplacesListHint}" />
                </StackPanel>

                <!--
                    第 27 条：「输出位置」那一格就在「添加文件夹」与「全选」**之间**（用户原话：
                    "输出的指定位置可以放在主界面进行选择……在添加文件夹和全选中间还有那么多的位置"）——
                    刻意**不**塞进右边那串按钮里。

                    用户 2026-10-26：输出位置**只在本页这一处**（②「解压方式」页那组重复入口已删）；
                    三个部件：只读的当前路径（**中间省略**：前三段 + \...\ + 末两段，完整路径在
                    ToolTip 与右键菜单里；"反正我要求的就是我们最好能够看到完整的解压地址"）、
                    「选择…」、「未指定位置」开关。

                    两个约束落在属性上：
                    · 空间不够时先压这一格（路径 TextTrimming + 单元格 ClipToBounds），
                      **不许**把右边的「全选 / 一键处理」挤走；
                    · 绑的是 MainViewModel 上那两个属性（Settings.ExtractToOriginalDirectory +
                      Settings.CustomOutputDirectory），不新开字段、不各存一份。
                -->
                <Grid Grid.Column="1" Margin="12,0" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Static models:StatusText.OutputLocationLabel}"
                               Style="{StaticResource LabelTextStyle}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Margin="6,0,0,0"
                               MinWidth="160"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFontFamily}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding OutputLocationDisplay}"
                               ToolTip="{Binding OutputLocationToolTip}">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static models:StatusText.OutputLocationCopyMenuText}"
                                          Command="{Binding PlacementTarget.DataContext.CopyOutputLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>

                    <Button Grid.Column="2"
                            Content="{x:Static models:StatusText.OutputLocationChooseButtonText}"
                            MinWidth="72"
                            Margin="8,0,0,0"
                            ToolTip="挑一个统一的输出位置"
                            Command="{Binding SelectOutputDirectoryCommand}" />

                    <CheckBox Grid.Column="3"
                              Content="{x:Static models:StatusText.OutputLocationFollowsArchiveLabel}"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding OutputLocationFollowsArchive, Mode=TwoWay}"
                              ToolTip="{x:Static models:StatusText.OutputLocationFollowsArchiveHint}" />
                </Grid>

                <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!--
                        第 16 条追加：上一批撞到 10 层上限时，这一颗才出现（HasPendingContinuation）。
                        它复用一键处理本身 —— 剩下的内层包在上批结束时已经加进列表并勾好了。
                    -->
                    <Button Content="{Binding ContinueOneClickButtonText}"
                            MinWidth="150"
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            ToolTip="接着把上批剩下的内层包解下去（每批最多 10 层）"
                            Visibility="{Binding HasPendingContinuation, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding ContinueOneClickCommand}" />

                    <!-- 忙的时候才出现：空闲时是两个永远按不动的灰按钮，占位又误导 -->
                    <Button Content="停止后续"
                            Margin="0,0,8,0"
                            ToolTip="不再启动新任务、不再进入下一轮；正在跑的任务在下一个安全点停下（密码候选之间、写完当前条目之后），不是立刻杀进程。要立刻掐断当前任务，点右边「取消当前」。"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding StopCommand}" />

                    <Button Content="取消当前"
                            Margin="0,0,8,0"
                            ToolTip="立刻掐断当前这一单（含它启动的外部进程），只影响当前任务，不会取消还没启动的任务；取消后不能原地继续。失败或取消后工作区默认整份清掉，只有「设置」页打开「失败时保留中间产物」才留现场。"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding CancelCurrentCommand}" />

                    <!--
                        ── 空间不足开关（用户 2026-09-27 拍板：放在「一键处理」左边，黄色）──

                        三件事必须一眼看得出来（所以是黄字 + ToolTip 全文）：
                        ① 它是**这一次运行**的开关，不写设置、不记忆（关掉程序就没了）；
                        ② 它会让程序**永久删除源包**（定稿 + 校验通过的那一刻）；
                        ③ 它会覆盖并发档与「全速」。
                        ⛔ 它绝不是一个"设置"：绑的是 MainViewModel.SpaceTightMode（纯运行期字段）。
                    -->
                    <CheckBox Content="{x:Static models:StatusText.SpaceTightToggleLabel}"
                              Margin="0,0,10,0"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource WarningTextBrush}"
                              IsChecked="{Binding SpaceTightMode, Mode=TwoWay}"
                              ToolTip="{x:Static models:StatusText.SpaceTightToggleToolTip}" />

                    <!--
                        ── 「不删原包」= 上面那个模式的**安全档**（用户 2026-09-27：
                        "所有测试的情况下弄一个设置不删除原包的功能，在空间不足旁边弄一个，
                        空间不足但是不删除原包的操作"）──

                        他的顾虑是原话："源包讲实话，这个功能才刚刚弄我怕会出现意外，
                        导致没成功而且原包也没有了，这样的话就太亏了"。
                        所以这一档：并发与排序照旧由空间决定，但**源包一个字节都不动**。
                        勾上它会把「空间不足」也一起勾上（见 MainViewModel 里那对耦合，值 + 通知都发）。
                    -->
                    <CheckBox Content="{x:Static models:StatusText.SpaceTightKeepSourceLabel}"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Foreground="{StaticResource WarningTextBrush}"
                              IsChecked="{Binding SpaceTightKeepSource, Mode=TwoWay}"
                              Visibility="{Binding IsSpaceTightKeepSourceAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                              ToolTip="{x:Static models:StatusText.SpaceTightKeepSourceToolTip}" />

                    <Button Content="手动操作"
                            MinWidth="84"
                            Margin="0,0,8,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="显示/隐藏右侧当前任务检查器。默认隐藏；只处理当前选中的一行，不影响一键处理。"
                            Command="{Binding ToggleManualPanelCommand}" />

                    <Button Content="一键处理"
                            MinWidth="128"
                            MinHeight="36"
                            FontSize="15"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="对勾选的任务依次做：识别格式 → 修正伪装后缀（自动改，不弹预览；改名结果逐条写在日志里）→ 按密码本解压 → 汇总结果"
                            Command="{Binding OneClickProcessCommand}" />

                    <!--
                        特定解压总开关（用户 2026-09-24 原话："我是想在一键解压旁边弄一个特定解压开关"）。
                        规则在②「解压方式」页那一栏里逐条挑；ToolTip 列出当前生效的规则
                        （一条都没开就提示去②页挑）—— 关掉它 = 一键处理的行为与现在逐字相同。

                        ⚠ 直接绑设置对象那一格（与②页「危险模式」那个开关同一写法）：它不需要
                        "勾一下就让别的控件跟着变"，而这一页要绑的正是**那个**设置项本身。
                    -->
                    <CheckBox Content="{x:Static models:StatusText.SpecialExtractionToggleLabel}"
                              Margin="12,0,0,0"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              IsChecked="{Binding SettingsEditor.Settings.UseSpecialExtraction, Mode=TwoWay}"
                              ToolTip="{Binding SettingsEditor.SpecialExtractionToolTip}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ============ 任务列表 ============ -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <DockPanel>
                <!--
                    勾选那一排（用户 2026-09-26："现在将一键处理那一行里有四个对文件操作的选项框给移到下面来，
                    移动到列表板块上端，这个之前占着绝大部分的位置，我输出的目录文件位置都挡的看不见了"）。

                    为什么就该在这一排：全选 / 全不选 / 反选 / 移除勾选的**只作用于这张列表**，
                    放在主操作条上既挤走了「输出位置」那条路径、又让"选任务"和"选文件"两件事混在一行。
                    ⛔ 主操作条现在只留：添加文件 / 添加文件夹 / 输出位置 / 只解压 / 一键处理 / 特定解压。
                -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CardCornerRadiusTop}"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="勾选："
                                   Style="{StaticResource LabelTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />

                        <Button Content="全选"
                                MinWidth="60"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="勾选列表里的全部任务（Ctrl+A）"
                                Command="{Binding SelectAllTasksCommand}" />

                        <Button Content="全不选"
                                MinWidth="68"
                                Margin="6,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="取消全部勾选（Ctrl+D）—— 想只解其中一个时，先点这里再点那一行"
                                Command="{Binding SelectNoneTasksCommand}" />

                        <Button Content="反选"
                                MinWidth="60"
                                Margin="6,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="勾上的取消、没勾的勾上（Ctrl+I）"
                                Command="{Binding InvertTaskSelectionCommand}" />

                        <!--
                            第 15 条："列表要能删无用物"。只动列表，源文件不动 ——
                            所以它和勾选那三个挨着，语气也是普通的（不是红色危险按钮）。
                        -->
                        <Button Content="移除勾选的"
                                MinWidth="88"
                                Margin="6,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="{Binding RemoveCheckedTasksTooltip}"
                                ToolTipService.ShowOnDisabled="True"
                                Command="{Binding RemoveCheckedTasksCommand}" />

                        <!--
                            勾选合计（用户 2026-09-27："显示选中文件的大小……这样用户就能更好的察觉"）：
                            只读、跟着勾选实时变；一个都没勾时说清"没有勾选任何任务"，⛔ 不留空白。
                        -->
                        <TextBlock Text="{Binding SelectedTasksSummary}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Top"
                        Background="{StaticResource InfoSoftBrush}"
                        BorderBrush="{StaticResource InfoBorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CardCornerRadiusTop}"
                        Padding="12,7">
                    <TextBlock Foreground="{StaticResource InfoTextBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SelectionScopeHint}" />
                </Border>

                <Grid>
                    <DataGrid x:Name="TaskDataGrid"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                              SelectionMode="Extended"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Margin="8,4,8,8"
                              PreviewMouseRightButtonDown="TaskDataGrid_PreviewMouseRightButtonDown">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开文件所在目录"
                                          Command="{Binding PlacementTarget.DataContext.OpenTaskDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="打开输出目录"
                                          Command="{Binding PlacementTarget.DataContext.OpenTaskOutputDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="打开其余物目录"
                                          Command="{Binding PlacementTarget.DataContext.OpenTaskArtifactDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <Separator />

                                <MenuItem Header="只勾选这一个"
                                          ToolTip="取消其它任务的勾选，只留下当前这一行"
                                          Command="{Binding PlacementTarget.DataContext.SelectSoleTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="全选（Ctrl+A）"
                                          Command="{Binding PlacementTarget.DataContext.SelectAllTasksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="全不选（Ctrl+D）"
                                          Command="{Binding PlacementTarget.DataContext.SelectNoneTasksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <Separator />

                                <MenuItem Header="复制文件路径"
                                          Command="{Binding PlacementTarget.DataContext.CopyTaskPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="复制错误信息"
                                          Command="{Binding PlacementTarget.DataContext.CopyTaskErrorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="复制任务信息"
                                          Command="{Binding PlacementTarget.DataContext.CopyTaskInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <Separator />

                                <MenuItem Header="重新扫描此文件"
                                          Command="{Binding PlacementTarget.DataContext.RescanTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="智能修正此文件后缀"
                                          Click="SmartRenameCurrentTaskMenuItem_Click" />

                                <MenuItem Header="查看任务详情"
                                          Click="TaskDetailMenuItem_Click" />

                                <Separator />

                                <MenuItem Header="移除勾选中的任务"
                                          Command="{Binding PlacementTarget.DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="清空列表"
                                          Command="{Binding PlacementTarget.DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="从列表移除这一行"
                                          Command="{Binding PlacementTarget.DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="选择" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalAlignment="Stretch"
                                                  VerticalContentAlignment="Center"
                                                  Margin="0"
                                                  ToolTip="一次点击即勾选 / 取消勾选。勾选后才会被「一键处理 / 智能修正」等按钮处理" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="文件名"
                                                Binding="{Binding DisplayFileName}"
                                                Width="180"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding DisplayPathToolTip}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!--
                                「大小」紧跟文件名（用户 2026-09-27："应该改在列表管理里面显示选中文件的大小，
                                就排在文件名后面，这样用户就能更好的察觉"）。
                                值由 ArchiveTask.RefreshSourceSize 采集（任务创建 / 改名 / 重扫三条路都会刷新），
                                读不到时显示「-」，⛔ 不显示 0 字节。

                                ⚠ 宽度 118（用户 2026-09-27 第二次追加："将列表里面的表示文件大小的那列弄宽一点，
                                这个单位都不好看清，只是这样的 312.64MiB 要全部显示出来"）：
                                `1112.53 MiB` 这种 11 个字符的最长形状 + 右对齐那 8px 外边距 + 单元格内边距 ——
                                之前 90 会把它截成 `312.64Mi…`。⛔ 别再收窄。
                            -->
                            <DataGridTextColumn Header="大小"
                                                Binding="{Binding DisplaySizeText}"
                                                Width="118"
                                                MinWidth="118"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                        <Setter Property="ToolTip" Value="源文件大小（分卷按这一行文件算；整组体积见空间提示与任务详情）" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="完整路径"
                                                Binding="{Binding DisplayPath}"
                                                Width="200"
                                                Visibility="Collapsed"
                                                IsReadOnly="True" />

                            <DataGridTextColumn Header="当前后缀"
                                                Binding="{Binding DisplayExtension}"
                                                Width="100"
                                                IsReadOnly="True" />

                            <DataGridTextColumn Header="检测格式"
                                                Binding="{Binding DetectedFormatDisplay}"
                                                Width="90"
                                                IsReadOnly="True" />

                            <DataGridTextColumn Header="后缀状态"
                                                Binding="{Binding ExtensionStatus}"
                                                Width="190"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip">
                                            <Setter.Value>
                                                <TextBlock>
                                                    <!-- Run.Text 在 WPF 里默认 TwoWay，绑到只读属性会在模板实例化时崩（必须写 OneWay） -->
                                                    <Run Text="当前后缀：" /><Run Text="{Binding CurrentExtension, Mode=OneWay}" /><LineBreak />
                                                    <Run Text="检测格式：" /><Run Text="{Binding DetectedFormat, Mode=OneWay}" /><LineBreak />
                                                    <Run Text="建议后缀：" /><Run Text="{Binding SuggestedExtension, Mode=OneWay}" /><LineBreak />
                                                    <Run Text="分卷：" /><Run Text="{Binding DisplayVolumeInfoText, Mode=OneWay}" />
                                                </TextBlock>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!--
                                分卷这一列**必须看得见**（用户 2026-10-02 拍板："名字上明确是同一组的分卷
                                ⇒ 一律只留一行，并在那一行注明「这一组共 N 卷」"）：以前它
                                Visibility="Collapsed"，"4 卷"这几个字只藏在悬停提示与详情窗里，
                                用户在①页读到的是"两个一模一样的 111.part1.rar"——看不出这一行代表几卷。
                            -->
                            <DataGridTextColumn Header="分卷"
                                                Binding="{Binding DisplayVolumeInfoText}"
                                                Width="200"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding DisplayVolumeInfoText}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="密码状态"
                                                Binding="{Binding PasswordStatus}"
                                                Width="110"
                                                IsReadOnly="True" />

                            <DataGridTextColumn Header="输出目录"
                                                Binding="{Binding OutputPath}"
                                                Width="240"
                                                Visibility="Collapsed"
                                                IsReadOnly="True" />

                            <DataGridTemplateColumn Header="状态" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusDisplayText}"
                                                   Foreground="{Binding StatusColorKey, Converter={StaticResource StatusToBrushConverter}}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StatusDisplayText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="错误信息"
                                                Binding="{Binding DisplayErrorMessage}"
                                                Width="*"
                                                MinWidth="200"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <!--
                                            悬停要能看全（用户 2026-09-28）：直接绑字符串的 ToolTip 是**单行**的，
                                            窄窗口下那条长错误信息会一路顶到屏幕外，等于看不了。
                                            换成带 Wrap + MaxWidth 的 TextBlock，长文案在气泡里自己折行。
                                        -->
                                        <Setter Property="ToolTip">
                                            <Setter.Value>
                                                <!--
                                                    ⛔ 悬停提示必须绑**显示口径**的那一份（`DisplayErrorMessage`）：
                                                    绑裸 `ErrorMessage` 时，格子里是空的、气泡里却冒出
                                                    "已完成 3 层递归解压…"（用户 2026-10-07：「显示的问题，
                                                    根本就没有同步」）。
                                                -->
                                                <TextBlock Text="{Binding DisplayErrorMessage}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="560" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="耗时"
                                                Binding="{Binding ElapsedText}"
                                                Width="80"
                                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空状态：不要给用户一张空白表格 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="还没有任务"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   HorizontalAlignment="Center" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   TextAlignment="Center"
                                   MaxWidth="460"
                                   Text="点上面的「添加文件 / 添加文件夹」，或把文件、文件夹直接拖进这个窗口。" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ 日志与列表之间的分隔条（第 18 条：能上下拖） ============ -->
        <GridSplitter x:Name="LogSplitter"
                      Grid.Row="4"
                      Height="6"
                      Margin="0,2,0,2"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ToolTip="上下拖动可以改变日志区的高度" />

        <!-- ============ 日志区 ============ -->
        <Grid x:Name="LogArea" Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource GroupHeaderBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="{StaticResource CardCornerRadiusTop}"
                    Padding="12,6">
                <DockPanel>
                    <TextBlock Text="日志"
                               Style="{StaticResource CardTitleTextStyle}"
                               VerticalAlignment="Center" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="日志放大"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="把日志开到独立窗口里看（主界面这一块保持原样）"
                                Click="OpenLogWindowButton_Click" />

                        <Button x:Name="LogToggleButton"
                                Content="收起"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="收起日志区，把高度让给任务列表（也可以拖中间那条分隔条）"
                                Click="ToggleLogAreaButton_Click" />

                        <Button Content="复制失败列表"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding CopyFailedListCommand}" />

                        <Button Content="导出失败清单"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="把失败任务与原因导出成 txt，便于逐条处理或留档"
                                Command="{Binding ExportFailedListCommand}" />

                        <!--
                            用户 2026-09-25 第 37 条："导出所有日志才是最关键的"——他要的是**全部**日志（每一份都导），
                            不是只导这一次的。放在失败清单旁边：出问题的那一刻就能一键带走。
                        -->
                        <Button Content="导出日志（本次）"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="只导出「最近一次操作」的日志（从日志里那行「本次操作开始」起），排查时一眼到底，不用翻历史"
                                Command="{Binding ExportLogCommand}" />

                        <Button Content="打开输出目录"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding OpenOutputDirectoryCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadiusBottom}"
                    Padding="4">
                <ListBox x:Name="LogList"
                         ItemsSource="{Binding Logs}"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--
                                按级别上色（用户 2026-09-26："用不同颜色的字体……红色、黄色、黑色字体，
                                表示危险、警告、正常的操作"）：红 = ERROR、黄 = WARN、黑 = INFO。
                                唯一实现是 StatusToBrushConverter（任务状态列同一份口径）。
                            -->
                            <TextBlock TextWrapping="NoWrap"
                                       Foreground="{Binding Level, Converter={StaticResource StatusToBrushConverter}}">
                                <!--
                                    ⚠ 必须显式写 Mode=OneWay：Run.Text 在 WPF 里**默认是 TwoWay**，
                                    而 TimeText 是只读计算属性，不写会在模板实例化时抛 XamlParseException。
                                -->
                                <Run Text="{Binding TimeText, Mode=OneWay, StringFormat=[{0}]}" />
                                <Run Text=" [" />
                                <Run Text="{Binding Level, Mode=OneWay}" />
                                <Run Text="] " />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ============ 汇总区 ============ -->
        <!-- ============ 当前任务检查器（右侧） ============ -->
        <Border Grid.Row="3"
                Grid.Column="1"
                Grid.RowSpan="4"
                Width="360"
                Style="{StaticResource CardStyle}"
                Padding="12"
                Margin="8,0,0,8"
                Visibility="{Binding IsManualPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="当前任务"
                                   Style="{StaticResource LabelTextStyle}"
                                   VerticalAlignment="Center" />
                        <Button Content="收起"
                                HorizontalAlignment="Right"
                                Padding="8,2"
                                Style="{StaticResource LinkButtonStyle}"
                                ToolTip="隐藏当前任务检查器"
                                Command="{Binding ToggleManualPanelCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding SelectedTask.LogName, TargetNullValue=未选中任务}"
                               Style="{StaticResource CardTitleTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SelectedTask.CurrentPath}"
                               Margin="0,2,0,2" />

                    <TextBlock Text="{Binding SelectedTask.StatusDisplayText, TargetNullValue=先在左侧列表选中一行}"
                               Style="{StaticResource HintTextStyle}" />

                    <TextBlock Text="{Binding SelectedTask.ProgressDetail}"
                               Style="{StaticResource HintTextStyle}"
                               Margin="0,2,0,0" />

                    <Border Height="1"
                            Background="{StaticResource DividerBrush}"
                            Margin="0,10,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="格式" Style="{StaticResource StatLabelTextStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTask.DetectedFormatDisplay}" Style="{StaticResource ValueTextStyle}" Margin="10,0,0,0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="大小" Style="{StaticResource StatLabelTextStyle}" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTask.SourceSizeText}" Style="{StaticResource ValueTextStyle}" Margin="10,4,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="分卷" Style="{StaticResource StatLabelTextStyle}" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTask.VolumeInfoText}" Style="{StaticResource ValueTextStyle}" Margin="10,4,0,0" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="输出" Style="{StaticResource StatLabelTextStyle}" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTask.OutputPath}" Style="{StaticResource ValueTextStyle}" Margin="10,4,0,0" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Text="{Binding SelectedTask.ErrorMessage}"
                               Foreground="{StaticResource DangerTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <TextBlock Text="{Binding SelectedTask.VolumeRenameSuggestion}"
                               Foreground="{StaticResource WarningTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <TextBlock Text="同组文件"
                               Style="{StaticResource LabelTextStyle}"
                               Margin="0,10,0,2" />
                    <ItemsControl ItemsSource="{Binding SelectedTask.VolumePaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Style="{StaticResource HintTextStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="缺失卷"
                               Style="{StaticResource LabelTextStyle}"
                               Margin="0,6,0,2" />
                    <ItemsControl ItemsSource="{Binding SelectedTask.MissingVolumeNames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{StaticResource WarningTextBrush}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="重新扫描当前任务"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            ToolTip="重新识别当前任务的格式、加密状态与分卷信息"
                            Command="{Binding RescanTaskCommand}"
                            CommandParameter="{Binding SelectedTask}" />

                    <TextBlock Text="手动操作（当前任务）"
                               Style="{StaticResource CardTitleTextStyle}"
                               Margin="0,12,0,2" />

                    <TextBlock Text="查看（只读，不写盘）"
                               Style="{StaticResource LabelTextStyle}"
                               Margin="0,12,0,4" />
                    <WrapPanel>
                        <Button Content="看内容" MinWidth="84"
                                Command="{Binding InspectCurrentTaskCommand}"
                                ToolTip="只列当前任务的清单，不解压、不写盘。" />
                        <Button Content="试密码" MinWidth="84" Margin="6,0,0,0"
                                Command="{Binding TryPasswordsForCurrentTaskCommand}"
                                ToolTip="逐个候选问引擎，只显示候选序号。" />
                        <Button Content="源目录" MinWidth="80" Margin="6,0,0,0"
                                Command="{Binding OpenCurrentSourceDirectoryCommand}"
                                ToolTip="在资源管理器中打开当前源包所在目录。" />
                        <Button Content="复制同组路径" MinWidth="104" Margin="6,0,0,0"
                                Command="{Binding CopyCurrentVolumeGroupPathsCommand}"
                                ToolTip="把当前任务的同组文件路径复制到剪贴板，便于定位缺片。" />
                    </WrapPanel>

                    <TextBlock Text="修正名字（先预览）"
                               Style="{StaticResource LabelTextStyle}"
                               Margin="0,10,0,4" />
                    <WrapPanel>
                        <Button Content="修复分卷名" MinWidth="104"
                                Command="{Binding RepairVolumeNameCurrentTaskCommand}"
                                ToolTip="{x:Static models:StatusText.VolumeRepairButtonToolTip}" />
                        <Button Content="智能修正" MinWidth="88" Margin="6,0,0,0"
                                Command="{Binding SmartRenameCurrentTaskCommand}"
                                ToolTip="按识别结果修正当前任务后缀。" />
                        <Button Content="改名…" MinWidth="76" Margin="6,0,0,0"
                                Command="{Binding ChangeNameCurrentTaskCommand}"
                                ToolTip="自定义替换/添加/删除后缀，先预览。" />
                    </WrapPanel>

                    <TextBlock Text="解压（会写产物）"
                               Style="{StaticResource LabelTextStyle}"
                               Margin="0,10,0,4" />
                    <WrapPanel>
                        <Button Content="只解压这一层" MinWidth="112" FontWeight="SemiBold"
                                Command="{Binding StartExtractCurrentTaskCommand}"
                                ToolTip="只解当前任务这一层，不自动续解。" />
                        <Button Content="{x:Static models:StatusText.ExtractIntoSourceFolderText}"
                                MinWidth="132" Margin="6,0,0,0"
                                Command="{Binding ExtractIntoSourceFolderCurrentTaskCommand}"
                                ToolTip="{x:Static models:StatusText.ExtractIntoSourceFolderToolTip}" />
                    </WrapPanel>
                    <Button Content="把输出目录加入列表（下一层）"
                            HorizontalAlignment="Left"
                            Margin="0,6,0,0"
                            Command="{Binding AddCurrentOutputFolderToTasksCommand}"
                            ToolTip="逐层解压用：把当前输出目录追加到任务列表，再从里面挑下一层包；不会自动递归。" />

                    <TextBlock Text="清理（只对当前任务，先预览确认）"
                               Style="{StaticResource LabelTextStyle}"
                               Margin="0,10,0,4" />
                    <WrapPanel>
                        <Button Content="打开输出目录" MinWidth="104"
                                Command="{Binding OpenCurrentTaskOutputDirectoryCommand}"
                                ToolTip="打开当前任务的成品目录。" />
                        <Button Content="移到回收站…" MinWidth="104" Margin="6,0,0,0"
                                Command="{Binding RecycleCurrentTaskArtifactsCommand}"
                                ToolTip="预览并把当前任务自己的其余物/过程物移入回收站，可还原。" />
                        <Button Content="彻底删除产物…" MinWidth="112" Margin="6,0,0,0"
                                Style="{StaticResource DangerOutlineButtonStyle}"
                                Command="{Binding CleanCurrentTaskArtifactsCommand}"
                                ToolTip="预览并彻底删除当前任务自己的其余物/过程物，不可恢复。" />
                        <Button Content="清理空文件夹…" MinWidth="104" Margin="6,0,0,0"
                                Style="{StaticResource DangerOutlineButtonStyle}"
                                Command="{Binding CleanCurrentTaskEmptyFoldersCommand}"
                                ToolTip="预览并清理当前任务输出根下没有任何文件的子目录。" />
                    </WrapPanel>

                    <TextBlock Text="只作用于当前选中行，不读取复选框。"
                               Style="{StaticResource HintTextStyle}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,8,0,0">
            <StackPanel>
                <!--
                    第 16 条追加：撞到层数上限时这一行必须出现（到顶不许静默停下）——
                    文案由 PendingContinuationText 统一给出（几个没解 + 点哪里继续）。
                -->
                <TextBlock Text="{Binding PendingContinuationText}"
                           Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource DangerTextBrush}"
                           Visibility="{Binding HasPendingContinuation, Converter={StaticResource BoolToVisibilityConverter}}" />

                <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="汇总："
                           Style="{StaticResource CardTitleTextStyle}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />

                <TextBlock Text="总数：" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.TotalCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="选中：" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.SelectedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.Recognized}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.RecognizedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.UnknownFormat}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.UnknownCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.RenameSuccess}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.RenameSuccessCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.RenameFailed}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.RenameFailedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.TestPassed}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.TestSuccessCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.TestFailed}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.TestFailedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.ExtractSuccess}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.ExtractSuccessCount}" Style="{StaticResource StatValueTextStyle}"
                           Foreground="{StaticResource SuccessTextBrush}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.ExtractFailed}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.ExtractFailedCount}" Style="{StaticResource StatValueTextStyle}"
                           Foreground="{StaticResource DangerTextBrush}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.WrongPassword}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.PasswordErrorCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.Corrupted}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.CorruptedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.Skipped}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.SkippedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.Cancelled}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.CancelledCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="其他失败：" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.OtherFailedCount}" Style="{StaticResource StatValueTextStyle}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
