<UserControl x:Class="ArchiveFixer.Views.Tabs.TaskTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ArchiveFixer.Models">

    <!--
        ① 任务页（用户 2026-09-24 第 11 条）：这里是主界面的**主线** ——
        「选任务 → 点一键处理 → 看结果」。并发档、空间管理、危险模式红横幅、
        输出位置那一大块都已经搬去「解压方式」页，这一页不再放它们。

        行结构（第 20 条：窗口拉大时控件要跟着合理伸缩）：
          Auto  危险模式的一行小白字（开启时才出现，不再是红横幅）
          Auto  主操作条
          Auto  手动操作（默认收起）
          72*   任务列表（MinHeight 160：分隔条拖到底也不会把列表压没）
          Auto  GridSplitter（6px，上下拖）
          28*   日志区（默认约占本页高度 28%）
          Auto  汇总一行
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="72*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="LogRow" Height="28*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 主操作条 ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="添加文件"
                            MinWidth="92"
                            Command="{Binding AddFilesCommand}"
                            ToolTip="{x:Static models:StatusText.AddReplacesListHint}" />

                    <Button Content="添加文件夹"
                            MinWidth="100"
                            Margin="8,0,0,0"
                            Command="{Binding AddFolderCommand}"
                            ToolTip="{x:Static models:StatusText.AddReplacesListHint}" />
                </StackPanel>

                <!--
                    第 27 条：「输出位置」那一格就在「添加文件夹」与「全选」**之间**（用户原话：
                    "输出的指定位置可以放在主界面进行选择……在添加文件夹和全选中间还有那么多的位置"）——
                    刻意**不**塞进右边那串按钮里。

                    三个部件：只读的当前路径（**中间省略**：前三段 + \...\ + 末两段，完整路径在
                    ToolTip 与右键菜单里；"反正我要求的就是我们最好能够看到完整的解压地址"）、
                    「选择…」、「未指定位置」开关。

                    两个约束落在属性上：
                    · 空间不够时先压这一格（路径 TextTrimming + 单元格 ClipToBounds），
                      **不许**把右边的「全选 / 一键处理」挤走；
                    · 绑的是 MainViewModel 上那两个属性 —— 与②「解压方式」页是同一份真值
                      （Settings.ExtractToOriginalDirectory + Settings.CustomOutputDirectory），
                      不新开字段、不各存一份。
                -->
                <Grid Grid.Column="1" Margin="12,0" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Static models:StatusText.OutputLocationLabel}"
                               Style="{StaticResource LabelTextStyle}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Margin="6,0,0,0"
                               MinWidth="160"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFontFamily}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding OutputLocationDisplay}"
                               ToolTip="{Binding OutputLocationToolTip}">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static models:StatusText.OutputLocationCopyMenuText}"
                                          Command="{Binding PlacementTarget.DataContext.CopyOutputLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>

                    <Button Grid.Column="2"
                            Content="{x:Static models:StatusText.OutputLocationChooseButtonText}"
                            MinWidth="72"
                            Margin="8,0,0,0"
                            ToolTip="挑一个统一的输出位置（与②「解压方式」页那一格是同一个值）"
                            Command="{Binding SelectOutputDirectoryCommand}" />

                    <CheckBox Grid.Column="3"
                              Content="{x:Static models:StatusText.OutputLocationFollowsArchiveLabel}"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding OutputLocationFollowsArchive, Mode=TwoWay}"
                              ToolTip="{x:Static models:StatusText.OutputLocationFollowsArchiveHint}" />
                </Grid>

                <WrapPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="全选"
                            MinWidth="60"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="勾选列表里的全部任务（Ctrl+A）"
                            Command="{Binding SelectAllTasksCommand}" />

                    <Button Content="全不选"
                            MinWidth="68"
                            Margin="6,0,0,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="取消全部勾选（Ctrl+D）—— 想只解其中一个时，先点这里再点那一行"
                            Command="{Binding SelectNoneTasksCommand}" />

                    <Button Content="反选"
                            MinWidth="60"
                            Margin="6,0,12,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="勾上的取消、没勾的勾上（Ctrl+I）"
                            Command="{Binding InvertTaskSelectionCommand}" />

                    <!--
                        第 15 条："列表要能删无用物"。只动列表，源文件不动 ——
                        所以它摆在勾选那三个按钮旁边，语气也是普通的（不是红色危险按钮）。
                    -->
                    <Button Content="移除勾选的"
                            MinWidth="88"
                            Margin="0,0,12,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="把勾选的任务从列表里去掉（源文件、输出目录、日志一个字节都不动；移除错了再添加一次就回来）"
                            Command="{Binding RemoveCheckedTasksCommand}" />

                    <!--
                        第 16 条追加：上一批撞到 10 层上限时，这一颗才出现（HasPendingContinuation）。
                        它复用一键处理本身 —— 剩下的内层包在上批结束时已经加进列表并勾好了。
                    -->
                    <Button Content="{Binding ContinueOneClickButtonText}"
                            MinWidth="150"
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            ToolTip="接着把上批剩下的内层包解下去（每批最多 10 层）"
                            Visibility="{Binding HasPendingContinuation, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding ContinueOneClickCommand}" />

                    <!-- 忙的时候才出现：空闲时是两个永远按不动的灰按钮，占位又误导 -->
                    <Button Content="停止后续"
                            Margin="0,0,8,0"
                            ToolTip="当前任务继续跑完，但不再启动新任务"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding StopCommand}" />

                    <Button Content="取消当前"
                            Margin="0,0,8,0"
                            ToolTip="强制结束当前任务的外部进程（保留工作区与日志）"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                            Command="{Binding CancelCurrentCommand}" />

                    <Button Content="只解压"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            ToolTip="跳过改后缀这一步，直接对勾选的任务按密码本解压"
                            Command="{Binding StartExtractCommand}" />

                    <Button Content="一键处理"
                            MinWidth="128"
                            MinHeight="36"
                            FontSize="15"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="对勾选的任务依次做：识别格式 → 修正伪装后缀（自动改，不弹预览；改名结果逐条写在日志里）→ 按密码本解压 → 汇总结果"
                            Command="{Binding OneClickProcessCommand}" />

                    <!--
                        特定解压总开关（用户 2026-09-24 原话："我是想在一键解压旁边弄一个特定解压开关"）。
                        规则在②「解压方式」页那一栏里逐条挑；ToolTip 列出当前生效的规则
                        （一条都没开就提示去②页挑）—— 关掉它 = 一键处理的行为与现在逐字相同。

                        ⚠ 直接绑设置对象那一格（与②页「危险模式」那个开关同一写法）：它不需要
                        "勾一下就让别的控件跟着变"，而这一页要绑的正是**那个**设置项本身。
                    -->
                    <CheckBox Content="{x:Static models:StatusText.SpecialExtractionToggleLabel}"
                              Margin="12,0,0,0"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              IsChecked="{Binding SettingsEditor.Settings.UseSpecialExtraction, Mode=TwoWay}"
                              ToolTip="{Binding SettingsEditor.SpecialExtractionToolTip}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ============ 手动操作（单独改后缀 / 单独解压，默认收起） ============ -->
        <Expander Grid.Row="2"
                  Header="手动操作（单独改后缀 / 单独解压）"
                  Margin="0,0,0,8"
                  Padding="12,10"
                  Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!--
                    「修复分卷名并重试」（用户 2026-09-25 第 41 条；2026-09-26 审计改口径）：
                    只对"名字被改坏的分卷第一卷"有效，判据全在文件系统事实里（VolumeNameRepair.Plan 七条），
                    所以**扫描完就亮**（以前要等一次失败的解压才亮，用户从没见过它亮）。
                    它是这个程序里唯一会动源文件名的入口，而且必须用户点了才动 ——
                    文案里把"只改名字、内容不动"写进 ToolTip，确认框里再写一遍。
                    ToolTipService.ShowOnDisabled：灰着的时候也要能读到"它到底干什么、为什么现在不能用"。
                -->
                <Button Content="修复分卷名并重试"
                        MinWidth="136"
                        FontWeight="SemiBold"
                        ToolTip="{x:Static models:StatusText.VolumeRepairButtonToolTip}"
                        ToolTipService.ShowOnDisabled="True"
                        Command="{Binding RenameBySuggestionAndRetryCommand}" />

                <!--
                    ⚠ 「智能修正」不是"完全不碰分卷"（2026-09-26 审计）：它遇到分卷名会先问一次
                    VolumeNameRepair.Plan —— 名字被改坏的第一卷会被修回标准名，其余的照样跳过。
                    文案必须这么说，否则用户以为"点了也白点"（真机上他正是这么问的）。
                -->
                <Button Content="智能修正选中后缀"
                        MinWidth="136"
                        Margin="8,0,0,0"
                        ToolTip="对勾选的任务按识别结果修正后缀（会先弹出改名预览让你确认）；名字被改坏的分卷第一卷也能在这一步修回标准名。"
                        Command="{Binding SmartRenameCommand}" />

                <Button Content="改名…"
                        MinWidth="96"
                        Margin="8,0,0,0"
                        ToolTip="自己指定怎么改：替换文件名里的文字（删掉被塞进去的字）/ 替换最后一个后缀 / 添加后缀 / 删除最后一个后缀（同样先出改名预览）。"
                        Command="{Binding ChangeNameCommand}" />

                <!--
                    两颗"只看不动盘"的按钮（用户 2026-09-26 批准加的高频功能）：
                    看内容 = 列出包里有什么（不解压）；试密码 = 逐个候选问一遍"这个能不能开"。
                    ⛔ 它们一个字节都不写盘、也不动源文件。
                -->
                <Button Content="看内容"
                        MinWidth="84"
                        Margin="8,0,0,0"
                        ToolTip="只列出勾选任务里有什么（条目数、总大小、前几条），不解压、不写盘。"
                        Command="{Binding InspectArchiveCommand}" />

                <Button Content="试密码"
                        MinWidth="84"
                        Margin="8,0,0,0"
                        ToolTip="拿密码本与密码列表逐个候选去问引擎「这个能不能开」，报出能开的那个（只显示它排第几，不显示密码本身）。"
                        Command="{Binding TryPasswordsCommand}" />

                <Button Content="打开源目录"
                        MinWidth="104"
                        Margin="8,0,0,0"
                        ToolTip="在资源管理器里打开第一个勾选任务所在的文件夹（只打开，不动文件）。"
                        Command="{Binding OpenCheckedSourceDirectoryCommand}" />
            </WrapPanel>
        </Expander>

        <!-- ============ 任务列表 ============ -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource InfoSoftBrush}"
                        BorderBrush="{StaticResource InfoBorderBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CardCornerRadiusTop}"
                        Padding="12,7">
                    <TextBlock Foreground="{StaticResource InfoTextBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SelectionScopeHint}" />
                </Border>

                <Grid>
                    <DataGrid x:Name="TaskDataGrid"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                              SelectionMode="Extended"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Margin="8,4,8,8"
                              PreviewMouseRightButtonDown="TaskDataGrid_PreviewMouseRightButtonDown">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开文件所在目录"
                                          Command="{Binding PlacementTarget.DataContext.OpenTaskDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="打开输出目录"
                                          Command="{Binding PlacementTarget.DataContext.OpenTaskOutputDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="打开其余物目录"
                                          Command="{Binding PlacementTarget.DataContext.OpenTaskArtifactDirectoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <Separator />

                                <MenuItem Header="只勾选这一个"
                                          ToolTip="取消其它任务的勾选，只留下当前这一行"
                                          Command="{Binding PlacementTarget.DataContext.SelectSoleTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="全选（Ctrl+A）"
                                          Command="{Binding PlacementTarget.DataContext.SelectAllTasksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="全不选（Ctrl+D）"
                                          Command="{Binding PlacementTarget.DataContext.SelectNoneTasksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <Separator />

                                <MenuItem Header="复制文件路径"
                                          Command="{Binding PlacementTarget.DataContext.CopyTaskPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="复制错误信息"
                                          Command="{Binding PlacementTarget.DataContext.CopyTaskErrorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="复制任务信息"
                                          Command="{Binding PlacementTarget.DataContext.CopyTaskInfoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <Separator />

                                <MenuItem Header="重新扫描此文件"
                                          Command="{Binding PlacementTarget.DataContext.RescanTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="智能修正此文件后缀"
                                          Click="SmartRenameCurrentTaskMenuItem_Click" />

                                <MenuItem Header="查看任务详情"
                                          Click="TaskDetailMenuItem_Click" />

                                <Separator />

                                <MenuItem Header="移除勾选中的任务"
                                          Command="{Binding PlacementTarget.DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="清空列表"
                                          Command="{Binding PlacementTarget.DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                                <MenuItem Header="从列表移除这一行"
                                          Command="{Binding PlacementTarget.DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="选择" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalAlignment="Stretch"
                                                  VerticalContentAlignment="Center"
                                                  Margin="0"
                                                  ToolTip="一次点击即勾选 / 取消勾选。勾选后才会被「一键处理 / 智能修正」等按钮处理" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="文件名"
                                                Binding="{Binding FileName}"
                                                Width="180"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding CurrentPath}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="完整路径"
                                                Binding="{Binding CurrentPath}"
                                                Width="200"
                                                Visibility="Collapsed"
                                                IsReadOnly="True" />

                            <DataGridTextColumn Header="当前后缀"
                                                Binding="{Binding CurrentExtension}"
                                                Width="100"
                                                IsReadOnly="True" />

                            <DataGridTextColumn Header="检测格式"
                                                Binding="{Binding DetectedFormat}"
                                                Width="90"
                                                IsReadOnly="True" />

                            <DataGridTextColumn Header="后缀状态"
                                                Binding="{Binding ExtensionStatus}"
                                                Width="190"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip">
                                            <Setter.Value>
                                                <TextBlock>
                                                    <!-- Run.Text 在 WPF 里默认 TwoWay，绑到只读属性会在模板实例化时崩（必须写 OneWay） -->
                                                    <Run Text="当前后缀：" /><Run Text="{Binding CurrentExtension, Mode=OneWay}" /><LineBreak />
                                                    <Run Text="检测格式：" /><Run Text="{Binding DetectedFormat, Mode=OneWay}" /><LineBreak />
                                                    <Run Text="建议后缀：" /><Run Text="{Binding SuggestedExtension, Mode=OneWay}" /><LineBreak />
                                                    <Run Text="分卷：" /><Run Text="{Binding VolumeInfoText, Mode=OneWay}" />
                                                </TextBlock>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="分卷"
                                                Binding="{Binding VolumeInfoText}"
                                                Width="200"
                                                Visibility="Collapsed"
                                                IsReadOnly="True" />

                            <DataGridTextColumn Header="密码状态"
                                                Binding="{Binding PasswordStatus}"
                                                Width="110"
                                                IsReadOnly="True" />

                            <DataGridTextColumn Header="输出目录"
                                                Binding="{Binding OutputPath}"
                                                Width="240"
                                                Visibility="Collapsed"
                                                IsReadOnly="True" />

                            <DataGridTemplateColumn Header="状态" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusDisplayText}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding StatusDisplayText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="错误信息"
                                                Binding="{Binding ErrorMessage}"
                                                Width="*"
                                                MinWidth="200"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="耗时"
                                                Binding="{Binding ElapsedText}"
                                                Width="80"
                                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 空状态：不要给用户一张空白表格 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="还没有任务"
                                   Style="{StaticResource SectionTitleTextStyle}"
                                   HorizontalAlignment="Center" />

                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Margin="0,6,0,0"
                                   TextAlignment="Center"
                                   MaxWidth="460"
                                   Text="点上面的「添加文件 / 添加文件夹」，或把文件、文件夹直接拖进这个窗口。" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ 日志与列表之间的分隔条（第 18 条：能上下拖） ============ -->
        <GridSplitter x:Name="LogSplitter"
                      Grid.Row="4"
                      Height="6"
                      Margin="0,2,0,2"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ToolTip="上下拖动可以改变日志区的高度" />

        <!-- ============ 日志区 ============ -->
        <Grid x:Name="LogArea" Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource GroupHeaderBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="{StaticResource CardCornerRadiusTop}"
                    Padding="12,6">
                <DockPanel>
                    <TextBlock Text="日志"
                               Style="{StaticResource CardTitleTextStyle}"
                               VerticalAlignment="Center" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="日志放大"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="把日志开到独立窗口里看（主界面这一块保持原样）"
                                Click="OpenLogWindowButton_Click" />

                        <Button x:Name="LogToggleButton"
                                Content="收起"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="收起日志区，把高度让给任务列表（也可以拖中间那条分隔条）"
                                Click="ToggleLogAreaButton_Click" />

                        <Button Content="复制失败列表"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding CopyFailedListCommand}" />

                        <Button Content="导出失败清单"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="把失败任务与原因导出成 txt，便于逐条处理或留档"
                                Command="{Binding ExportFailedListCommand}" />

                        <!--
                            用户 2026-09-25 第 37 条："导出所有日志才是最关键的"——他要的是**全部**日志（每一份都导），
                            不是只导这一次的。放在失败清单旁边：出问题的那一刻就能一键带走。
                        -->
                        <Button Content="导出日志（本次）"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="只导出「最近一次操作」的日志（从日志里那行「本次操作开始」起），排查时一眼到底，不用翻历史"
                                Command="{Binding ExportLogCommand}" />

                        <Button Content="打开输出目录"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding OpenOutputDirectoryCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadiusBottom}"
                    Padding="4">
                <ListBox x:Name="LogList"
                         ItemsSource="{Binding Logs}"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="NoWrap">
                                <!--
                                    ⚠ 必须显式写 Mode=OneWay：Run.Text 在 WPF 里**默认是 TwoWay**，
                                    而 TimeText 是只读计算属性，不写会在模板实例化时抛 XamlParseException。
                                -->
                                <Run Text="{Binding TimeText, Mode=OneWay, StringFormat=[{0}]}" />
                                <Run Text=" [" />
                                <Run Text="{Binding Level, Mode=OneWay}" />
                                <Run Text="] " />
                                <Run Text="{Binding Message, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- ============ 汇总区 ============ -->
        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,8,0,0">
            <StackPanel>
                <!--
                    第 16 条追加：撞到层数上限时这一行必须出现（到顶不许静默停下）——
                    文案由 PendingContinuationText 统一给出（几个没解 + 点哪里继续）。
                -->
                <TextBlock Text="{Binding PendingContinuationText}"
                           Margin="0,0,0,6"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource DangerTextBrush}"
                           Visibility="{Binding HasPendingContinuation, Converter={StaticResource BoolToVisibilityConverter}}" />

                <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="汇总："
                           Style="{StaticResource CardTitleTextStyle}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />

                <TextBlock Text="总数：" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.TotalCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="选中：" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.SelectedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.Recognized}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.RecognizedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.UnknownFormat}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.UnknownCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.RenameSuccess}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.RenameSuccessCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.RenameFailed}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.RenameFailedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.TestPassed}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.TestSuccessCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.TestFailed}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.TestFailedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.ExtractSuccess}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.ExtractSuccessCount}" Style="{StaticResource StatValueTextStyle}"
                           Foreground="{StaticResource SuccessTextBrush}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.ExtractFailed}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.ExtractFailedCount}" Style="{StaticResource StatValueTextStyle}"
                           Foreground="{StaticResource DangerTextBrush}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.WrongPassword}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.PasswordErrorCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.Corrupted}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.CorruptedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.Skipped}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.SkippedCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="{x:Static models:StatusText.Cancelled}" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.CancelledCount}" Style="{StaticResource StatValueTextStyle}" Margin="0,0,14,0" />

                <TextBlock Text="其他失败：" Style="{StaticResource StatLabelTextStyle}" />
                <TextBlock Text="{Binding Summary.OtherFailedCount}" Style="{StaticResource StatValueTextStyle}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
