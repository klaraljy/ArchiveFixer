<UserControl x:Class="ArchiveFixer.Views.Tabs.PasswordTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ArchiveFixer.Models">

    <!--
        ④ 密码页（用户 2026-09-24 第 11 条）：
        密码本（导入 / 写回入口 / 已记住的多本清单）+ 统一密码 + 单任务密码说明 + 尝试上限 + 记住密码列表。
        整页可滚（第 20 条）。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>

            <!-- ==================== 密码本 ==================== -->
            <GroupBox Header="密码本">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="导入密码本…"
                                MinWidth="112"
                                Command="{Binding ImportPasswordBookCommand}"
                                ToolTip="记住这个路径，下次启动自动加载（导入一次就够）" />

                        <Button Content="密码列表管理…"
                                MinWidth="128"
                                Margin="8,0,0,0"
                                Command="{Binding OpenPasswordListCommand}"
                                ToolTip="查看 / 编辑 / 添加密码，以及「写回密码本…」（把列表带去别的机器）" />

                        <TextBlock Text="{Binding PasswordBookSummary}"
                                   ToolTip="{Binding PasswordBookTooltip}"
                                   Style="{StaticResource HintTextStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420"
                                   Margin="12,0,0,0" />
                    </WrapPanel>

                    <TextBlock Text="{x:Static models:StatusText.SettingsRememberedBooksTitle}"
                               Style="{StaticResource LabelTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,2,0,6"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SettingsRememberedBooksHint}" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource WarningTextBrush}"
                               Text="{x:Static models:StatusText.SettingsRememberedBooksDisabledText}"
                               Visibility="{Binding SettingsEditor.ShowRememberedBooksDisabledHint, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SettingsRememberedBooksEmptyText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SettingsEditor.HasRememberedBooks}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding SettingsEditor.RememberedBooks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource OptionRowStyle}"
                                        Background="{StaticResource PanelSunkenBrush}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        Margin="0,0,0,6"
                                        Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Style="{StaticResource BodyTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" />

                                            <TextBlock Style="{StaticResource HintTextStyle}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Path, StringFormat=路径：{0}}" />

                                            <TextBlock Style="{StaticResource HintTextStyle}"
                                                       Margin="0,2,0,0"
                                                       Foreground="{StaticResource WarningTextBrush}"
                                                       Text="{Binding Note}" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                MinWidth="64"
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Content="{x:Static models:StatusText.SettingsRememberedBooksRemoveButtonText}"
                                                ToolTip="{x:Static models:StatusText.SettingsRememberedBooksRemoveButtonHint}"
                                                Command="{Binding DataContext.SettingsEditor.RemoveRememberedBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        「刚刚做了什么」的一行反馈（2026-09-26 同步审计）：移除一本密码本之后，
                        SettingsViewModel.Message 里那句"已移除…磁盘上的那个文件不会被删除、也不会被修改"
                        以前**没有任何地方显示**（主窗口那个框已按用户要求删除，而这句话正是为那个疑问写的）。
                        绑在页内，⛔ 不回主窗口底栏（那一行只报"设置已自动保存"的状态）。
                    -->
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding SettingsEditor.Message}" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 统一密码 ==================== -->
            <GroupBox Header="统一密码">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="统一密码："
                                   Style="{StaticResource LabelTextStyle}" />

                        <Grid Grid.Column="1">
                            <TextBox Text="{Binding GlobalPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="输入统一密码">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <PasswordBox x:Name="GlobalPasswordBox"
                                         PasswordChanged="GlobalPasswordBox_PasswordChanged"
                                         ToolTip="输入统一密码">
                                <PasswordBox.Style>
                                    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </PasswordBox.Style>
                            </PasswordBox>
                        </Grid>

                        <Button Grid.Column="2"
                                Content="显示/隐藏"
                                MinWidth="88"
                                Margin="8,0,0,0"
                                Command="{Binding ToggleShowPasswordCommand}" />
                    </Grid>

                    <CheckBox Content="对所有任务使用统一密码"
                              Margin="0,10,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.UseGlobalPasswordForAllTasks, Mode=TwoWay}" />

                    <CheckBox Content="优先尝试空密码"
                              Margin="0,8,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.TryEmptyPasswordFirst, Mode=TwoWay}" />

                    <CheckBox Content="从压缩包同目录的说明文件里提取密码候选（.txt/.bat 等）"
                              Margin="0,8,0,0"
                              IsChecked="{Binding SettingsEditor.Settings.EnableSidecarPassword, Mode=TwoWay}"
                              ToolTip="开启后会把同目录说明文件里像密码的内容当作候选；候选排在用户明确给的密码之后。" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="每层尝试上限："
                                   Style="{StaticResource LabelTextStyle}" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsEditor.Settings.MaxPasswordAttemptsPerLayer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="1~1000。到上限会明确报「达到密码尝试上限」，不会报成密码错误。" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="默认 10。密码本很长时调大才会试更多，但每个包都会更慢。" />
                    </Grid>

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="单个包要用别的密码：开始前程序会问一次「要不要手动输一个密码」（只对本次运行有效、不落盘），也可以在「密码列表管理」里把它单独加一条。" />
                </StackPanel>
            </GroupBox>

            <!-- ==================== 记住密码列表 ==================== -->
            <GroupBox Header="记住密码列表（跨重启保留）">
                <StackPanel>
                    <CheckBox Content="{x:Static models:StatusText.SettingsRememberPasswordListLabel}"
                              IsChecked="{Binding SettingsEditor.IsRememberingPasswordList, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Margin="22,4,0,0"
                               TextWrapping="Wrap"
                               Text="{x:Static models:StatusText.SettingsRememberPasswordListHint}" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
