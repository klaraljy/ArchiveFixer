<UserControl x:Class="ArchiveFixer.Views.HelpBodyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ArchiveFixer.Models">

    <!--
        说明正文（介绍 + 功能详解 + 术语表）—— 唯一一份，由「说明」页签与「说明」窗**共用**，
        ⛔ 不许在别处再抄一份（用户口径：说明文字只有一个出处，改了术语表窗口里不许留旧说法）。
        文字全部来自 Models/HelpContent.cs，这里一个字都不手写；⛔ 不读任何外部文件。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{x:Static models:HelpContent.Tagline}"
                       Style="{StaticResource BodyTextStyle}"
                       TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{x:Static models:HelpContent.Introduction}"
                          Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer x:Name="BodyScrollViewer"
                      Grid.Row="1"
                      Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!--
                    完整例子（用户 2026-10-25：不要一整段文字，要像 Markdown 一样有层次、流程、路径标注）。
                    这里用原生 XAML 的编号卡片/标题/正文/等宽路径排出 Markdown 的观感，⛔ 不引入
                    Markdown 解析器、⛔ 不贴图片；内容唯一来源仍是 HelpContent。
                -->
                <TextBlock Text="{x:Static models:HelpContent.ExampleHeading}"
                           Style="{StaticResource LabelTextStyle}"
                           Margin="0,0,0,6" />

                <TextBlock Text="{x:Static models:HelpContent.ExampleIntro}"
                           Style="{StaticResource HintTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <Border Style="{StaticResource CardStyle}"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="流程（箭头 = 程序实际走的下一步）"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   Margin="0,0,0,6" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Cursor="Arrow"
                                      PreviewMouseWheel="FlowDiagram_PreviewMouseWheel">
                            <TextBlock Text="{x:Static models:HelpContent.ExampleFlowDiagram}"
                                       Style="{StaticResource MonoTextStyle}"
                                       TextWrapping="NoWrap" />
                        </ScrollViewer>

                        <TextBlock Text="落点目录（普通文件夹，不含你的盘符）"
                                   Style="{StaticResource CardTitleTextStyle}"
                                   Margin="0,12,0,6" />

                        <TextBlock Text="{x:Static models:HelpContent.ExampleDirectoryTree}"
                                   Style="{StaticResource MonoTextStyle}"
                                   TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{x:Static models:HelpContent.ExampleSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="24"
                                            Height="24"
                                            CornerRadius="12"
                                            Background="{StaticResource PrimarySoftBrush}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Number}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource CardTitleTextStyle}" />

                                        <TextBlock Text="{Binding Text}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />

                                        <TextBlock Text="{Binding Path}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoTextStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Path}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1"
                        Background="{StaticResource PanelBorderBrush}"
                        Margin="0,6,0,12" />

                <!--
                    功能详解（用户 2026-09-27："里面有专有名词的详细解释，但是没有功能的详细解释"）。
                    与术语表同一套卡片样式，只是分两段、各有一个小标题。
                -->
                <TextBlock Text="{x:Static models:HelpContent.FeaturesHeading}"
                           Style="{StaticResource LabelTextStyle}"
                           Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{x:Static models:HelpContent.Features}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="12,8"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Term}"
                                               Style="{StaticResource LabelTextStyle}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Explanation}"
                                               Style="{StaticResource BodyTextStyle}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Static models:HelpContent.GlossaryHeading}"
                           Style="{StaticResource LabelTextStyle}"
                           Margin="0,10,0,8" />

                <ItemsControl ItemsSource="{x:Static models:HelpContent.Glossary}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 一条术语一张卡片：左边词、右边解释（与⑤页密码卡片同一套样式口径）。 -->
                            <Border Style="{StaticResource CardStyle}"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="12,8"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Term}"
                                               Style="{StaticResource LabelTextStyle}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Explanation}"
                                               Style="{StaticResource BodyTextStyle}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
