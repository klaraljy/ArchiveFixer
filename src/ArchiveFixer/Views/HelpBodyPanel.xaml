<UserControl x:Class="ArchiveFixer.Views.HelpBodyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ArchiveFixer.Models">

    <!--
        说明正文（快速开始 / 三种方式 / 功能地图 / 术语 / 排查与 FAQ）—— 唯一一份，
        由「说明」页签与「说明」窗共用；文字全部来自 Models/HelpContent.cs，这里不手写正文。
        布局改成“顶部定位语 + 分页内容”，避免旧版一整条长滚动。
    -->
    <UserControl.Resources>
        <Style x:Key="HelpSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelTextStyle}">
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>

        <Style x:Key="HelpSubTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CardTitleTextStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="HelpBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="HelpStepTemplate">
            <StackPanel Margin="0,0,0,2">
                <Border Style="{StaticResource CardStyle}"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="24"
                                Height="24"
                                CornerRadius="12"
                                Background="{StaticResource PrimarySoftBrush}"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding Number}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource CardTitleTextStyle}" />

                            <TextBlock Text="{Binding Text}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />

                            <TextBlock Text="{Binding Path}"
                                       TextWrapping="Wrap"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Connector}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryBrush}"
                           FontSize="16"
                           Margin="0,2,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Connector}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HelpTermTemplate">
            <Border Style="{StaticResource CardStyle}"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="12,9"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Term}"
                               Style="{StaticResource LabelTextStyle}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding Explanation}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HelpModeTemplate">
            <Border Style="{StaticResource CardStyle}"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="14,12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource HelpBadgeBorderStyle}">
                            <TextBlock Text="{Binding Badge}"
                                       FontSize="12"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </Border>

                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource PageTitleTextStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>

                    <TextBlock Text="{Binding Summary}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,8" />

                    <ItemsControl ItemsSource="{Binding Steps}"
                                  ItemTemplate="{StaticResource HelpStepTemplate}" />

                    <Border Background="{StaticResource PanelSunkenBrush}"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,4,0,8">
                        <StackPanel>
                            <TextBlock Text="落点/结果"
                                       Style="{StaticResource CardTitleTextStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding OutputTree}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WarningBannerStyle}" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Boundary}"
                                   Style="{StaticResource BannerTextStyle}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="· "
                                               Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="{Binding}"
                                               Style="{StaticResource HintTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HelpFaqTemplate">
            <Border Style="{StaticResource CardStyle}"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="12,9"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Term}"
                               Style="{StaticResource CardTitleTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Explanation}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="说明"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{x:Static models:HelpContent.Tagline}"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="12"
                        Padding="12,6"
                        VerticalAlignment="Top"
                        Margin="12,0,0,0">
                    <TextBlock Text="v0.2.2"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{x:Static models:HelpContent.RecursionRiskWarning}"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource DangerTextBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="递归解压风险提示"
                       Margin="0,0,0,6" />

            <TextBlock Text="{x:Static models:HelpContent.SpaceTightModeHint}"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource DangerTextBrush}"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="空间不足模式提示" />
        </StackPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="快速开始">
                <ScrollViewer x:Name="QuickStartScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,10,8,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static models:HelpContent.QuickStartHeading}"
                                   Style="{StaticResource HelpSectionTitleStyle}" />

                        <ItemsControl ItemsSource="{x:Static models:HelpContent.QuickStartSteps}"
                                      ItemTemplate="{StaticResource HelpStepTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="三种方式">
                <ScrollViewer x:Name="ModesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,10,8,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static models:HelpContent.ModeExamplesHeading}"
                                   Style="{StaticResource HelpSectionTitleStyle}" />

                        <TextBlock Text="{x:Static models:HelpContent.ModeExamplesIntro}"
                                   Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{x:Static models:HelpContent.ModeExamples}"
                                      ItemTemplate="{StaticResource HelpModeTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="功能地图">
                <ScrollViewer x:Name="FeaturesScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,10,8,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static models:HelpContent.FeatureMapHeading}"
                                   Style="{StaticResource HelpSectionTitleStyle}" />

                        <ItemsControl ItemsSource="{x:Static models:HelpContent.FeatureMap}"
                                      ItemTemplate="{StaticResource HelpTermTemplate}" />

                        <Border Height="1"
                                Background="{StaticResource PanelBorderBrush}"
                                Margin="0,6,0,12" />

                        <TextBlock Text="{x:Static models:HelpContent.TabGuidesHeading}"
                                   Style="{StaticResource HelpSectionTitleStyle}" />

                        <ItemsControl ItemsSource="{x:Static models:HelpContent.TabGuides}"
                                      ItemTemplate="{StaticResource HelpTermTemplate}" />

                        <Border Height="1"
                                Background="{StaticResource PanelBorderBrush}"
                                Margin="0,6,0,12" />

                        <TextBlock Text="{x:Static models:HelpContent.ScenariosHeading}"
                                   Style="{StaticResource HelpSectionTitleStyle}" />

                        <ItemsControl ItemsSource="{x:Static models:HelpContent.Scenarios}"
                                      ItemTemplate="{StaticResource HelpTermTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="术语表">
                <ScrollViewer x:Name="GlossaryScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,10,8,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static models:HelpContent.GlossaryHeading}"
                                   Style="{StaticResource HelpSectionTitleStyle}" />

                        <ItemsControl ItemsSource="{x:Static models:HelpContent.Glossary}"
                                      ItemTemplate="{StaticResource HelpTermTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="排查与 FAQ">
                <ScrollViewer x:Name="DiagnosticsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,10,8,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static models:HelpContent.DiagnosticsHeading}"
                                   Style="{StaticResource HelpSectionTitleStyle}" />

                        <ItemsControl ItemsSource="{x:Static models:HelpContent.DiagnosticsSteps}"
                                      ItemTemplate="{StaticResource HelpStepTemplate}" />

                        <Border Background="{StaticResource PanelSunkenBrush}"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,6,0,12">
                            <TextBlock Text="{x:Static models:HelpContent.DiagnosticsPrivacy}"
                                       Style="{StaticResource HintTextStyle}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{x:Static models:HelpContent.LimitsHeading}"
                                   Style="{StaticResource HelpSectionTitleStyle}" />

                        <ItemsControl ItemsSource="{x:Static models:HelpContent.Limits}"
                                      ItemTemplate="{StaticResource HelpFaqTemplate}" />

                        <Border Height="1"
                                Background="{StaticResource PanelBorderBrush}"
                                Margin="0,6,0,12" />

                        <TextBlock Text="{x:Static models:HelpContent.FaqHeading}"
                                   Style="{StaticResource HelpSectionTitleStyle}" />

                        <ItemsControl ItemsSource="{x:Static models:HelpContent.Faq}"
                                      ItemTemplate="{StaticResource HelpFaqTemplate}" />

                        <Border Height="1"
                                Background="{StaticResource PanelBorderBrush}"
                                Margin="0,6,0,12" />

                        <TextBlock Text="{x:Static models:HelpContent.VersionHeading}"
                                   Style="{StaticResource HelpSectionTitleStyle}" />

                        <TextBlock Text="{x:Static models:HelpContent.VersionText}"
                                   Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
