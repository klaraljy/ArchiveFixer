<Window x:Class="ArchiveFixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:ArchiveFixer.ViewModels"
        xmlns:models="clr-namespace:ArchiveFixer.Models"
        xmlns:tabs="clr-namespace:ArchiveFixer.Views.Tabs"
        Style="{StaticResource AppWindowStyle}"
        Title="ArchiveFixer 第十一版 - 批量压缩包识别与解压工具"
        Width="1400"
        Height="900"
        MinWidth="1180"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <!--
        勾选的键盘入口（用户 2026-09-22 追加需求："像文件夹选中一样，有一个全选的选项"）。
        Ctrl+A 的**可靠实现**在 MainWindow.xaml.cs 的 PreviewKeyDown 里：DataGrid 自己吃掉 Ctrl+A
        （它选的是"行高亮"，与勾选框是两套东西），窗口级 InputBinding 抢不过它。
        这里只挂两个没人抢的键。
    -->
    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding SelectNoneTasksCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding InvertTaskSelectionCommand}" />
    </Window.InputBindings>

    <!--
        主窗口 = 顶部菜单（三组）+ 六个选项卡 + 底部状态/进度条（用户 2026-09-24 第 11 条）。
        原来堆在这里的并发档 / 空间管理 / 危险模式红横幅 / 输出位置那一大块全部按功能搬进了选项卡，
        ① 任务页现在只有"选任务 → 点一键处理 → 看结果"这条主线。
        第 20 条：窗口默认 1400×900、最小 1000×640；整页用星号行列，拉大时各页跟着长。
    -->

    <DockPanel Margin="12">

        <!-- ============ 顶部菜单：只剩三组（低频操作收进菜单） ============ -->
        <Menu DockPanel.Dock="Top"
              Margin="0,0,0,8"
              Padding="2"
              Background="Transparent">
            <MenuItem Header="文件">
                <MenuItem Header="添加文件..."
                          Command="{Binding AddFilesCommand}"
                          ToolTip="{x:Static models:StatusText.AddReplacesListHint}" />
                <MenuItem Header="添加文件夹..."
                          Command="{Binding AddFolderCommand}"
                          ToolTip="{x:Static models:StatusText.AddReplacesListHint}" />
                <MenuItem Header="追加到列表">
                    <MenuItem Header="追加文件..."
                              Command="{Binding AppendFilesCommand}"
                              ToolTip="{x:Static models:StatusText.AppendToListHint}" />
                    <MenuItem Header="追加文件夹..."
                              Command="{Binding AppendFolderCommand}"
                              ToolTip="{x:Static models:StatusText.AppendToListHint}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="重新扫描" Command="{Binding ScanCommand}" />
                <Separator />
                <MenuItem Header="导出失败清单"
                          Command="{Binding ExportFailedListCommand}"
                          ToolTip="把失败任务与原因导出成 txt，便于逐条处理或留档" />
                <Separator />
                <MenuItem Header="退出" Click="ExitMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="视图">
                <MenuItem Header="日志窗口"
                          Click="LogWindowMenuItem_Click"
                          ToolTip="把日志开到独立窗口里看（与①页的日志区是同一份内容）" />
                <MenuItem Header="展开或收起日志区" Click="ToggleLogAreaMenuItem_Click" />
                <MenuItem Header="跳到我选中的任务" Click="JumpToSelectedTaskMenuItem_Click" />
            </MenuItem>

            <MenuItem Header="帮助">
                <MenuItem Header="使用说明"
                          Click="UsageMenuItem_Click"
                          ToolTip="在资源管理器里定位 docs\使用说明.md" />
                <MenuItem Header="快捷键" Click="ShortcutsMenuItem_Click" />
                <MenuItem Header="关于" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <!--
            ============ 底部：只有"正在干活"那一条 ============

            用户 2026-09-26 两次点名："你那个按钮和最下面一个框，框里面写着设置已加载都要删除" →
            "就是提醒用户设置会自动保存的，这个鬼东西太突兀了，而且**在切换选项卡的时候也会显示出来**……
            这个让用户决定，**现在彻底删除**"。

            所以这一条**只有"正在处理…"那一个指示器**：设置相关的字**一个字都不留**
            （设置本身仍然是"改了就自动存"，底栏不需要为此占一行；某项不合法时**不再在界面上提示**，
            只有日志里一条 WARN —— 这是用户 2026-09-26 明确选的取舍，见 AGENTS.md §0 那一行）。
        -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="正在处理…（界面在干活，长任务请耐心等；随时可以「停止后续」）"
                           Style="{StaticResource HintTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             Width="180"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource PrimaryBrush}"
                             Background="{StaticResource PrimarySoftBrush}"
                             BorderThickness="0" />
            </StackPanel>
        </Border>

        <!--
            ============ 六个选项卡 ============
        -->
        <TabControl x:Name="MainTabControl" Margin="0,0,0,0" SelectionChanged="MainTabControl_SelectionChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TabPanel IsItemsHost="True"
                                      Margin="0,0,0,-1"
                                      KeyboardNavigation.TabIndex="1"
                                      Panel.ZIndex="1" />
                        </DockPanel>

                        <ContentPresenter Grid.Row="1"
                                          ContentSource="SelectedContent"
                                          Margin="0,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="任务">
                <tabs:TaskTab x:Name="TaskTabHost" />
            </TabItem>

            <TabItem x:Name="ExtractionTabItem" Header="解压方式">
                <tabs:ExtractionTab />
            </TabItem>

            <TabItem x:Name="CleanupTabItem" Header="清理与删除">
                <tabs:CleanupTab />
            </TabItem>

            <TabItem Header="密码">
                <tabs:PasswordTab />
            </TabItem>

            <TabItem Header="打包">
                <tabs:PackingTab />
            </TabItem>

            <TabItem Header="设置">
                <tabs:SettingsTab />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
